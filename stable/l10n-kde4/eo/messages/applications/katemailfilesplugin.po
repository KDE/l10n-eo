msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Axel Rousseau, Michael Moroni"

msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "axel@esperanto-jeunes.org, michael.moroni@mailoo.org"

#: katemailfiles.cpp:48
msgid "Mail Files"
msgstr "Retpoŝti dosierojn"

#: katemailfiles.cpp:48
msgid "Support mailing files"
msgstr "Subteni retmesaĝadon de dosieroj"

#: katemailfiles.cpp:63
msgid "Send one or more of the open documents as email attachments."
msgstr "Sendi unu aŭ pli malfermitajn dokumentojn kiel alkroĉoj de retmesaĝo."

#: katemailfiles.cpp:94
msgid ""
"<p>The current document has not been saved, and cannot be attached to an "
"email message.</p><p>Do you want to save it and proceed?</p>"
msgstr ""
"<p>La aktuala dokumento ne estas konservita kaj ne povas esti alkroĉita en "
"laretmesaĝo.</p><p>Ĉu vi volas konservi ĝin kaj daŭrigi?</p>"

#: katemailfiles.cpp:97
msgid "Cannot Send Unsaved File"
msgstr "Ne povas sendi nekonservitan dosieron"

#: katemailfiles.cpp:105 katemailfiles.cpp:129
msgid "The file could not be saved. Please check if you have write permission."
msgstr ""
"La dosiero ne konserveblis. Bonvole kontrolu ĉu vi havas skriban rajton."

#: katemailfiles.cpp:117
#, kde-format
msgid ""
"<p>The current file:<br /><strong>%1</strong><br />has been modified. "
"Modifications will not be available in the attachment.</p><p>Do you want to "
"save it before sending it?</p>"
msgstr ""
"<p>La aktuala dosiero:<br /><strong>%1</strong><br />estis modifita. Modifoj "
"ne aplikeblos en la alkroĉo.</p><p>Ĉu vi volas konservi ĝin antaŭsendi ĝin?</"
"p>"

#: katemailfiles.cpp:120
msgid "Save Before Sending?"
msgstr "Ĉu konservi antaŭ ol sendado?"

#: katemailfiles.cpp:120
msgid "Do Not Save"
msgstr "Ne konservi"

#: katemailfilesdialog.cpp:54
msgid "Email Files"
msgstr "Retpoŝti dosierojn"

#: katemailfilesdialog.cpp:56 katemailfilesdialog.cpp:116
msgid "&Show All Documents >>"
msgstr "&Montri ĉiujn dokumentojn >>"

#: katemailfilesdialog.cpp:60
msgid "&Mail..."
msgstr "&Retpoŝti..."

#: katemailfilesdialog.cpp:67
msgid ""
"<p>Press <strong>Mail...</strong> to email the current document.</p><p>To "
"select more documents to send, press <strong>Show All Documents&nbsp;&gt;&gt;"
"</strong>.</p>"
msgstr ""
"<p>Premu <strong>Retpoŝti...</strong> por retpoŝti la aktualan dokumenton.</"
"p><p>Por eletkti pliajn sendendajn dokumentojn, premu <strong>Montri ĉiujn "
"dokumentojn&nbsp;&gt;&gt;</strong>.</p>"

#: katemailfilesdialog.cpp:72
msgid "Name"
msgstr "Nomo"

#: katemailfilesdialog.cpp:73
msgid "URL"
msgstr "URL"

#: katemailfilesdialog.cpp:124
msgid "&Hide Document List <<"
msgstr "&Kaŝi liston de dokumentoj <<"

#: katemailfilesdialog.cpp:125
msgid "Press <strong>Mail...</strong> to send selected documents"
msgstr "Premu <strong>Retpoŝti...</strong> por sendi elektitajn dokumentojn"

#. i18n: ectx: Menu (file)
#: ui.rc:4
msgid "&File"
msgstr "&Dosiero"
