#: mode/katemodeconfigpage.cpp:247 rc.cpp:137
msgid "Properties"
msgstr "Trajtoj"

#: mode/katemodeconfigpage.cpp:266
msgid ""
"Select the MimeTypes you want for this file type.\n"
"Please note that this will automatically edit the associated file extensions "
"as well."
msgstr ""
"Elektu la MIME-tipojn deziratajn por tiu ĉi dosiertipo.\n"
"Atentu ke la alligitaj dosierfinaĵoj aŭtomate adaptiĝos."

#: mode/katemodeconfigpage.cpp:268
msgid "Select Mime Types"
msgstr "Elekti MIME-tipojn"

#: view/kateviewhelpers.cpp:320
msgid "Available Commands"
msgstr "Disponeblaj komandoj"

#: view/kateviewhelpers.cpp:322
msgid ""
"<p>For help on individual commands, do <code>'help &lt;command&gt;'</code></"
"p>"
msgstr ""
"<p>Por ekhavi helpon pri specifa komando, tajpu <code>'help &lt;"
"komando&gt;'</code></p>"

#: view/kateviewhelpers.cpp:333
#, kde-format
msgid "No help for '%1'"
msgstr "Ne estas helpo por '%1'"

#: view/kateviewhelpers.cpp:336
#, kde-format
msgid "No such command <b>%1</b>"
msgstr "Ne ekzistas komando <b>%1</b>"

#: view/kateviewhelpers.cpp:341
msgid ""
"<p>This is the Katepart <b>command line</b>.<br />Syntax: <code><b>command "
"[ arguments ]</b></code><br />For a list of available commands, enter "
"<code><b>help list</b></code><br />For help for individual commands, enter "
"<code><b>help &lt;command&gt;</b></code></p>"
msgstr ""
"<p>Jen, la Katepart <b>komandlinio</b>.<br />Sintakso: <code><b>komando "
"[ argumentoj ]</b></code><br />Por listo de haveblaj komandoj, entajpu "
"<code><b>help list</b></code><br />Por helpo pri unuopaj komandoj, entajpu "
"<code><b>help &lt;komando&gt;</b></code></p>"

#: view/kateviewhelpers.cpp:398
msgid "Success: "
msgstr "Sukceso: "

#: view/kateviewhelpers.cpp:400
msgid "Success"
msgstr "Sukceso"

#: view/kateviewhelpers.cpp:405
msgid "Error: "
msgstr "Eraro: "

#: view/kateviewhelpers.cpp:407
#, kde-format
msgid "Command \"%1\" failed."
msgstr "Komando  \"%1\" malsukcesis."

#: view/kateviewhelpers.cpp:413
#, kde-format
msgid "No such command: \"%1\""
msgstr "Ne ekzistas komando: \"%1\""

#: view/kateviewhelpers.cpp:765 utils/kateschema.cpp:204
msgid "Bookmark"
msgstr "Legosigno"

#: view/kateviewhelpers.cpp:1279 view/kateviewhelpers.cpp:1280
#, kde-format
msgid "Mark Type %1"
msgstr "Marka tipo %1"

#: view/kateviewhelpers.cpp:1299
msgid "Set Default Mark Type"
msgstr "Fiksi defaŭltan markotipon"

#: view/kateview.cpp:264
msgid "Cut the selected text and move it to the clipboard"
msgstr "Eltondi la elektitan tekston kaj movi ĝin al la poŝo"

#: view/kateview.cpp:267
msgid "Paste previously copied or cut clipboard contents"
msgstr "Alglui la antaŭe kopiitan aŭ eltonditan enhavon de la poŝo"

#: view/kateview.cpp:270
msgid ""
"Use this command to copy the currently selected text to the system clipboard."
msgstr ""
"Uzu ĉi tiun komandon por kopii la elektitan tekston al la sistema poŝo."

#: view/kateview.cpp:274
msgid "Copy as &HTML"
msgstr "Kopii kiel &HTML"

#: view/kateview.cpp:276
msgid ""
"Use this command to copy the currently selected text as HTML to the system "
"clipboard."
msgstr ""
"Uzu ĉi tiun komandon por kopii la elektitan tekston kiel HTMLon al la "
"sistema poŝo."

#: view/kateview.cpp:281
msgid "Save the current document"
msgstr "Konservi la nunan dokumenton"

#: view/kateview.cpp:284
msgid "Revert the most recent editing actions"
msgstr "Malfari la lastajn redaktadojn"

#: view/kateview.cpp:287
msgid "Revert the most recent undo operation"
msgstr "Reversigi la plej lastan malfaron"

#: view/kateview.cpp:290
msgid "&Word Wrap Document"
msgstr "&Linifaldi dokumenton"

#: view/kateview.cpp:291
msgid ""
"Use this command to wrap all lines of the current document which are longer "
"than the width of the current view, to fit into this view.<br /><br /> This "
"is a static word wrap, meaning it is not updated when the view is resized."
msgstr ""
"Uzu ĉi tiun komandon por faldi ĉiujn liniojn de la nuna dokumento kiuj estas "
"pli longaj ol la larĝeco de la nuna rigardo, por bone sidi en ĉi tiu rigardo."
"<br /><br /> Tio estas statika linifaldo, kiu signifas ke ĝi ne aktualiĝas "
"post regrandigo de la dokumento"

#: view/kateview.cpp:299
msgid "&Indent"
msgstr "&Deŝovo"

#: view/kateview.cpp:301
msgid ""
"Use this to indent a selected block of text.<br /><br />You can configure "
"whether tabs should be honored and used or replaced with spaces, in the "
"configuration dialog."
msgstr ""
"Uzu tion por deŝovi elektitan korpo de teksto.<br /><br />En la agorda "
"dialogo vi povas agordi ĉu uzi ekzistantajn tabojn aŭ anstataŭigi tabojn per "
"spacetoj."

#: view/kateview.cpp:307
msgid "&Unindent"
msgstr "&Maldeŝovo"

#: view/kateview.cpp:309
msgid "Use this to unindent a selected block of text."
msgstr "Uzu tion por malfari la deŝovon de elektita korpo de teksto."

#: view/kateview.cpp:313
msgid "&Clean Indentation"
msgstr "&Forigi deŝovon"

#: view/kateview.cpp:314
msgid ""
"Use this to clean the indentation of a selected block of text (only tabs/"
"only spaces)<br /><br />You can configure whether tabs should be honored and "
"used or replaced with spaces, in the configuration dialog."
msgstr ""
"Uzu tion por viŝi la deŝovon de elektita korpo de teksto (nur taboj/nur "
"spacetoj)<br /><br />En la agorda dialogo vi povas agordi ĉu uzi "
"ekzistantajn tabojn aŭ anstataŭigi tabojn per spacetoj."

#: view/kateview.cpp:320
msgid "&Align"
msgstr "Ĝis&randigi"

#: view/kateview.cpp:321
msgid ""
"Use this to align the current line or block of text to its proper indent "
"level."
msgstr ""
"Uzu ĉi tion por ĝisrandigi la nunan linion aŭ korpon de teksto al la "
"dezirata deŝova nivelo."

#: view/kateview.cpp:325
msgid "C&omment"
msgstr "&Komentigi"

#: view/kateview.cpp:327
msgid ""
"This command comments out the current line or a selected block of text.<br /"
"><br />The characters for single/multiple line comments are defined within "
"the language's highlighting."
msgstr ""
"Ĉi tiu komando komentigas la nunan linion aŭ elektitan blokon de teksto.<br /"
"><br />La signoj por unuobla/multoblaj linikomentoj estas difinitaj ene de "
"la emfazado de la lingvo."

#: view/kateview.cpp:332
msgid "Unco&mment"
msgstr "&Malkomentigi"

#: view/kateview.cpp:334
msgid ""
"This command removes comments from the current line or a selected block of "
"text.<br /><br />The characters for single/multiple line comments are "
"defined within the language's highlighting."
msgstr ""
"Ĉi tiu komando forigas komentojn de la nuna linio aŭ de elektita bloko de "
"teksto.<br /><br />La signoj por unuobla/multoblaj linikomentoj estas "
"difinitaj ene de la emfazado de la lingvo."

#: view/kateview.cpp:338
msgid "&Read Only Mode"
msgstr "Nu&r-lega reĝimo"

#: view/kateview.cpp:339
msgid "Lock/unlock the document for writing"
msgstr "Ŝlosi/malŝlosi la dokumenton por skribado"

#: view/kateview.cpp:344
msgid "Uppercase"
msgstr "Majuskla"

#: view/kateview.cpp:346
msgid ""
"Convert the selection to uppercase, or the character to the right of the "
"cursor if no text is selected."
msgstr ""
"Majuskligi la elekton, aŭ la signon kiu estas dekstre de la kursoro se ne "
"estas elektita teksto."

#: view/kateview.cpp:351
msgid "Lowercase"
msgstr "Minuskla"

#: view/kateview.cpp:353
msgid ""
"Convert the selection to lowercase, or the character to the right of the "
"cursor if no text is selected."
msgstr ""
"Minuskligi la elekton, aŭ la signon kiu estas dekstre de la kursoro se neniu "
"teksto estas elektita."

#: view/kateview.cpp:358
msgid "Capitalize"
msgstr "Majuskligi"

#: view/kateview.cpp:360
msgid ""
"Capitalize the selection, or the word under the cursor if no text is "
"selected."
msgstr ""
"Majuskligi la elekton, aŭ la vorton sub la kursoro se neniu teksto estas "
"elektita."

#: view/kateview.cpp:365
msgid "Join Lines"
msgstr "Kunigi liniojn"

#: view/kateview.cpp:370
msgid "Invoke Code Completion"
msgstr "Aktivigi kod-kompletigon"

#: view/kateview.cpp:371
msgid ""
"Manually invoke command completion, usually by using a shortcut bound to "
"this action."
msgstr ""
"Mane voki komandan kompletigon, kutime per uzo de fulmoklavo kiu estas "
"ligita al ĉi tiu ago."

#: view/kateview.cpp:384
msgid "Print the current document."
msgstr "Presi la aktualan dokumenton."

#: view/kateview.cpp:388
msgid "Reloa&d"
msgstr "Remal&fermi"

#: view/kateview.cpp:390
msgid "Reload the current document from disk."
msgstr "Reŝargi la aktualan dokumenton de disko."

#: view/kateview.cpp:394
msgid "Save the current document to disk, with a name of your choice."
msgstr "Konservi la aktualan dokumenton al disko kun nomo de via elekto."

#: view/kateview.cpp:397
msgid ""
"This command opens a dialog and lets you choose a line that you want the "
"cursor to move to."
msgstr ""
"Ĉi tiu komando malfermas dialogujon kaj permesas la elekton de linio al kiu "
"vi volas ke la kursoro moviĝu."

#: view/kateview.cpp:400
msgid "&Configure Editor..."
msgstr "&Agordi redaktilon..."

#: view/kateview.cpp:401
msgid "Configure various aspects of this editor."
msgstr "Agordi variajn aspektojn de ĉi redaktilo."

#: view/kateview.cpp:404
msgid "&Mode"
msgstr "&Reĝimo"

#: view/kateview.cpp:406
msgid ""
"Here you can choose which mode should be used for the current document. This "
"will influence the used highlighting and folding for example."
msgstr ""
"Ĉi tie vi povas elekti la reĝimon kiun vi volas uzi por la nuna dokumento. "
"Tio influos ekzemple, la tipon de emfazado kaj linifaldon."

#: view/kateview.cpp:409
msgid "&Highlighting"
msgstr "&Emfazado"

#: view/kateview.cpp:411
msgid "Here you can choose how the current document should be highlighted."
msgstr "Vi povas elekti la tipon de emfazado por la nuna dokumento."

#: view/kateview.cpp:414
msgid "&Schema"
msgstr "&Skemo"

#: view/kateview.cpp:419
msgid "&Indentation"
msgstr "&Deŝovo"

#: view/kateview.cpp:424
msgid "E&xport as HTML..."
msgstr "&Eksporti kiel HTML..."

#: view/kateview.cpp:425
msgid ""
"This command allows you to export the current document with all highlighting "
"information into a HTML document."
msgstr ""
"Ĉi tiu komando permesas la eksporton de la nuna dokumento kune kun ĉiu "
"emfazado en HTML-dokumenton."

#: view/kateview.cpp:430
msgid "Select the entire text of the current document."
msgstr "Elekti la kompletan tekston de la aktuala dokumento."

#: view/kateview.cpp:433
msgid ""
"If you have selected something within the current document, this will no "
"longer be selected."
msgstr ""
"Se vi jam elektis ion ene de la nuna dokumento, tio jam ne estos elektita."

#: view/kateview.cpp:437
msgid "Enlarge Font"
msgstr "Pligrandigi tiparon"

#: view/kateview.cpp:438
msgid "This increases the display font size."
msgstr "Tio igas la surekranan tiparon pli granda."

#: view/kateview.cpp:443
msgid "Shrink Font"
msgstr "Malpligrandigi tiparon"

#: view/kateview.cpp:444
msgid "This decreases the display font size."
msgstr "Tio igas la surekranan tiparon malpli granda."

#: view/kateview.cpp:447
msgid "Bl&ock Selection Mode"
msgstr "Bl&oka elektomaniero"

#: view/kateview.cpp:450
msgid ""
"This command allows switching between the normal (line based) selection mode "
"and the block selection mode."
msgstr ""
"Ĉi tiu komando permesas ŝanĝon inter la normala (bazita sur linio) reĝimo "
"kaj la bloka elektomaniero."

#: view/kateview.cpp:453
msgid "Overwr&ite Mode"
msgstr "&Anstataŭiga reĝimo"

#: view/kateview.cpp:456
msgid ""
"Choose whether you want the text you type to be inserted or to overwrite "
"existing text."
msgstr ""
"Vi povas elekti ĉu enmeti la entajpatan tekston aŭ anstataŭigi la "
"ekzistantan tekston."

#: view/kateview.cpp:460
msgid "&Dynamic Word Wrap"
msgstr "&Dinamika linifaldo"

#. i18n: tag string
#. i18n: file ./dialogs/appearanceconfigwidget.ui line 52
#: view/kateview.cpp:463 rc.cpp:539
msgid ""
"If this option is checked, the text lines will be wrapped at the view border "
"on the screen."
msgstr ""
"Se vi markas ĉi tiun opcion, la linioj de teksto saltos al la sekva linio ĉe "
"la rando de la ekrano."

#: view/kateview.cpp:466
msgid "Dynamic Word Wrap Indicators"
msgstr "Indikiloj pri dinamika linifaldo"

#: view/kateview.cpp:468
msgid "Choose when the Dynamic Word Wrap Indicators should be displayed"
msgstr "Elekti kiam montri la indikilojn pri dinamika linifaldo."

#: view/kateview.cpp:472
msgid "&Off"
msgstr "&Neniam"

#: view/kateview.cpp:473
msgid "Follow &Line Numbers"
msgstr "Sekvi &lininombrojn"

#: view/kateview.cpp:474
msgid "&Always On"
msgstr "Ĉi&am"

#: view/kateview.cpp:478
msgid "Show Folding &Markers"
msgstr "Montri kodfaldajn &markojn"

#: view/kateview.cpp:481
msgid ""
"You can choose if the codefolding marks should be shown, if codefolding is "
"possible."
msgstr "Se kodfaldo eblas, vi povas elekti montri tiujn markojn."

#: view/kateview.cpp:484
msgid "Show &Icon Border"
msgstr "Montri p&iktogramrandon"

#: view/kateview.cpp:487
msgid ""
"Show/hide the icon border.<br /><br />The icon border shows bookmark "
"symbols, for instance."
msgstr ""
"Montri/kaŝi la piktogramrandon.<br /><br />Ekz. la piktogramrando montras "
"legosignajn simbolojn."

#: view/kateview.cpp:490
msgid "Show &Line Numbers"
msgstr "Montri &lininombrojn"

#: view/kateview.cpp:493
msgid "Show/hide the line numbers on the left hand side of the view."
msgstr "Montri/kaŝi la lininombrojn ĉe la maldekstra flanko de la rigardo."

#: view/kateview.cpp:496
msgid "Show Scroll&bar Marks"
msgstr "Montri rulumskalajn &indikilojn"

#: view/kateview.cpp:498
msgid ""
"Show/hide the marks on the vertical scrollbar.<br /><br />The marks, for "
"instance, show bookmarks."
msgstr ""
"Montri/kaŝi la markojn sur la vertikala rulumskalo.<br /><br />La markoj, "
"ekz. montras legosignojn."

#: view/kateview.cpp:501
msgid "Show Static &Word Wrap Marker"
msgstr "Montri &statikan linifaldan indikilon"

#: view/kateview.cpp:504
msgid ""
"Show/hide the Word Wrap Marker, a vertical line drawn at the word wrap "
"column as defined in the editing properties"
msgstr ""
"Montri/kaŝi la linifaldan indikilon, kiu estas vertikala linio ĉe la "
"linifalda kolumno, kiel difinita en la redaktaj ecoj"

#: view/kateview.cpp:509
msgid "Switch to Command Line"
msgstr "Ŝalti al Komandlinio"

#: view/kateview.cpp:511
msgid "Show/hide the command line on the bottom of the view."
msgstr "Montri/kaŝi la komandlinion malsupre de la rigardo."

#: view/kateview.cpp:514
msgid "&End of Line"
msgstr "&Linifino"

#: view/kateview.cpp:516
msgid "Choose which line endings should be used, when you save the document"
msgstr "Elekti la linifinojn, dum konservo de la dokumento"

#: view/kateview.cpp:526
msgid "E&ncoding"
msgstr "Kodopreze&nto"

#: view/kateview.cpp:530
msgid "Look up the first occurrence of a piece of text or regular expression."
msgstr "Serĉi la unuan okazon de tekstero aŭ regula esprimo"

#: view/kateview.cpp:534
msgid "Find Selected"
msgstr "Trovi elektitan"

#: view/kateview.cpp:536
msgid "Finds next occurrence of selected text."
msgstr "Trovas la sekvantan okazon de elektita teksto."

#: view/kateview.cpp:540
msgid "Find Selected Backwards"
msgstr "Trovi elektitan retroire"

#: view/kateview.cpp:542
msgid "Finds previous occurrence of selected text."
msgstr "Trovas la antaŭan okazon de la elektita teksto."

#: view/kateview.cpp:546
msgid "Look up the next occurrence of the search phrase."
msgstr "Serĉi la sekvantan okazon de la serĉofrazo."

#: view/kateview.cpp:550
msgid "Look up the previous occurrence of the search phrase."
msgstr "Serĉi la antaŭan okazon de la serĉofrazo."

#: view/kateview.cpp:554
msgid ""
"Look up a piece of text or regular expression and replace the result with "
"some given text."
msgstr ""
"Serĉi teksteron aŭ regulan esprimon kaj anstataŭigi ĝin per iu donata teksto."

#: view/kateview.cpp:584
msgid "Move Word Left"
msgstr "Unu vorton maldekstren"

#: view/kateview.cpp:589
msgid "Select Character Left"
msgstr "Elekti signon maldekstre"

#: view/kateview.cpp:594
msgid "Select Word Left"
msgstr "Elekti vorton maldekstre"

#: view/kateview.cpp:600
msgid "Move Word Right"
msgstr "Unu vorton dekstren"

#: view/kateview.cpp:605
msgid "Select Character Right"
msgstr "Elekti signon dekstre"

#: view/kateview.cpp:610
msgid "Select Word Right"
msgstr "Unu vorton dekstre"

#: view/kateview.cpp:616
msgid "Move to Beginning of Line"
msgstr "Moviĝi al komenco de linio"

#: view/kateview.cpp:621
msgid "Move to Beginning of Document"
msgstr "Moviĝi al komenco de dokumento"

#: view/kateview.cpp:626
msgid "Select to Beginning of Line"
msgstr "Selekti ĝis antaŭa linio"

#: view/kateview.cpp:631
msgid "Select to Beginning of Document"
msgstr "Selekti ĝis komenco de la dokumento"

#: view/kateview.cpp:637
msgid "Move to End of Line"
msgstr "Moviĝi al linifino"

#: view/kateview.cpp:642
msgid "Move to End of Document"
msgstr "Moviĝi al fino de dokumento"

#: view/kateview.cpp:647
msgid "Select to End of Line"
msgstr "Selekti ĝis linifino"

#: view/kateview.cpp:652
msgid "Select to End of Document"
msgstr "Selekti ĝis fino de dokumento"

#: view/kateview.cpp:658
msgid "Select to Previous Line"
msgstr "Selekti ĝis "

#: view/kateview.cpp:663
msgid "Scroll Line Up"
msgstr "Ruli je unu linio supren"

#: view/kateview.cpp:669
msgid "Move to Next Line"
msgstr "Al sekva linio"

#: view/kateview.cpp:675
msgid "Move to Previous Line"
msgstr "Al antaŭa linio"

#: view/kateview.cpp:681
msgid "Move Character Right"
msgstr "Unu signon dekstren"

#: view/kateview.cpp:687
msgid "Move Character Left"
msgstr "Unu signon maldekstren"

#: view/kateview.cpp:693
msgid "Select to Next Line"
msgstr "Selekti ĝis sekva linio"

#: view/kateview.cpp:698
msgid "Scroll Line Down"
msgstr "Ruli je unu linio malsupren"

#: view/kateview.cpp:704
msgid "Scroll Page Up"
msgstr "Ruli je unu linio supren"

#: view/kateview.cpp:709
msgid "Select Page Up"
msgstr "Selekti paĝon supren"

#: view/kateview.cpp:714
msgid "Move to Top of View"
msgstr "Moviĝi al komenco de rigardo"

#: view/kateview.cpp:719
msgid "Select to Top of View"
msgstr "Selekti ĝis komenco de rigardo"

#: view/kateview.cpp:725
msgid "Scroll Page Down"
msgstr "Ruli je unu linio malsupren"

#: view/kateview.cpp:730
msgid "Select Page Down"
msgstr "Selekti paĝon malsupren"

#: view/kateview.cpp:735
msgid "Move to Bottom of View"
msgstr "Moviĝi al fino de rigardo"

#: view/kateview.cpp:740
msgid "Select to Bottom of View"
msgstr "Selekti ĝis fino de rigardo"

#: view/kateview.cpp:745
msgid "Move to Matching Bracket"
msgstr "Iri al koresponda krampo"

#: view/kateview.cpp:750
msgid "Select to Matching Bracket"
msgstr "Selekti ĝis koresponda krampo"

#: view/kateview.cpp:759
msgid "Transpose Characters"
msgstr "Interŝanĝi signojn"

#: view/kateview.cpp:764
msgid "Delete Line"
msgstr "Forigi linion"

#: view/kateview.cpp:769
msgid "Delete Word Left"
msgstr "Forigi vorton maldekstre"

#: view/kateview.cpp:774
msgid "Delete Word Right"
msgstr "Forigi vorton dekstre"

#: view/kateview.cpp:779
msgid "Delete Next Character"
msgstr "Forigi sekvan signon"

#: view/kateview.cpp:784
msgid "Backspace"
msgstr "Retropaŝo"

#: view/kateview.cpp:825
msgid "Collapse Toplevel"
msgstr "Faldi globalnivele"

#: view/kateview.cpp:830
msgid "Expand Toplevel"
msgstr "Ekspandi globalnivele"

#: view/kateview.cpp:835
msgid "Collapse One Local Level"
msgstr "Faldi je unu loka nivelo"

#: view/kateview.cpp:840
msgid "Expand One Local Level"
msgstr "Ekspandi je unu loka nivelo"

#: view/kateview.cpp:867
msgid "R/O"
msgstr "N/L"

#: view/kateview.cpp:869
msgid "OVR"
msgstr "ANS"

#: view/kateview.cpp:869
msgid "INS"
msgstr "ENM"

#: view/kateview.cpp:1792
