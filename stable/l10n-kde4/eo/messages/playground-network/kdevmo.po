#. i18n: ectx: property (toolTip), widget (Q3ButtonGroup, diagram_scalingModeButtonGroup)
#: rc.cpp:107
msgid "Scaling mode (determines how small traffic rates are drawn)"
msgstr ""

#. i18n: file: prefsdialog.ui:379
#. i18n: ectx: property (whatsThis), widget (Q3ButtonGroup, diagram_scalingModeButtonGroup)
#: rc.cpp:110
msgid ""
"<b>Scaling mode</b>\n"
"<p>\n"
"<b>Cubic root</b> means that the diagrams are drawn with the cubic root of "
"each traffic value. The result is that small values are shown higher than "
"they are.\n"
"<b>Normal</b> means just what it says.\n"
"</p>"
msgstr ""

