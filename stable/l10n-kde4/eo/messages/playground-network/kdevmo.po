#. i18n: file: prefsdialog.ui:428
#. i18n: ectx: property (whatsThis), widget (Q3ButtonGroup, diagram_graphPositionButtonGroup)
#: rc.cpp:129
msgid ""
"<b>Graph position</b>\n"
"<p>\n"
"<b>Top and bottom</b> means that the input graph is drawn on the top of the "
"frame and the output graph on the bottom.<br>\n"
"With <b>Only bottom</b> the input graph is drawn on the bottom of the frame "
"and the output graph on top of the input graph.\n"
"</p>"
msgstr ""

