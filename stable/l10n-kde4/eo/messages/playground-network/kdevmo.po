#: rc.cpp:14
msgid ""
"<b>Refresh time</b>\n"
"<p>\n"
"The refresh time determines how often diagrams and stats are updated. You "
"can select one of the proposed values or edit the field manually.\n"
"</p>"
msgstr ""

#. i18n: file: prefsdialog.ui:60
#. i18n: ectx: property (text), widget (QLabel, general_refreshTimeLabel)
#: rc.cpp:20
