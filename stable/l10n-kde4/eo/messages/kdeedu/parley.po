#: kva_init.cpp:537
msgid ""
"Enter space-separated search terms to find words.\n"
"\n"
"Enter ^abc to look for words beginning with \"abc\".\n"
"Enter abc$ to look for words ending with \"abc\".\n"
"Enter type:verb to search for verbs."
msgstr ""
"Enmetu serĉindajn terminojn apartigitajn per spacoj por trovi vortojn.\n"
"\n"
"Enmetu ^abc por serĉi vortojn kiuj komencas per \"abc\".\n"
"Enmetu ^abc por serĉi vortojn kiuj finiĝas per \"abc\".\n"
"Enmetu type:verb por serĉi verbojn."

