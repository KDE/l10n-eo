#: board.cpp:403
#, kde-format
msgid ""
"You won.\n"
"You even removed the last stone, great job!\n"
" Your score was %1."
msgstr ""
"Vi gajnis.\n"
"Vi forigis eĉ la lastan ŝtonon, bonega laboro!\n"
" Tio donis al vi %1 poentojn sume."

#: board.cpp:405
#, kde-format
msgid ""
"Game over.\n"
"There are no more removable stones.\n"
" Your score was %1."
msgstr ""
"Ludfino.\n"
"Ne plu estas forigeblaj ŝtonoj.\n"
" Vi ricevis %1 poentojn sume."

