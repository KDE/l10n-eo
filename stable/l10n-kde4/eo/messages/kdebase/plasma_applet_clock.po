#. i18n: file: clockConfig.ui:24
#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: rc.cpp:3
msgid "Appearance"
msgstr "Aspekto"

#. i18n: file: clockConfig.ui:35
#. i18n: ectx: property (toolTip), widget (QCheckBox, showSecondHandCheckBox)
#: rc.cpp:6
msgid "Show the seconds"
msgstr "Montri la sekundojn"

#. i18n: file: clockConfig.ui:38
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showSecondHandCheckBox)
#: rc.cpp:9
msgid "Check this if you want to show the seconds."
msgstr "Ŝaltu tion se vi volas ke montriĝas la sekundoj."

#. i18n: file: clockConfig.ui:41
#. i18n: ectx: property (text), widget (QCheckBox, showSecondHandCheckBox)
#: rc.cpp:12
msgid "Show &seconds"
msgstr "Montri la &sekundojn"

#. i18n: file: clockConfig.ui:48
#. i18n: ectx: property (toolTip), widget (QCheckBox, showTimeStringCheckBox)
#: rc.cpp:15
msgid "Show the time in text"
msgstr "Montri la tempon kiel tekston"

#. i18n: file: clockConfig.ui:51
#. i18n: ectx: property (whatsThis), widget (QCheckBox, showTimeStringCheckBox)
#: rc.cpp:18
msgid "Check this if you want to display the time as text within the clock."
msgstr "Ŝaltu tion se vi volas montri la tempon kiel tekston en la horloĝo."

#. i18n: file: clockConfig.ui:54
#. i18n: ectx: property (text), widget (QCheckBox, showTimeStringCheckBox)
#: rc.cpp:21
msgid "Also show the time as text"
msgstr "Ankaŭ montri la tempon kiel tekston"

#. i18n: file: clockConfig.ui:66
#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: rc.cpp:24
msgid "Timezones"
msgstr "Tempzonoj"

#. i18n: file: clockConfig.ui:77
#. i18n: ectx: property (text), widget (QCheckBox, localTimeZone)
#: rc.cpp:27
msgid "Use &local timezone"
msgstr "Uzi la &lokan tempzonon"

#. i18n: file: clockConfig.ui:91
#. i18n: ectx: property (text), widget (KTimeZoneWidget, timeZones)
#: rc.cpp:30
msgid "Area"
msgstr "Zono"

#. i18n: file: clockConfig.ui:96
#. i18n: ectx: property (text), widget (KTimeZoneWidget, timeZones)
#: rc.cpp:33
msgid "Region"
msgstr "Regiono"

#. i18n: file: clockConfig.ui:101
#. i18n: ectx: property (text), widget (KTimeZoneWidget, timeZones)
#: rc.cpp:36
msgid "Comment"
msgstr "Komento"

