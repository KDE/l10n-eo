"north-america.pool.ntp.org,oceania.pool.ntp.org"
msgstr ""
"Publika tempservilo (pool.ntp.org),asia.pool.ntp.org,europe.pool.ntp.org,"
"north-america.pool.ntp.org,oceania.pool.ntp.org"

#: dtime.cpp:324
#, kde-format
