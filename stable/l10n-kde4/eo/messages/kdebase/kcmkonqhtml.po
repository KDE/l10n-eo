#: htmlopts.cpp:212
#, fuzzy
#| msgid ""
#| "Controls how Konqueror shows animated images:<br /><ul><li><b>Enabled</"
#| "b>: Show all animations completely.</li><li><b>Disabled</b>: Never show "
#| "animations, show the start image only.</li><li><b>Show only once</b>: "
