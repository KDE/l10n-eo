msgid "Useful tips"
msgstr "Utilaj konsiloj"

#: ktipwindow.cpp:35
msgid "KTip"
msgstr "KTip"

#: ktipwindow.cpp:37
msgid "(c) 1998-2002, KDE Developers"
msgstr "(c) 1998-2002, KDE Developers"

