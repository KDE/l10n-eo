#: kwriteconfig.cpp:21
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:23
msgid "Write KConfig entries - for use in shell scripts"
msgstr "Skribi KConfig enigaĵojn - por uzo en ŝelaj skriptaĵoj"

#: kwriteconfig.cpp:25
msgid "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"
msgstr "(c) 2001 Red Hat, Inc. & Luís Pedro Coelho"

#: kwriteconfig.cpp:26
msgid "Luís Pedro Coelho"
msgstr "Luís Pedro Coelho"

#: kwriteconfig.cpp:27
msgid "Bernhard Rosenkraenzer"
msgstr "Bernhard Rosenkraenzer"

#: kwriteconfig.cpp:27
msgid "Wrote kreadconfig on which this is based"
msgstr "Skribis kreadconfig sur kiu ĉi tiu baziĝas"

#: kwriteconfig.cpp:31
msgid "Use <file> instead of global config"
msgstr "Uzi <file> anstataŭ malloka agordo"

#: kwriteconfig.cpp:32
msgid "Group to look in"
msgstr "Grupigi por enrigardi"

#: kwriteconfig.cpp:33
msgid "Key to look for"
msgstr "Serĉenda ŝlosilo"

#: kwriteconfig.cpp:34
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"Variabla tipo. Uzu \"bool\" por bulea, alie ĝi estas rigardata kiel ĉeno"

#: kwriteconfig.cpp:35
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "La skribenda valoro. Ĉe ŝelo vi devas uzi '' kiel malplena"
