#: daemon/chargethreshold_helper_actions.actions:2
#: daemon/controllers/backlight_helper_actions.actions:2
#: daemon/discretegpu_helper_actions.actions:2
msgctxt "Name"
msgid "KDE"
msgstr "KDE"

#: daemon/chargethreshold_helper_actions.actions:63
msgctxt "Name"
msgid "Get current battery charge limit"
msgstr "Akiri la aktualan limon de baterioŝarĝo"

#: daemon/chargethreshold_helper_actions.actions:110
msgctxt "Description"
msgid "Authenticate to see the current battery charge limit."
msgstr "Aŭtentiĝu por vidi la aktualan limon de baterioŝarĝo."

#: daemon/chargethreshold_helper_actions.actions:154
msgctxt "Name"
msgid "Set battery charge limit"
msgstr "Agordi la limon de ŝarĝo de la baterioj"

#: daemon/chargethreshold_helper_actions.actions:201
msgctxt "Description"
msgid "Authenticate to set the battery charge limit."
msgstr "Aŭtentiĝu por meti la aktualan limon de baterioŝarĝo."

#: daemon/chargethreshold_helper_actions.actions:245
msgctxt "Name"
msgid "Check battery conservation mode"
msgstr "Kontroli baterikonservan reĝimon"

#: daemon/chargethreshold_helper_actions.actions:285
msgctxt "Description"
msgid "Authenticate to check the current state of battery conservation mode."
msgstr "Aŭtentiĝu por kontroli la aktualan staton de bateriokonserva reĝimo."

#: daemon/chargethreshold_helper_actions.actions:328
msgctxt "Name"
msgid "Set battery conservation mode"
msgstr "Agordi baterikonservan reĝimon"

#: daemon/chargethreshold_helper_actions.actions:368
msgctxt "Description"
msgid "Authenticate to set the battery conservation mode."
msgstr "Aŭtentiĝu por meti la bateriokonservan reĝimon."

#: daemon/controllers/backlight_helper_actions.actions:63
msgctxt "Name"
msgid "Get maximum brightness value"
msgstr "Akiri maksimuman brilvaloron"

#: daemon/controllers/backlight_helper_actions.actions:120
msgctxt "Description"
msgid "Authenticate to see the maximum brightness level."
msgstr "Aŭtentiĝu por vidi la maksimuman brilnivelon."

#: daemon/controllers/backlight_helper_actions.actions:164
msgctxt "Name"
msgid "Get brightness"
msgstr "Akiri brilon"

#: daemon/controllers/backlight_helper_actions.actions:221
msgctxt "Description"
msgid "Authenticate to see the brightness level."
msgstr "Aŭtentiĝu por vidi la brilnivelon."

#: daemon/controllers/backlight_helper_actions.actions:265
msgctxt "Name"
msgid "Set brightness"
msgstr "Agordi brilon"

#: daemon/controllers/backlight_helper_actions.actions:322
msgctxt "Description"
msgid "Authenticate to set the brightness level."
msgstr "Aŭtentiĝu por meti la brilnivelon."

#: daemon/controllers/backlight_helper_actions.actions:365
msgctxt "Name"
msgid "Get syspath"
msgstr "Akiri syspath"

#: daemon/controllers/backlight_helper_actions.actions:420
msgctxt "Description"
msgid "Authenticate to see the syspath."
msgstr "Aŭtentiĝu por vidi la syspath."

#: daemon/discretegpu_helper_actions.actions:63
msgctxt "Name"
msgid "Check for existence of discrete GPU"
msgstr "Kontroli pri ekzisto de diskreta GPU"

#: daemon/discretegpu_helper_actions.actions:104
msgctxt "Description"
msgid "Authenticate to check for the existence of a discrete GPU."
msgstr "Aŭtentiĝu por kontroli pri la ekzisto de diskreta GPU."

#: daemon/powerdevil.desktop.cmake:4 powerdevil.notifyrc:2
msgctxt "Name"
msgid "Power Management"
msgstr "Potenca Administrado"

#: daemon/powerdevil.desktop.cmake:66
msgctxt "Comment"
msgid "Battery, Display and CPU power management and notification"
msgstr "Baterio, Ekrano kaj CPU-potencadministrado kaj sciigo"

#: powerdevil.notifyrc:59
msgctxt "Comment"
msgid "Power Management System"
msgstr "Potencadministra Sistemo"

#: powerdevil.notifyrc:118
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: powerdevil.notifyrc:174
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Uzita por avertaj sciigoj"

#: powerdevil.notifyrc:232
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: powerdevil.notifyrc:289
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Uzita por normaj sciigoj"

#: powerdevil.notifyrc:347
msgctxt "Name"
msgid "Critical notification"
msgstr "Kritika sciigo"

#: powerdevil.notifyrc:403
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Sciigas kritikan eventon"

#: powerdevil.notifyrc:461
msgctxt "Name"
msgid "Battery Low"
msgstr "Baterio Malalta"

#: powerdevil.notifyrc:517
msgctxt "Comment"
msgid "Battery has reached low level"
msgstr "Baterio atingis malaltan nivelon"

#: powerdevil.notifyrc:561
msgctxt "Name"
msgid "Battery Critical"
msgstr "Baterio Kritika"

#: powerdevil.notifyrc:617
msgctxt "Comment"
msgid ""
"Battery has reached critical level. This notification triggers a countdown "
"before doing the configured action, hence it is strongly advised to leave it "
"on."
msgstr ""
"Baterio atingis kritikan nivelon. Ĉi tiu sciigo ekigas retronombradon antaŭ "
"ol fari la agorditan agon, tial estas forte konsilite lasi tion ŝaltata."

#: powerdevil.notifyrc:662
msgctxt "Name"
msgid "Charge Complete"
msgstr "Ŝarĝo Kompleta"

#: powerdevil.notifyrc:717
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "La baterio estas plene ŝargita"

#: powerdevil.notifyrc:778
msgctxt "Name"
msgid "Peripheral Battery Low"
msgstr "Ekstercentra Baterio Malalta"

#: powerdevil.notifyrc:831
msgctxt "Comment"
msgid "The battery in a connected device, such as mouse or keyboard, is low"
msgstr "La baterio en konektita aparato, kiel muso aŭ klavaro, estas malalta"

#: powerdevil.notifyrc:890
msgctxt "Name"
msgid "Power source connected"
msgstr "Elektrofonto konektita"

#: powerdevil.notifyrc:937
msgctxt "Comment"
msgid "The power source has been connected"
msgstr "La energifonto estis konektita"

#: powerdevil.notifyrc:990
msgctxt "Name"
msgid "Power source disconnected"
msgstr "Elektrofonto malkonektita"

#: powerdevil.notifyrc:1037
msgctxt "Comment"
msgid "The power source has been disconnected"
msgstr "La energifonto estis malkonektita"
