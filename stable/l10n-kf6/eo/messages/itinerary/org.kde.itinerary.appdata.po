#. (itstool) path: component/name
#: org.kde.itinerary.appdata.xml:12
msgid "KDE Itinerary"
msgstr "KDE-Itinero"

#. (itstool) path: component/summary
#: org.kde.itinerary.appdata.xml:13
msgid "Digital travel assistant"
msgstr "Cifereca vojaĝasistanto"

#. (itstool) path: description/p
#: org.kde.itinerary.appdata.xml:15
msgid ""
"KDE Itinerary is a digital travel assistant with a priority on protecting "
"your privacy."
msgstr ""
"KDE-Itinero estas cifereca vojaĝasistanto kun prioritato pri protektado de "
"via privateco."

#. (itstool) path: description/p
#: org.kde.itinerary.appdata.xml:16
msgid "Features:"
msgstr "Trajtoj:"

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:18
msgid ""
"Timeline view of a unified travel itinerary with automatic trip grouping."
msgstr "Templiniovido de unuigita vojaĝa itinero kun aŭtomata vojaĝgrupo."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:19
msgid ""
"Supports train, bus and flight bookings as well as hotel, restaurant, event "
"and rental car reservations."
msgstr ""
"Subtenas rezervojn de trajno, buso kaj flugo kaj ankaŭ rezervojn de hotelo, "
"restoracio, evento kaj luaŭto."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:20
msgid "Boarding pass management."
msgstr "Administrado de enirpermesiloj."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:21
msgid ""
"Supports ticket management for multi-traveler and multi-ticket bookings."
msgstr ""
"Subtenas biletadministradon por plurvojaĝantoj kaj plurbiletaj rezervoj."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:22
msgid ""
"Automatic booking data extraction from various input formats, performed "
"locally on your device."
msgstr ""
"Aŭtomata rezervada eltiro de diversaj enigformatoj, farita loke sur via "
"aparato."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:23
msgid "Real-time delay and platform change information for trains."
msgstr "Realtempa prokrasto kaj platformoŝanĝaj informoj por trajnoj."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:24
msgid "Weather forecast for destination along your trip."
msgstr "Veterprognozo por celloko dum via vojaĝo."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:25
msgid "Full control over all online access."
msgstr "Plena kontrolo super ĉiu interreta aliro."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:26
msgid ""
"Selection of alternative train connections on unbound tickets or on missed "
"connections."
msgstr ""
"Elekto de alternativaj trajnkonektoj sur nebinditaj biletoj aŭ ĉe sopiritaj "
"konektoj."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:27
msgid ""
"Local ground transportation navigation between elements of your itinerary."
msgstr "Loka surtera transporta navigado inter elementoj de via itinero."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:28
msgid "Train coach layout view (for some operators only)."
msgstr "Trajna vagona enpaĝigvido (nur por kelkaj funkciigistoj)."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:29
msgid "Train station and airport per-floor maps based on OpenStreetMap data."
msgstr ""
"Trajna stacidomo kaj flughaveno po-etaĝaj mapoj bazitaj sur OpenStreetMap-"
"datenoj."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:30
msgid ""
"Available dock-based or free-floating rental bikes can be displayed on the "
"train station map."
msgstr ""
"Disponeblaj dok-bazitaj aŭ liber-flosantaj lubicikloj povas esti montritaj "
"sur la fervoja stacidoma mapo."

#. (itstool) path: ul/li
#: org.kde.itinerary.appdata.xml:31
msgid "Personal travel statistics to monitor environmental impact."
msgstr "Personaj vojaĝaj statistikoj por monitori median efikon."

#. (itstool) path: description/p
#: org.kde.itinerary.appdata.xml:33
msgid ""
"KDE Itinerary works best alongside KMail's itinerary extraction plug-in and "
"KDE Connect, or Nextcloud Hub and DavDroid."
msgstr ""
"KDE-Itinero funkcias plej bone kune kun la aldonaĵo de KMail-eltiro de "
"itinero kaj KDE Connect, aŭ Nextcloud Hub kaj DavDroid."

