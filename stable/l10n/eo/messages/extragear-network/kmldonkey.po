#: kmldonkey/prefs/generalpage.ui.h:26
msgid ""
"<p><b>Changing the text encoding may result in unpredictable behavior.</b></p>\n"
"<p>You must take care to select an encoding that is relatively compatible with "
"ISO 8859-1, as you are guaranteed to receive ISO 8859-1 encoded text from "
"MLDonkey. Even so, KMLDonkey <i>may crash or fail to work properly</i> "
"if you use any text encoding other than ISO 8859-1. Proceed at your own "
"risk.</p>"
msgstr ""
"<p><b>Ŝanĝi la kodoprezenton eble kaŭzus neantaŭvideblan konduton.</b></p>\n"
"<p>Vi devus elekti kodoprezenton kiu akordas relative kun ISO 8859-1, ĉar estas "
"certe ke vi recevos ISO 8859-1 kodatan tekston el MLAzeno. Eĉ tiel, KMLAzeno "
"pove <i>kraŝus aŭ fiaskus funkcii taŭge</i> se vi uzas alian kodoprezenton ol "
"ISO 8859-1. Kontinui je via propra danĝero.</p>"

#: kmldonkey/prefs/generalpage.ui.h:31
msgid "Text Encoding Warning"
msgstr "Kodoprezenta atento"

