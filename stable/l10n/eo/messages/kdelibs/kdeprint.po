"<center>  <table border=\"1\" width=\"70%\">  "
"<tr>"
"<th><b>Original</b></th> "
"<th><b>hue=-45</b></th> "
"<th><b>hue=45</b></th>   </tr>  "
"<tr>"
"<td>Red</td>             "
