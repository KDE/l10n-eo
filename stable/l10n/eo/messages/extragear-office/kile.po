#: tabulardialog.cpp:431
msgid "Column or cell alignment."
msgstr "Kolumna aŭ ĉela aranĝo."

#: tabulardialog.cpp:432
msgid "Set bold font series."
msgstr "Aktivigu grasan tiparon."

#: tabulardialog.cpp:433
msgid "Set italic font shape."
msgstr "Aktivigu oblikvan tiparon"

#: tabulardialog.cpp:434
msgid "The text will be aligned at the left border of the cell."
msgstr "La teksto estos aranĝata en la maldekstra flanko de la ĉelo."

#: tabulardialog.cpp:435
msgid "The text will be centered."
msgstr "La teksto estos centre."

#: tabulardialog.cpp:436
msgid "The text will be aligned at the right border of the cell."
msgstr "La teksto estos aranĝata en la dekstra flanko de la ĉelo."

#: tabulardialog.cpp:437
msgid "Choose a background color (needs color package)."
msgstr "Elektu fonkoloron (bezonas kolorpakaĵon)."

#: tabulardialog.cpp:438
msgid "Choose a text color (needs color package)."
msgstr "Elektu tekstkoloron (bezonas kolorpakaĵon)."

#: tabulardialog.cpp:439
msgid "Insert decl directly in front of the column entry."
msgstr "Enmetas la deklaron senpere fronte al la kolumnero."

#: tabulardialog.cpp:440
msgid "Insert decl right after the column entry."
msgstr "Enmetas la deklaron tuj post la kolumnero."

#: tabulardialog.cpp:441
msgid "Suppresses inter-column space and inserts decl directly."
msgstr "Forigas la interkolumnan spaceton kaj enmetas senpere la deklaron."

#: tabulardialog.cpp:442
msgid ""
"Inserts decl, but does not suppress the normally inserted space between columns "
"in contrast to @{decl}."
msgstr ""
"Enmetas la deklaron, sed ne forigas la normajn interkolumnajn spacetojn, "
"kontraŭeal @{decl}."

#: tabulardialog.cpp:443
msgid "Clear all border lines."
msgstr "Forigu ĉiujn borderojn."

#: tabulardialog.cpp:444
msgid "Set left and right border lines."
msgstr "Aldonu la dekstran kaj maldekstran borderojn."

#: tabulardialog.cpp:445
msgid "Set upper and lower border line."
msgstr "Aldonu la supran kaj malsupran borderojn."

#: tabulardialog.cpp:446
msgid "Set all border lines."
msgstr "Aldonu ĉiujn borderojn."

#: tabulardialog.cpp:447
msgid ""
"Set user defined border lines. A mouse click into one of the four border ranges "
"will set or clear this special border line."
msgstr ""
"Difinas proprajn borderojn. Unu musklako sur unu el kvar borderaj zonoj enmetos "
"aŭ forigos tiun propran borderon."

#: tabulardialog.cpp:449
msgid ""
"Reset all settings to standard cell attributes: left alignment, normal font "
"series and shape, white background color, black text color, no border lines."
msgstr ""
"Reŝargas la normajn ĉelecojn : maldekstre aranĝo, norma tiparo, blanka "
"fonkoloro, nigra tekstkoloro kaj neniuj borderoj."

