"OPT... : nedevigaj kampoj (uzu « Purigu » por forigu ilin) "

#: kilestdactions.cpp:220
msgid "Chapter or Pages in Book"
msgstr "Ĉapitro aŭ paĝoj de libro"

#: kilestdactions.cpp:220
msgid ""
"Bib fields - Chapter or Pages in a Book\n"
"ALT.... : you have the choice between these two fields\n"
"OPT.... : optional fields (use the 'Clean' command to remove them)"
msgstr ""
"Bibliografiaj kampoj - Ĉapitro aŭ paĝoj de libro\n"
"ALT.... : vi povas elekti inter tiuj du kampoj\n"
"OPT... : nedevigaj kampoj (uzu « Purigu » por forigu ilin) "

#: kilestdactions.cpp:221
msgid "Conference Proceedings"
msgstr "Konferencaj agoj"

#: kilestdactions.cpp:221
msgid ""
"Bib fields - Conference Proceedings\n"
"OPT.... : optional fields (use the 'Clean' command to remove them)"
msgstr ""
"Bibliografiaj kampoj - Konferencaj agoj\n"
"OPT... : nedevigaj kampoj (uzu « Purigu » por forigu ilin) "

#: kilestdactions.cpp:222
msgid "Book"
msgstr "Libro"

#: kilestdactions.cpp:222
msgid ""
"Bib fields - Book\n"
"ALT.... : you have the choice between these two fields\n"
"OPT.... : optional fields (use the 'Clean' command to remove them)"
msgstr ""
"Bibliografiaj kampoj - Libro\n"
"ALT.... : vi povas elekti inter tiuj du kampoj\n"
"OPT... : nedevigaj kampoj (uzu « Purigu » por forigu ilin) "

#: kilestdactions.cpp:223
msgid "Booklet"
msgstr "Broŝuro"

#: kilestdactions.cpp:223
msgid ""
"Bib fields - Booklet\n"
"OPT.... : optional fields (use the 'Clean' command to remove them)"
msgstr ""
"Bibliografiaj kampoj - Broŝuro\n"
"OPT... : nedevigaj kampoj (uzu « Purigu » por forigu ilin) "

#: kilestdactions.cpp:224
msgid "PhD. Thesis"
msgstr "Doktora tezo"

#: kilestdactions.cpp:224
msgid ""
"Bib fields - PhD. Thesis\n"
"OPT.... : optional fields (use the 'Clean' command to remove them)"
msgstr ""
"Bibliografiaj kampoj - Doktora tezo\n"
