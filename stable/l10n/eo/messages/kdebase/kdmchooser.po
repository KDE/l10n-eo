#: chooser.cpp:31
msgid "Login chooser for Xdmcp"
msgstr "Salutelektilo por Xdmcp"

#: chooser.cpp:62
msgid "Specify the chooser socket (in hex)"
msgstr "Indiku la elektilon (\"socket\") (deksesuma)"

#: chooser.cpp:63
msgid "Specify the client ip (in hex)"
msgstr "Indiku la klientan ip-adreson (deksesuma)"

#: chooser.cpp:64
