msgid "Anti-Spam/Virus Wizard"
msgstr "Kontraŭdisafiŝada/Kontraŭvirusa helpilo"

#: antispamwizard.cpp:98
msgid "Welcome to the KMail Anti-Spam/Virus Wizard."
msgstr "Bonveno al la kontraŭdisafiŝada/kontraŭvirusa helpilo de Poŝtilo."

#: antispamwizard.cpp:100
