#: klprfax_config.cpp:275
msgid "/etc/printcap section successfully made, and klprfax LPD spool directory too."
msgstr ""
"La alineo en /etc/printcap sukcese kreiĝis, kaj la LPD-atendvico-dosierujo "
"por klprfax same."

#: klprfax_config.cpp:281
msgid ""
"/etc/printcap section successfully made.\n"
"klprfax LPD spool directory already exists."
msgstr ""
"La alineo en /etc/printcap sukcese kreiĝis.\n"
"Sed la LPD-atendvico-dosierujo por klprfax jam ekzistis :-)."

#: klprfax_config.cpp:287
msgid ""
"/etc/printcap section successfully made.\n"
"klprfax LPD spool directory made, but LPD daemon can't be started. Please "
"check the LPD daemon."
msgstr ""
"La alineo en /etc/printcap sukcese kreiĝis.\n"
"La LPD-atendvico-dosierujo por klprfax ankaŭ kreiĝis, sed la LPD-demonon "
"ne eblis lanĉi :-(. Bonvolu ekzameni la demonon."

#: klprfax_config.cpp:294
msgid ""
"/etc/printcap section successfully made.\n"
"klprfax LPD spool directory couldn't be made.\n"
"This won't work, please make spool directory by hand."
msgstr ""
"La alineo en /etc/printcap sukcese kreiĝis.\n"
"Sed la LPD-atendvicodosierujo por klprfax ne estis kreebla :-(.\n"
"Bonvolu permane krei la dosierujon."

#: klprfax_config.cpp:319
msgid "Unexpected: Can't open /etc/klprfax!"
msgstr "Neatendite: Ne eblis malfermi la dosieron /etc/klprfax!"

#: klprfax_config.cpp:341
msgid "Unexpected: Can't write $HOME/.klprfax!"
msgstr "Neatendite: Ne eblis skribi al la dosiero $HOME/.klprfax!"

#: main.cpp:27
msgid ""
"K Send a Fax\n"
"\n"
"With this program you can make a printer that\n"
"acts as a fax. The program uses efax package of\n"
"Ed Casas (GPL2)"
msgstr ""
"Fakssendilo\n"
"\n"
"Per tiu ĉi programo vi povas krei presilon, kiu laboras kiel faksilo\n"
"La programo uzas la pakaĵon \"efax\" de\n"
"Ed Casas (GPL2)"

