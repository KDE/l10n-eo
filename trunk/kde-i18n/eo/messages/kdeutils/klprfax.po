#: klprfax_config.cpp:203
msgid ""
"The name of the LPD fax printer definition can only consist of a-z or A-Z "
"characters."
msgstr ""
"La nomo de la LPD-fakspresilo-difino povas konsisti nur el la literoj a-z "
"kaj A-Z."

#: klprfax_config.cpp:210
msgid "The name of the LPD fax printer definition can not be empty."
msgstr "La nomo de la LPD-faks-presilo-difino ne estu malplena."

