#: portable.cpp:710
msgid ""
"Your computer or operating system is not supported by the current version of "
"the\n"
"KDE laptop control panels, if you want help porting these panels to work with"
" it\n"
"please contact paul@taniwha.com"
msgstr ""
"Via komputilo aŭ operaciumo ne estas subtenata de tiu ĉi versio de la KDE-p"
"ortkomputila modulo. Se vi volas helpi en la adapto al via sistemo bonvolu ko"
"ntakti al paul@taniwha.com"

