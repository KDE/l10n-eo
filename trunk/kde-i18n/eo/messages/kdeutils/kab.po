#: kab_createnew.cc:43
msgid ""
"This file is a directory, or it already exists.\n"
"Please select another filename.\n"
"You must have permission to write to create the new file."
msgstr ""
"Tio estas dosierujo, aŭ jam ekzistanta dosiero.\n"
"Bonvolu indiki alian dosiernomon.\n"
"Cetere vi bezonas skribpermeson por krei novan dosieron."

