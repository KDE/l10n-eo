msgid ""
"<qt>At least one <b>resource file</b> used to export your address book to HTM"
"L is missing. Continue anyway?<br><br><i>(Resources are used as support files"
" like backgrounds or bullets in the resulting HTML files.)</i></qt>"
msgstr ""
"<qt>Almenaŭ unu <b>rimeddosiero</b> necesa por eksporti vian adresaron al HT"
"ML mankas. Ĉu tamen daŭrigi?<br><br><i>(Rimedoj estas uzataj kiel subtendos"
"ieroj kiel fonoj, simbloj ktp. en la rezultaj HTML-doserioj.)</i></qt>"

