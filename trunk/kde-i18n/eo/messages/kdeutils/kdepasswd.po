#: kdepasswd.cpp:24
msgid "Change password of this user."
msgstr "Ŝanĝu la pasvorton de tiu uzanto."

#: kdepasswd.cpp:31
msgid "KDE passwd"
msgstr "KDE-pasvorto"

#: kdepasswd.cpp:32
msgid "Changes a UNIX password."
msgstr "Ŝanĝas uniksan pasvorton."

#: kdepasswd.cpp:34
msgid "Maintainer"
msgstr "Fleganto"

#: kdepasswd.cpp:56
msgid "Your password has been changed."
msgstr "Via pasvorto estas ŝanĝita."

#: passwddlg.cpp:21 passwddlg.cpp:81
msgid "Change Password"
msgstr "Ŝanĝu pasvorton"

#: passwddlg.cpp:22
msgid "Please enter your current password."
msgstr "Bonvolu entajpi vian nunan pasvorton."

#: passwddlg.cpp:39 passwddlg.cpp:132
msgid "Conversation with `passwd' failed."
msgstr "Interkomunikado kun 'passwd' malsukcesis."

#: passwddlg.cpp:47
msgid "Could not find the program `passwd'."
msgstr "Ne troviĝis la programo 'passwd'."

#: passwddlg.cpp:51
msgid "Incorrect password! Please try again."
msgstr "MAlĝusta pasvorto! Bonvolu reprovi."

#: passwddlg.cpp:55
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "Interna eraro: nevalida valoro de PasswdProcess::checkCurrent."

#: passwddlg.cpp:82
msgid "Please enter your new password."
msgstr "Bonvolu tajpi vian novan pasvorton."

#: passwddlg.cpp:98
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Via pasvorto estas pli longa ol 8 signoj. Je kelkaj sistemoj, tio povas fari "
"problemojn. Vi povas ŝanĝi la pasvorton al 8 signoj, aŭ lasi."

#: passwddlg.cpp:101
msgid "Password too long"
msgstr "Pasvorto tro longa"

#: passwddlg.cpp:102
msgid "Truncate"
msgstr "Tranĉu"

#: passwddlg.cpp:103
msgid "Use as is"
msgstr "Uzu ĝin"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Wolfram Diestel,Steffen Pietsch"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "<wolfram@steloj.de>,<Steffen.Pietsch@BerlinOnline.de>"

#~ msgid "Your password will be truncated to 8 characters."
#~ msgstr "Via pasvorto estos mallongigata al 8 signoj."
