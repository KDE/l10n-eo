msgid "SIGUSR1 (user-defined 1)"
msgstr "SIGUSR1 (uzantodifinita 1)"

#: qps.C:378
msgid "SIGUSR2 (user-defined 2)"
msgstr "SIGUSR2 (uzantodifinita 2)"

#: qps.C:379
