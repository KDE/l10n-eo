#: klpq.cpp:319
msgid "Do you really want to remove job No %1?"
msgstr "Ĉu vi vere volas forigi la taskon n-ro %1?"

#: klpq.cpp:322
msgid "Do you really want to remove the marked jobs?"
msgstr "Ĉu vi vere volas forigi la elektitajn taskojn?"

#: klpq.cpp:357
msgid ""
"Do you really want to move job No %1\n"
"to top of queue?"
msgstr ""
"Ĉu vi vere volas ŝovi la taskon n-ro %1\n"
"al la komenco de la atendvico?"

#: klpq.cpp:360
msgid ""
"Do you really want to move the marked\n"
"jobs to top of queue?"
msgstr ""
"Ĉu vi vere volas ŝovi la elektitajn taskojn\n"
"al la komenco de la atendvico?"

#: klpq.cpp:506 klpq.cpp:512 klpq.cpp:529
msgid "This is a privileged command and you do not have permission to execute it."
msgstr "Tio estas komando bezonanta privilegion kaj vi ne havas permeson lanĉi ĝin."

#: klpq.cpp:508 klpq.cpp:514 klpq.cpp:531
msgid "Permission denied"
msgstr "Permeso mankas"

#: klpq.cpp:581
msgid ""
"<qt>Could not print some of the files. Please make sure you have access to "
"all files and that they are not directories.</qt>"
msgstr ""
"<qt>Ne eblis presi kelkajn el la dosieroj. Bonvolu certigi, ke vi havas "
"alirpermeson al ĉiuj dosieroj, kaj ke ili ne estas dosierujoj.</qt>"

#: ConfAutoUpdate.cpp:16
msgid "Update Frequency"
msgstr "Aktualigointervalo"

#: ConfAutoUpdate.cpp:30
msgid "Update frequency in seconds:"
msgstr "Aktualigointervalo en sekundoj:"

#: klpqspooler.cpp:115 klpqspooler.cpp:353
