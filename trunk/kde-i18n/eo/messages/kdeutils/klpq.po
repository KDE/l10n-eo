#: main.cpp:140
msgid "Sorry, can't open your printcap file."
msgstr "Pardonu, ne eblas malfermi la dosieron /etc/printcap"

#: main.cpp:145
msgid ""
"Unable to parse your printcap - probably you haven't configured any printers "
"yet."
msgstr ""
"Ne eblas analizi la dosieron /etc/printcap. Eble vi ĝis nun agordis neniun "
"presilon."

