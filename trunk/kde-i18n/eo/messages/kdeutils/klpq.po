msgstr "(normala enigo - stdin)"

#: klpqspooler.cpp:223
msgid ""
"Sorry, I can't find your lpc program.\n"
"Please check the configuration under Options->Spooler."
msgstr ""
"Pardonu, mi ne povas trovi la programon \"lpc\"\n"
"Bonvolu kontroli vian agordon sub Agordo->Vicanto."

#: klpqspooler.cpp:225 klpqspooler.cpp:302
msgid "Can't find your lpc program!"
msgstr "Ne eblas trovi la programon \"lpc\"!"

#: klpqspooler.cpp:300
msgid ""
"Sorry, I can't find your lpc program.\n"
"Please check the configuration under Config->Spooler."
msgstr ""
"Pardonu, mi ne povas trovi la programon \"lpc\"\n"
"Bonvolu kontrilo vian konfiguraĵon sub Agordo->Presilo."

#: FirstStart.cpp:12 SpoolerConfig.cpp:42
msgid "Select your spooling system"
msgstr "Elektu la vicanto-sistemon uzatan de vi"

#: FirstStart.cpp:16
msgid ""
"<qt>Please select the spooling system you use. Most systems use the "
"<b>BSD</b> spooler. So if you don't know which spooler is installed on your "
"system, BSD is probably a good choice.</qt>"
msgstr ""
"<qt>Bonvolu elekti la vicigsistemon de via sistemo. Plej multaj operaciumoj "
"uzas la vicigsistemon <b>BSD</b>. Do se vi ne scias, kiun elekti, BSD "
"verŝajne taŭgas.</qt>"

