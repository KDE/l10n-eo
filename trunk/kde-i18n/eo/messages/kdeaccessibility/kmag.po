#: kmagzoomview.cpp:116
msgid ""
"This is the main window which shows the contents of the selected region. The "
"contents will be magnified if zoom level is set."
msgstr ""
"Tiu estas la ĉefa fenestro kiu montras la enhavon de la elektata regiono.  La enhavon "
"grandiĝos po la indikata nivelo."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "David Anema"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "lassi_surinen@yahoo.ca"

#: main.cpp:37
msgid "File to open"
msgstr "Dosieron por malfermi"

#: main.cpp:45
msgid "KMagnifier"
msgstr "KMagnifier"

#: main.cpp:46
msgid "Screen magnifier for the K Desktop Environment (KDE)"
msgstr "Ekranlupeo por la K Tabulmedio (KDE)"

#: main.cpp:53
msgid "Rewrite and current maintainer"
msgstr "Reskribo kaj nuna zorganto"

#: main.cpp:56
msgid "Original idea and author (KDE1)"
msgstr "Originala ideo kaj aŭtoro (KDE1)"

#: main.cpp:58
msgid "Various patches"
msgstr "Diversaj flikaĵoj"

#: main.cpp:59
msgid "Some tips"
msgstr "Iom da helpnotoj"

#: rc.cpp:5
msgid "Other &Settings"
msgstr "Aliaj &Agordoj"

#: kmag.cpp:87
msgid "&Very Low"
msgstr "&Tre malalta"

#: kmag.cpp:87
msgid "&Low"
msgstr "&Malalta"

#: kmag.cpp:87
msgid "&Medium"
msgstr "Me&za"

#: kmag.cpp:87
msgid "&High"
msgstr "&Alta"

#: kmag.cpp:87
msgid "V&ery High"
msgstr "T&re alta"

#: kmag.cpp:122
msgid "New &Window"
msgstr "Nova &Fenestro"

#: kmag.cpp:124
msgid "Open a new KMagnifier window"
msgstr "Malfermu novan fenestron de KMagnifier"

#: kmag.cpp:126
msgid "&Stop"
msgstr "Ĉe&su"

#: kmag.cpp:128
msgid "Click to stop window refresh"
msgstr "Klaku por ĉesigi fenestran refreŝigon"

#: kmag.cpp:129
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  updating of the "
"display. Stopping the update will zero the processing power  required (CPU "
"usage)"
msgstr ""
"Klako super tiu piktogramo <b>komencigos</b>/<b>ĉesigos</b> ĝisdatiĝon "
"de la lupeo.  Ĉesigo nuligos la procezan potencon bezonatan (Procezilan uzon)."

#: kmag.cpp:133
msgid "&Save Snapshot As..."
msgstr "&Sekurigu ekranbildon kiel..."

#: kmag.cpp:135
msgid "Saves the zoomed view to an image file."
msgstr "Sekurigas la sublupean rigardon en bildodosiero."

#: kmag.cpp:136
msgid "Save image to a file"
msgstr "Sekurigas bildon en dosiero"

#: kmag.cpp:139
msgid "Click on this button to print the current zoomed view."
msgstr "Klaku super tiun butonon por presi la rigardon."

#: kmag.cpp:142 kmag.cpp:143
msgid "Quits the application"
msgstr "Finigas la aplikaĵon"

#: kmag.cpp:146
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which "
"you can paste in other applications."
msgstr ""
"Klaku super tiun butonon por kopii la rigardon al la poŝilo por enmeti "
"en aliaj aplikaĵoj."

#: kmag.cpp:147
msgid "Copy zoomed image to clipboard"
msgstr "Kopiu rigardon al poŝilo"

#: kmag.cpp:149
msgid "Show &Menu"
msgstr "&Montru menuon"

#: kmag.cpp:151
msgid "Show Main &Toolbar"
msgstr "Montru Ĉefan &Illistelon"

#: kmag.cpp:153
msgid "Show &View Toolbar"
msgstr "Montru &Rigardan Illistelon"

#: kmag.cpp:155
msgid "Show &Settings Toolbar"
msgstr "Montru &Agordan Illistelon"

#: kmag.cpp:159
msgid "&Always Fit Window"
msgstr "Ĉiam &plenu fenestron"

#: kmag.cpp:162
msgid "&Fit Window"
msgstr "Plenigu &fenestron"

#: kmag.cpp:164
msgid "Click on this button to fit the zoom view to the zoom window."
msgstr "Klaku tiun butonon por plenigi la fenestron per la lupean rigardon."

#: kmag.cpp:165
msgid "Maximize the use of the window"
msgstr "Maksimumigu la uzon de la fenestro"

#: kmag.cpp:167
msgid "&Follow Mouse"
msgstr "&Sekvu muson"

#: kmag.cpp:169
msgid "Magnify around the mouse cursor"
msgstr "Grandigu ĉirkaŭ la musan kursoron"

#: kmag.cpp:170
msgid "If selected, the area around the mouse cursor is magnified"
msgstr "Se elektata, la areo ĉirkaŭ la musan kursoron pligrandiĝas."

#: kmag.cpp:172
msgid "Hide Mouse &Cursor"
msgstr "Kaŝu musan &kursoron"

#: kmag.cpp:174
msgid "Hide the mouse cursor"
msgstr "Kaŝu la musan kursoron"

#: kmag.cpp:176
msgid "Selection &Window"
msgstr "&Elektofenestro"

#: kmag.cpp:178
msgid "Show the selection window on the screen"
msgstr "Montru la elektan fenestron sur la ekranon."

#: kmag.cpp:181
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "Klaku super tiun butonon por <b>zomi</b> la elektitan regionon."

#: kmag.cpp:185
msgid "Select the zoom factor."
msgstr "Elektu la grandigan faktoron."

#: kmag.cpp:186
msgid "Zoom factor"
msgstr "Grandiga faktoro"

#: kmag.cpp:189
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "Klaku super tiun butonon por <b>malzomi</b> la elektitan regionon."

#: kmag.cpp:197
msgid "&Refresh"
msgstr "&Refreŝigu"

#: kmag.cpp:199
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"Elektu la refreŝan rapidecon. Ju pli alta la valoro, des pli la procezila potenco (CPU) "
"bezonota."

#: kmag.cpp:200
msgid "Refresh rate"
msgstr "Refreŝa rapideco"

#: kmag.cpp:468
msgid "Save Zoomed Region"
msgstr "Sekurigu lupean regionon"

#: kmag.cpp:475
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"Ne eblis sekurigi la provizoran dosieron (antaŭ elŝuto al la retan dosieron "
"vi indikis)."

#: kmag.cpp:476 kmag.cpp:480 kmag.cpp:492
msgid "Error Writing File"
msgstr "Eraro dum skribo de dosiero"

#: kmag.cpp:479
msgid "Unable to upload file over the network."
msgstr "Ne eblis alŝuti la dosieron tra la reto."

#: kmag.cpp:482 kmag.cpp:494
#, c-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"Nuna bildo sekuriĝis al\n"
"%1"

#: kmag.cpp:491
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"Ne eblis sekurigi dosieron.  Bonvolu kontroli se vi havas permeson skribi "
"al la dosierujo."

#: kmag.cpp:511
msgid "Click to stop window update"
msgstr "Klaku por ĉesigi la fenestran ĝisdatiĝon."

#: kmag.cpp:514
msgid "Start"
msgstr "Komencigu"

#: kmag.cpp:515
msgid "Click to start window update"
msgstr ""
"Klaku por komencigi la fenestran "
"ĝisdatiĝadon."

