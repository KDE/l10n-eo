#: main.cpp:9
msgid "KDE Screenshot utility"
msgstr "KDEa Ekranfotilo"

#: main.cpp:13
msgid "KSnapshot"
msgstr "KEkranfoto"

#: ksnapshot.cpp:44
msgid "snapshot"
msgstr "Ekranfoto"

#: ksnapshot.cpp:130
msgid ""
"<qt><center><h1>KSnapshot</h1><p>Press the `Grab' button, the window under "
"the mouse cursor will be grabbed after the specified delay.</P><p><font "
"size=3>KSnapshot is copyright Richard Moore (rich@kde.org) and is released "
"under the LGPL license.</font></p><p><small>Version: "
"%1</small></p></center></qt>"
msgstr ""
"<qt><center><h1>KEkranfoto</h1><p>Premu la butonon `Fotu' kaj la fenestro "
"sub la musmontrilo estos fotata post la difinita prokrasto.</P><p><font "
"size=3>KEkranfoto estas kopirajita de Richard Moore (rich@kde.org) "
"kaj estas eldonita laŭ la LGPL-licenco.</font></p><p><small>Versio: "
"%1</small></p></center></qt>"

#: ksnapshot.cpp:167
msgid "&Filename:"
msgstr "&Dosiernomo:"

#: ksnapshot.cpp:186
msgid "&Browse..."
msgstr "&Rigardu..."

#: ksnapshot.cpp:195
msgid "&Delay:"
msgstr "&Prokrasto:"

#: ksnapshot.cpp:205
msgid "seconds."
msgstr "sekundoj."

#: ksnapshot.cpp:214
msgid "&Repeat:"
msgstr "&Ripeto:"

#: ksnapshot.cpp:225
msgid "times."
msgstr "fojoj."

#: ksnapshot.cpp:246
msgid "&Auto raise"
msgstr "&Aŭtomata malfonigo"

#: ksnapshot.cpp:247
msgid "Hide KSnapshot &window"
msgstr "Kaŝu la &fenestron de KEkranfoto"

#: ksnapshot.cpp:249
msgid "&Only grab the window containing the pointer"
msgstr "Fotu &nur la fenestron sub la musmontrilo"

#: ksnapshot.cpp:280
msgid "&Grab"
msgstr "&Fotu"

#: ksnapshot.cpp:347
msgid "Only local files are supported yet."
msgstr "Nur lokaj dosieroj estas subtenataj ĝis nun."

#: ksnapshot.cpp:503 ksnapshot.cpp:535
msgid "Error: Unable to save image"
msgstr "Eraro: N eblas sekurigi la bildon"

#: ksnapshot.cpp:504
msgid "Dismiss"
msgstr "Rezignu"

#: ksnapshot.cpp:506
msgid "Warning: This will overwrite an existing file"
msgstr "Averto: Tio anstataŭigos ekzistantan dosieron"

#: ksnapshot.cpp:507
msgid ""
"Are you sure you want to overwrite the existing file named\n"
"%1?"
msgstr ""
"Ĉu vi estas certa, ke vi volas anstataŭigi la ekzistantan dosieron\n"
"%1?"

#: ksnapshot.cpp:508
msgid "Overwrite"
msgstr "Anstataŭigu"

#: ksnapshot.cpp:511 ksnapshot.cpp:536
#, c-format
msgid ""
"KSnapshot was unable to save the image to\n"
"%1."
msgstr ""
"KEkranfoto ne povis sekurigi la bildon al\n"
"%1."

#: ksnapshot.cpp:551
msgid "KSnapshot preview"
msgstr "KEkranfoto - antaŭrigardo"

