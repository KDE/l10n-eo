#: main.cpp:39
msgid "KDE Icon Editor"
msgstr "KDEa Piktogramredaktilo"

#: main.cpp:43
msgid "Icon file(s) to open"
msgstr "Piktogramdosiero/j) malfermendaj"

#: main.cpp:96
msgid "KIconEdit"
msgstr "Piktogramredaktilo"

#: kiconedit.cpp:166 kiconeditslots.cpp:94 kiconeditslots.cpp:144
#: kiconeditslots.cpp:323
msgid ""
"The current file has been modified.\n"
"Do you want to save it?"
msgstr ""
"La nun dosiero estas ŝanĝita.\n"
"Ĉu vi volas sekurigi ĝin?"

#: kiconedit.cpp:271
msgid "New &Window"
msgstr "Nova &fenestro"

#: kiconedit.cpp:273
msgid ""
"New window\n"
"\n"
"Opens a new Icon Editor window."
msgstr ""
"Nova fenestro\n"
"\n"
"Malfermas novan piktogramredaktan fenestron."

#: kiconedit.cpp:281
msgid ""
"New\n"
"\n"
"Create a new icon, either from a template or by specifying the size"
msgstr ""
"Nova\n"
"\n"
"Kreas novan piktogramon el ŝablono aŭ kun difinita grandeco"

#: kiconedit.cpp:287
msgid ""
"Open\n"
"\n"
"Open an existing icon"
msgstr ""
"Malfermu\n"
"\n"
"Malfermas ekzistantan piktogramon"

#: kiconedit.cpp:301
msgid ""
"Save\n"
"\n"
"Save the current icon"
msgstr ""
"Konservu\n"
"\n"
"Konservas la piktogramon"

#: kiconedit.cpp:312
msgid ""
"Print\n"
"\n"
"Opens a print dialog to let you print the current icon."
msgstr ""
"Presu\n"
"\n"
"Malfermas presdialogon por presi la piktogramon."

#: kiconedit.cpp:326
msgid ""
"Cut\n"
"\n"
"Cut the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"Eltondu\n"
"\n"
"Eltondas la elektitan regionon el la piktogramo\n"
"\n"
"(Indiko: Vi povas elekti rektangulajn aŭ cirklajn regionojn)"

#: kiconedit.cpp:333
msgid ""
"Copy\n"
"\n"
"Copy the current selection out of the icon\n"
"\n"
"(Tip: You can make both rectangular and circular selections)"
msgstr ""
"Kopiu\n"
"\n"
"Kopias la elektitan regionon de la piktogramo\n"
"\n"
"(Indiko: Vi povas elekti rektangulajn aŭ cirklajn regionojn)"

#: kiconedit.cpp:340
msgid ""
"Paste\n"
"\n"
"Paste the contents of the clipboard into the current icon.\n"
"\n"
"If the contents are larger than the current icon you can paste them in a new "
"window.\n"
"\n"
"(Tip: Select \"Paste transparent pixels\" in the configuration dialog if you "
"also want to paste transparency.)"
msgstr ""
"Enmetu\n"
"\n"
"Enmetas la enhavon de la interdeponejo en la piktogramon.\n"
"\n"
"Se la enhavo estas pli granda ol la piktogramo vi povas enmeti ĝin en novan "
"fenestron.\n"
"\n"
"(Indiko: Elekktu \"Enmetu travideblajn punktoj\" en la agordodialogo se vi "
"volas ankaŭ travideble enmeti)"

#: kiconedit.cpp:349
msgid "Paste as &New"
msgstr "Enmetu kiel &nova"

#: kiconedit.cpp:352
msgid "Clea&r"
msgstr "&Malplenigu"

#: kiconedit.cpp:356
msgid "Rectangular Selection"
msgstr "Rektangula elekto"

#: kiconedit.cpp:358
msgid ""
"Select\n"
"\n"
"Select a rectangular section of the icon using the mouse."
msgstr ""
"Elektu\n"
"\n"
"Elektu rektangulan areon de la piktogramo per la muso."

#: kiconedit.cpp:363
msgid "Circular Selection"
msgstr "Cirkla elekto"

#: kiconedit.cpp:365
msgid ""
"Select\n"
"\n"
"Select a circular section of the icon using the mouse."
msgstr ""
"Elektu\n"
"\n"
"Elektu cirklan areon de la piktogramo per la muso.\n"
"\n"
"(Konsileto: Vi povas elekti kaj cirkle kaj rektangule)"

#: kiconedit.cpp:375
msgid "&Resize"
msgstr "Ŝanĝu &grandecon"

#: kiconedit.cpp:377
msgid ""
"Resize\n"
"\n"
"Smoothly resizes the icon while trying to preserve the contents"
msgstr ""
"Ŝanĝu grandecon\n"
"\n"
"Ŝanĝas la grandecon de l apiktograme provante konservi ĝioan enhavon"

#: kiconedit.cpp:382
msgid "&GrayScale"
msgstr "&Grizaj koloroj"

#: kiconedit.cpp:384
msgid ""
"Gray scale\n"
"\n"
"Gray scale the current icon.\n"
"(Warning: The result is likely to contain colors not in the icon palette"
msgstr ""
"Grizaj koloroj\n"
"\n"
"Grizigas la piktogramon.\n"
"(Averto: La rezulto verŝajne enhavos kolorojn, kiuj ne estas en la paletro"

#: kiconedit.cpp:395
msgid "1:1"
msgstr "1:1"

#: kiconedit.cpp:396
msgid "1:5"
msgstr "1:5"

#: kiconedit.cpp:397
msgid "1:10"
msgstr "1:10"

#: kiconedit.cpp:403
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one."
msgstr ""
"Pligrandigu\n"
"\n"
"Pligrandigu je unu."

#: kiconedit.cpp:408
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one."
msgstr ""
"Malpligrandigu\n"
"\n"
"Malpligrandigu je unue."

#: kiconedit.cpp:412
msgid "Zoom Factor"
msgstr "Grandigofaktoro"

#: kiconedit.cpp:423
msgid "Show &Grid"
msgstr "Montru &kradon"

#: kiconedit.cpp:429
msgid "Show &Drawing Tools"
msgstr "Montru &desegnilojn"

#: kiconedit.cpp:436
msgid "&Save Options"
msgstr "&Konservu agordon"

#: kiconedit.cpp:468
msgid "Find pixel"
msgstr "Trovu punkton"

#: kiconedit.cpp:473
msgid ""
"Find\n"
"\n"
"The color of the pixel clicked on will be the current draw color"
msgstr ""
"Trovu\n"
"\n"
"La koloro de la alklakita punkto estos elektata kiel desegnokoloro"

#: kiconedit.cpp:476
msgid "Freehand"
msgstr "Desegnilo"

#: kiconedit.cpp:481
msgid ""
"Free hand\n"
"\n"
"Draw non-linear lines"
msgstr ""
"Libermane\n"
"\n"
"Desegnas nerektajn liniojn"

#: kiconedit.cpp:484
msgid "Rectangle"
msgstr "Rektangulo"

#: kiconedit.cpp:489
msgid ""
"Rectangle\n"
"\n"
"Draw a rectangle"
msgstr ""
"Rektangulo\n"
"\n"
"Desegnas rektangulon"

#: kiconedit.cpp:492
msgid "Filled Rectangle"
msgstr "Plenigita rektangulo"

#: kiconedit.cpp:497
msgid ""
"Filled rectangle\n"
"\n"
"Draw a filled rectangle"
msgstr ""
"Plenigita rektangulo\n"
"\n"
"Pentras plenigitan rektangulon"

#: kiconedit.cpp:500
msgid "Circle"
msgstr "Cirklo"

#: kiconedit.cpp:505
msgid ""
"Circle\n"
"\n"
"Draw a circle"
msgstr ""
"Cirklo\n"
"\n"
"Desegnas cirklon"

#: kiconedit.cpp:508
msgid "Filled Circle"
msgstr "Plenigita cirklo"

#: kiconedit.cpp:513
msgid ""
"Filled circle\n"
"\n"
"Draw a filled circle"
msgstr ""
"Plenigita cirklo\n"
"\n"
"Pentras plenigitan cirklon"

#: kiconedit.cpp:516
msgid "Ellipse"
msgstr "Elipso"

#: kiconedit.cpp:521
msgid ""
"Ellipse\n"
"\n"
"Draw an ellipse"
msgstr ""
"Elipso\n"
"\n"
"Desegnas elipson"

#: kiconedit.cpp:524
msgid "Filled Ellipse"
msgstr "Plenigita elipso"

#: kiconedit.cpp:529
msgid ""
"Filled ellipse\n"
"\n"
"Draw a filled ellipse"
msgstr ""
"Plenigita elipso\n"
"\n"
"Pentras plenigitan elipson"

#: kiconedit.cpp:532
msgid "Spray"
msgstr "Ŝprucilo"

#: kiconedit.cpp:537
msgid ""
"Spray\n"
"\n"
"Draw scattered pixels in the current color"
msgstr ""
"Ŝprucilo\n"
"\n"
"Pentras disŝprucitajn punktojn de la elektita koloro"

#: kiconedit.cpp:540
msgid "Flood Fill"
msgstr "Fluplenigo"

#: kiconedit.cpp:545
msgid ""
"Flood fill\n"
"\n"
"Fill adjoining pixels with the same color with the current color"
msgstr ""
"Fluplenigo\n"
"\n"
"Plenigas kunestantajn punktojn de sama kolor per la elektita koloro"

#: kiconedit.cpp:548
msgid "Line"
msgstr "Linio"

#: kiconedit.cpp:553
msgid ""
"Line\n"
"\n"
"Draw a straight line vertically, horizontally or at 45 deg. angles"
msgstr ""
"Linio\n"
"\n"
"Desegnas rektan linion vertikale, horizontale aŭ en angulo de 45 gradoj"

#: kiconedit.cpp:556
msgid "Eraser (Transparent)"
msgstr "Estingilo (travidebla)"

#: kiconedit.cpp:561
msgid ""
"Erase\n"
"\n"
"Erase pixels. Set the pixels to be transparent\n"
"\n"
"(Tip: If you want to draw transparency with a different tool, first click on "
"\"Erase\" then on the tool you want to use)"
msgstr ""
"Estingu\n"
"\n"
"Estingas punktojn. Faras la punktojn travideblaj\n"
"\n"
"(Indiko: Se vi volas pentri travideble per alia ilo, unu alklaku \"Estingu\" "
"kaj poste elektu la uzendan ilon)"

#: kiconedit.cpp:589
msgid "Zoom out"
msgstr "Malpligrandigu"

#: kiconedit.cpp:592
msgid "Zoom in"
msgstr "Pligrandigu"

#: kiconedit.cpp:596
msgid "Toggle grid"
msgstr "Komutu kradon"

#: kiconedit.cpp:603
msgid "What is ...?"
msgstr "Kio estas...?"

#: kiconedit.cpp:619
msgid "System Colors"
msgstr "Sistemkoloroj"

#: kiconedit.cpp:645
msgid "Custom Colors"
msgstr "Propraj koloroj"

#: kiconedit.cpp:680
msgid ""
"Icon draw grid\n"
"\n"
"The icon grid is the area where you draw the icons.\n"
"You can zoom in and out using the magnifying glasses on the toolbar.\n"
"(Tip: Hold the magnify button down for a few seconds to zoom to a predefined "
"scale"
msgstr ""
"Piktograma desegnokrado\n"
"\n"
"Tio estas la regiono estas la areio kie vi desegnas la piktogramon.\n"
"Vi povas pligrandigi aŭ malpligrandigi ĝin per la lupeo el la illistelo.\n"
"(Indiko: Tenu la grandigbutonon premita por kelkaj sekundoj por elekti\n"
"grandigon el antaŭdifinita aro."

#: kiconedit.cpp:685
msgid ""
"Rulers\n"
"\n"
"This is a visual representation of the current cursor position"
msgstr ""
"Liniiloj\n"
"\n"
"Tio estas videbla prezento de la aktuala pozicio"

#: kiconedit.cpp:689
msgid ""
"Statusbar\n"
"\n"
"The statusbar gives information on the status of the current icon. The "
"fields are:\n"
"\n"
"\t- Cursor position\n"
"\t- Size\n"
"\t- Zoom factor\n"
"\t- Number of colors\n"
"\t- Application messages"
msgstr ""
"Statolistelo\n"
"\n"
"La statolistelo donas informojn pri la stato de la aktuala piktogramo. La "
"kampoj estas:\n"
"\n"
"\t- Pozico\n"
"\t- Grandeco\n"
"\t- Grandigfaktoro\n"
"\t- Kolornombro\n"
"\t- Aplikaĵomesaĝoj"

#: kiconedit.cpp:699
msgid ""
"Preview\n"
"\n"
"This is a 1:1 preview of the current icon"
msgstr ""
"Antaŭrigardo\n"
"\n"
"Tio estas antaŭrigardo en la vera grandeco de la piktogramo"

#: kiconedit.cpp:702
msgid ""
"System colors\n"
"\n"
"Here you can select colors from the KDE Icon Palette."
msgstr ""
"Sistemkoloroj\n"
"\n"
"Tie ĉi vi povas elekti kolorojn el la KDEa Piktogrampaletro."

#: kiconedit.cpp:705
msgid ""
"Custom colors\n"
"\n"
"Here you can build a palette of custom colors.\n"
"Double-click on a box to edit the color"
msgstr ""
"Propraj koloroj\n"
"\n"
"Tie ĉi vi povas fari propran paletron de koloroj.\n"
"Simple duklaku sur kesteto por redakti koloron."

#: kiconedit.cpp:711
msgid ""
"Zoom out\n"
"\n"
"Zoom out by one.\n"
"\n"
"(Tip: Hold the button down for a few seconds to zoom to a predefined scale"
msgstr ""
"Malpligrandigu\n"
"\n"
"Malpligrandigas je unu.\n"
"\n"
"(Indiko: Tenu la butonon premite kelkajn sekundojn por grandigi je "
"antaŭdifinita faktoro)"

#: kiconedit.cpp:715
msgid ""
"Zoom in\n"
"\n"
"Zoom in by one.\n"
"\n"
"(Tip: Hold the button down for a few seconds to zoom to a predefined scale"
msgstr ""
"Pligrandigu\n"
"\n"
"Pligrandigas je unu.\n"
"\n"
"(Indiko: Tenu la butonon premite kelkajn sekundojn por grandigi je "
"antaŭdifinita faktoro)"

#: kiconedit.cpp:719
msgid ""
"Toggle grid\n"
"\n"
"Toggles the grid in the icon edit grid on/off"
msgstr ""
"Komutu kradon\n"
"\n"
"En- aŭ elŝaltas la kradon en la regiono de la piktogramo"

#: kicongrid.cpp:77
msgid "width"
msgstr "larĝeco"

#: kicongrid.cpp:82
msgid "height"
msgstr "alteco"

#: kicongrid.cpp:717
msgid ""
"There was an error loading a blank image.\n"
msgstr ""
