#: kicongrid.cpp:823
msgid "All selected"
msgstr "Ĉio elektita"

#: kicongrid.cpp:834
msgid "Cleared"
msgstr "Malplenigita"

#: kicongrid.cpp:875
msgid "Selected area cut"
msgstr "Elektita regiono estas eltondita"

#: kicongrid.cpp:878
msgid "Selected area copied"
msgstr "Elektita regiono estas kopiita"

#: kicongrid.cpp:904
msgid ""
"The clipboard image is larger than the current image!\n"
"Paste as new image?"
msgstr ""
"La enmetota bildo estas pli granda ol la nuna bildo!\n"
"Ĉu enmeti kiel novan bildon?"

#: kicongrid.cpp:946 kicongrid.cpp:973
msgid "Done pasting"
msgstr "Enmto farita"

#: kicongrid.cpp:951 kicongrid.cpp:977
msgid ""
"Invalid pixmap data in clipboard!\n"
msgstr ""
"Nevalidaj datumoj en la interdeponejo!\n"

