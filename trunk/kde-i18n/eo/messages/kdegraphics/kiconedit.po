"*|All files (*)\n"
"*.xpm|XPM (*.xpm)\n"
"*.png|PNG (*.png)\n"
"*.jpg|JPEG files (*.jpg)\n"
"*.ico|Icon files (*.ico)\n"
msgstr ""
"*|Ĉiuj dosieroj (*)\n"
"*.xpm|XPM-dosieroj (*.xpm)\n"
"*.png|PNG-dosieroj (*.png)\n"
"*.jpg|JPEG-dosieroj (*.jpg)\n"
"*jpg|JPEG-dosieroj (*.jpg)\n"

#: kicon.cpp:158
