#: kchartBarConfigPage.cc:39
msgid "On &Top"
msgstr "&Supre"

#: kchartBarConfigPage.cc:43
msgid "In &Front"
msgstr "&Antaŭe"

#: kchartBarConfigPage.cc:65
msgid "X Axis Layout"
msgstr "X-aksa aranĝo"

#: kchartBarConfigPage.cc:68
msgid "&Distance between bars in percent of bar width"
msgstr "&Distanco inter traboj en procentoj de ilia larĝeco"

#: kchartBarSubTypeChartPage.cc:32 kchartWizardSelectChartSubTypePage.cc:41
msgid "Layer"
msgstr "Ebeno"

#: kchartBarSubTypeChartPage.cc:36
msgid "Percent"
