msgstr "ISODD(-7) donas True"

#: xml_doc.cc:750
msgid ""
"The ISEVEN() function returns True if the number is even. Otherwise returns "
"False."
msgstr ""
"La funkcio ISEVEN() donas True se la nombro estas para, aliokaze rezultas "
"False."

#: xml_doc.cc:751
msgid "ISEVEN(x)"
msgstr "ISEVEN( x )"

