msgid "COMPARE(\"KOffice\"; \"KOffice\"; true) returns 0"
msgstr "COMPACT(\"Oficejo\"; \"Oficejo\"; true) donas 0"

#: xml_doc.cc:1075
msgid "COMPARE(\"koffice\"; \"KOffice\"; true) returns 1"
msgstr "COMPACT(\"oficejo\"; \"Oficejo\"; true) donas 1"

#: xml_doc.cc:1076
msgid "COMPARE(\"kspread\"; \"KOffice\"; false) returns 1"
msgstr "COMPACT(\"Verkilo\"; \"Oficejo\"; false) donas 1"

#: xml_doc.cc:1079
msgid ""
"The EXACT() function returns True if these two strings are equal. Otherwise, "
"it returns False."
msgstr ""
"La funkcio EXACT() redonas Vera (True), se tiuj du signoĉenoj estas egalaj, "
"alikaze ĝi redonas Malvera (False)."

#: xml_doc.cc:1080
msgid "EXACT(string1;string2)"
msgstr "EXACT(ĉeno1; ĉeno2)"

#: xml_doc.cc:1081
msgid "EXACT(\"KOffice\";\"KOffice\") returns True"
msgstr "EXACT( \"Oficejo\"; \"Oficejo\" ) redonas Vera (True)"

#: xml_doc.cc:1082
msgid "EXACT(\"KSpread\";\"KOffice\") returns False"
msgstr "EXACT( \"Tabelkalulilo\"; \"Oficejo\" ) redonas Malvera (False)"

