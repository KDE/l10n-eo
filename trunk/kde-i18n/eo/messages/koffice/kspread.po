msgid "LEN(\"hello\") returns 5"
msgstr "LEN(\"Saluton\") redonas 7"

#: xml_doc.cc:1113
msgid "LEN(\"KSpread\") returns 7"
msgstr "LEN(\"ho\") redonas 2"

#: xml_doc.cc:1115
msgid "The TRIM() function returns text with only single spaces between words."
msgstr ""

#: xml_doc.cc:1116
msgid "TRIM(text)"
msgstr "TRIM(teksto)"

