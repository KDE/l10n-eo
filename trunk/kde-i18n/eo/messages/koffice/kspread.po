msgstr ""
"La funkcio count() redonas la nombron de entjeraj aŭ reelaj argumentoj trans"
"donitaj."

#: xml_doc.cc:335
msgid "count( Value;Value;Value... )"
msgstr "count(valoro; valoro; ...)"

#: xml_doc.cc:336
msgid "count(-5;\"kspread\";2) returns 2"
msgstr "count(-5;\"kspread\";2) redonas 2"

#: xml_doc.cc:337
msgid "count(5) returns 1"
msgstr "count(5) redonas 1"

