msgstr "Fontoĉeno"

#: xml_doc.cc:1102
msgid "Position"
msgstr "Pozicio"

#: xml_doc.cc:1103
msgid "Length"
msgstr "Longeco"

#: xml_doc.cc:1104
msgid ""
"The MID() function returns a substring that contains 'length' characters of "
"the string, starting at 'position' index."
msgstr ""
"La funkcio mid() redonas enan signoĉenon de donita longeco, komencante ĉe "
"donita pozicio."

#: xml_doc.cc:1105
msgid "MID(text;position;length)"
msgstr "MID(teksto; pozicio; longeco)"

#: xml_doc.cc:1106
msgid "MID(text;position)"
msgstr "MID( teksto; pozicio)"

#: xml_doc.cc:1107
msgid "MID(\"KOffice\";2;3) returns \"Off\""
msgstr "MID(\"Oficejo\";2;3) redonas \"fic\""

#: xml_doc.cc:1108
msgid "MID(\"KOffice\";2) returns \"Office\""
msgstr "MID( \"Oficejo\"; 2 ) redonas \"ficejo\""

