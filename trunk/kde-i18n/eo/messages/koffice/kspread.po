msgstr "Buleaj valoroj"

#: xml_doc.cc:572
msgid ""
"The AND() function returns True if all the values are true, otherwise returns"
" False"
msgstr "La funcio AND() donas True, se ĉiuj la valoroj estas veraj, alikaze False."

#: xml_doc.cc:573
msgid "AND( values; values; ... )"
msgstr "AND( valoro; valoro; ... )"

#: xml_doc.cc:574
msgid "AND(True;True;True) returns True"
msgstr "AND(True;True;True) estas True"

#: xml_doc.cc:575
msgid "AND(True;False) returns False"
msgstr "AND(True;False) estas False"

#: xml_doc.cc:581
msgid ""
"The OR() function returns True if at least one of the values is true, otherwi"
"se returns False"
msgstr ""
"La funkcio OR() donas True se almenaŭ unu el la valoroj estas True, alikaze "
"False"

#: xml_doc.cc:582
msgid "OR( values; values; ... )"
msgstr "OR(valoro; valoro; ...)"

