msgstr ""
"La funkcio NOR() estas True, se ĉiuj donitaj valoroj estas False, aliokaze F"
"alse."

#: xml_doc.cc:600
msgid "NOR( values; values; ... )"
msgstr "NOR(valoro; valoro; ...)"

#: xml_doc.cc:601
msgid "NOR(True;False;False) returns False"
msgstr "NOR(True;False;False) estas False"

#: xml_doc.cc:602
msgid "NOR(False;False) returns True"
msgstr "NOR(False;False) estas True"

#: xml_doc.cc:603
msgid "Boolean value"
msgstr "Bulea valoro"

