"eco. Se la donita longeco estas pli granda ol la longeco de la donita signoĉ"
"eno, ĝi redoniĝas entute."

#: xml_doc.cc:270
msgid "left( text; len )"
msgstr "left(teksto,longeco)"

#: xml_doc.cc:271
msgid "left( \"hello\"; 2 ) returns \"he\""
msgstr "left(\"Saluton\";4) redonas \"Salu\""

#: xml_doc.cc:272
msgid "left( \"kspread\"; 10 ) returns \"kspread\""
msgstr "left(\"Saluton\";15) redonas \"Saluton\""

#: xml_doc.cc:274
msgid "Count of repetitions"
msgstr "Nombro da ripetoj"

#: xml_doc.cc:275
msgid ""
"The REPT() function repeats the first parameter as often as told by the secon"
"d parameter."
msgstr "La funkcio REPT() ripetas la donitan ĉenon laŭ la donita ofteco."

#: xml_doc.cc:276
msgid "REPT( text; count )"
msgstr "REPT(teksto,nombro)"

#: xml_doc.cc:277
msgid "REPT( \"kspread\"; 3 ) returns \"kspreadkspreadkspread\""
msgstr "REPT(\"vi\"; 2) redonas \"vivi\""

#: xml_doc.cc:279
msgid "The upper() function converts a string to upper case."
msgstr "La funkcio upper() majuskligas signoĉenon."

#: xml_doc.cc:280
msgid "upper( text )"
msgstr "upper(teksto)"

#: xml_doc.cc:281
msgid "upper( \"hello\" ) returns \"HELLO\""
msgstr "upper(\"Saluton\") redonas \"SALUTON\""

#: xml_doc.cc:282
msgid "upper( \"HELLO\" ) returns \"HELLO\""
msgstr "upper(\"SALUTON\" redonas \"SALUTON\""

#: xml_doc.cc:284
msgid "The lower() function converts a string to lower case."
msgstr "La funkcio lower() minuskligas signoĉenon."

#: xml_doc.cc:285
msgid "lower( text )"
msgstr "lower(teksto)"

#: xml_doc.cc:286
msgid "lower( \"hello\" ) returns \"hello\""
msgstr "lower(\"Saluton\") redonas \"saluton\""

#: xml_doc.cc:287
msgid "lower( \"HELLO\" ) returns \"hello\""
msgstr "lower(\"SALUTON\") redonas \"saluton\""

