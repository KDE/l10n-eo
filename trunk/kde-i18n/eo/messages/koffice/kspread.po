msgid "TOGGLE(\"HELLO\") returns \"hello\""
msgstr "TOGGLE(\"SALUTON\") redonas \"saluton\""

#: xml_doc.cc:1165
msgid "TOGGLE(\"HeLlO\") returns \"hElLo\""
msgstr "TOGGLE(\"SaLUtoN\") redonas \"sAluTOn\""

#: xml_doc.cc:1167
msgid "The CLEAN() function removes every non-printable character from the string"
msgstr ""

#: xml_doc.cc:1168
msgid "CLEAN(text)"
msgstr "CLEAN(teksto)"

#: xml_doc.cc:1169
msgid "CLEAN(AsciiToChar(7) + \"HELLO\") returns \"HELLO\""
msgstr "CLEAN(AsciiToChar(7) + \"Saluton\") redonas \"Saluton\""

#: xml_doc.cc:1171
msgid "The SLEEK() function removes all spaces from the string."
msgstr ""

#: xml_doc.cc:1172
msgid "SLEEK(text)"
msgstr "SLEEK(teksto)"

