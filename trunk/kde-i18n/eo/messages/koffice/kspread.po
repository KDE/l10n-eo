msgid "T(\"KOffice\") returns \"KOffice\""
msgstr "T(\"Oficejo\") donas \"Oficejo\""

#: xml_doc.cc:1059
msgid "T(1.2) returns \"\" (empty text)"
msgstr "T(1.2) donas \"\" (malplena teksto)"

