msgstr "ISLOGIC(12) donas False"

#: xml_doc.cc:720
msgid ""
"The ISNUM() function returns True if the parameter is a numerical value. "
"Otherwise it returns False."
msgstr ""
"La funkcio ISNUM() donas True, se la argmuento estas nombra valoro alikaze "
"False."

#: xml_doc.cc:721
msgid "ISNUM(x)"
msgstr "ISNUM(x)"

#: xml_doc.cc:722
msgid "ISNUM(12) returns True"
msgstr "ISNUM(12) donas True"

#: xml_doc.cc:723
msgid "ISNUM(hello) returns False"
msgstr "ISNUM(\"saluton\") donas False"

#: xml_doc.cc:725
msgid ""
"The ISTIME() function returns True if the parameter is a time value. "
"Otherwise it returns False."
msgstr ""
"La funkcio ISTIME() donas True, se la argmuento estas tempovaloro alikaze "
"False."

#: xml_doc.cc:726
msgid "ISTIME(x)"
msgstr "ISTIME(x)"

#: xml_doc.cc:727
msgid "ISTIME(\"12:05\") returns True"
msgstr "ISTIME(\"12:05\") donas True"

#: xml_doc.cc:728
msgid "ISTIME(hello) returns False"
msgstr "ISTIME(\"saluton\") donas False"

#: xml_doc.cc:730
msgid ""
"The ISDATE() function returns True if the parameter is a date value. "
"Otherwise it returns False"
msgstr "La funkcio ISDATA() donas True, se la argmuento estas dato aliokaze False."

#: xml_doc.cc:731
msgid "ISDATE(x)"
msgstr "ISDATE(x)"

#: xml_doc.cc:732
msgid "ISDATE(\"2000-2-2\") returns True"
msgstr "ISDATA(\"200-2-2\") donas True"

#: xml_doc.cc:733
msgid "ISDATE(hello) returns False"
msgstr "ISDATE(\"saluton\") donas False"

#: xml_doc.cc:735
