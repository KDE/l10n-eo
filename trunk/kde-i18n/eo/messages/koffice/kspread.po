msgstr "INV(valoro)"

#: xml_doc.cc:326
msgid "INV(-5) equals 5"
msgstr "INV(-5) donas 5"

#: xml_doc.cc:327
msgid "INV(5) equals -5"
msgstr "INV(5) donas -5"

#: xml_doc.cc:328
msgid "INV(0) equals 0"
msgstr "INV(0) donas 0"

