msgid "TEXT(1234.56) returns \"1234.56\""
msgstr "TEXT(1234.56) donas \"1234.56\""

#: xml_doc.cc:1064
msgid "TEXT(\"KSpread\") returns \"KSpread\""
msgstr "TEXT(\"Saluton\") redonas \"Saluton\""

