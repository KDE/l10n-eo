msgstr "DEGREE(1) estas 57.29"

#: xml_doc.cc:1268
msgid "Angle (degrees)"
msgstr "ANGLE(gradoj)"

#: xml_doc.cc:1269
msgid "This function transforms a degree angle to a radian angle."
msgstr "Tiu funkcio transformas gradan angulon al radia angulo."

#: xml_doc.cc:1270
msgid "RADIAN(Float)"
msgstr "RADIAN(reelo)"

