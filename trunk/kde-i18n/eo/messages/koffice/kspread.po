msgstr "sign(0) egalas al 0"

#: xml_doc.cc:322
msgid "sign(-5) equals -1"
msgstr "sign(-5) egalas al -1"

#: xml_doc.cc:324
msgid "This function multiplies each value by -1"
msgstr "Tiu funkcio multiplikas ĉiun valoron per -1"

#: xml_doc.cc:325
