msgid "SLEEK(\"This is   some  text \") returns \"Thisissometext\""
msgstr "SLEEK(\"Tio estas teksto\") redonas \"Tioestasteksto\""

#: xml_doc.cc:1175
msgid "The UPPER() function converts a string to upper case."
msgstr "La funkcio upper() majuskligas signoĉenon."

#: xml_doc.cc:1176
msgid "UPPER(text)"
msgstr "UPPER(teksto)"

#: xml_doc.cc:1177
msgid "UPPER(\"hello\") returns \"HELLO\""
msgstr "UPPER(\"Saluton\") redonas \"SALUTON\""

#: xml_doc.cc:1178
msgid "UPPER(\"HELLO\") returns \"HELLO\""
msgstr "UPPER(\"SALUTON\" redonas \"SALUTON\""

#: xml_doc.cc:1180
msgid "The LOWER() function converts a string to lower case."
msgstr "La funkcio lower() minuskligas signoĉenon."

#: xml_doc.cc:1181
msgid "LOWER(text)"
msgstr "LOWER(teksto)"

#: xml_doc.cc:1182
msgid "LOWER(\"hello\") returns \"hello\""
msgstr "LOWER(\"Saluton\") redonas \"saluton\""

#: xml_doc.cc:1183
msgid "LOWER(\"HELLO\") returns \"hello\""
msgstr "LOWER(\"SALUTON\") redonas \"saluton\""

#: xml_doc.cc:1184
msgid "Character Code"
msgstr ""

#: xml_doc.cc:1185
msgid "The CHAR() function returns the character specified by a number."
msgstr ""

#: xml_doc.cc:1186
msgid "CHAR(code)"
msgstr ""

#: xml_doc.cc:1187
msgid "CHAR(65) returns \"A\""
msgstr "CHAR(65) donas \"A\""

#: xml_doc.cc:1189
msgid ""
"The CODE() function returns a numeric code for the first character in a text "
"string."
msgstr ""

#: xml_doc.cc:1190
msgid "CODE(text)"
msgstr "CODE(teksto)"

#: xml_doc.cc:1191
msgid "CODE(\"KDE\") returns 75"
msgstr "CODE(\"KDE\") donas 75"

