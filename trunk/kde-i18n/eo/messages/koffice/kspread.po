msgstr "Logiko"

#: xml_doc.cc:567 xml_doc.cc:568 xml_doc.cc:569 xml_doc.cc:570 xml_doc.cc:571
#: xml_doc.cc:576 xml_doc.cc:577 xml_doc.cc:578 xml_doc.cc:579 xml_doc.cc:580
