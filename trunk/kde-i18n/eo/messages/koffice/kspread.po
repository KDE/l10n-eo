msgid "SUMPRODUCT(array1;array2)"
msgstr "SUMPRODUCT(areo1;areo2)"

#: xml_doc.cc:665
msgid "SUMPRODUCT(A1:A2;B1:B2) with A1=2 A2=5 and B1=3 B2=5 returns 31"
msgstr "SUMPRODUCT(A1:A2;B1:B2) kun A1=2 A2=5 and B1=3 B2=5 redonas 31"

#: xml_doc.cc:668
msgid ""
"The SUMX2PY2() function (SUM(X^2+Y^2)) returns the sum of square of these val"
"ues. The number of value should be equal between two arrays. Otherwise this f"
"unction returns Err."
msgstr ""
"La funkcio SUMX2PY2() (SUM(X^2+Y^2)) redonas la sumon de la kvadratoj de la v"
"aloroj.La nombroj de valoroj de la du areoj estu egalaj. Alikaze redoniĝos E"
"rr."

