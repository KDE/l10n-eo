msgstr ""
"La funkcio ODD() donas la nombron rondigitan supren al la plej proksima nepar"
"a entjero."

#: xml_doc.cc:308
msgid "ODD( value  )"
msgstr "ODD(valoro)"

#: xml_doc.cc:309
msgid "ODD(1.2) returns 3"
msgstr "ODD(1.2) donas 3"

#: xml_doc.cc:310
msgid "ODD(2) returns 3"
msgstr "ODD(2) donas 3"

