msgid "Configure the currently selected header or footer."
msgstr "Ŝanĝu la nun elektitaj kapo aŭ piednoto."

#: kwview.cc:992
msgid "Inline Frame"
msgstr "Ena kadro"

#: kwview.cc:995
msgid "Convert current frame to an inline frame."
msgstr "Ŝanĝu nunan kadron al enmetitan kadron."

#: kwview.cc:996
msgid ""
"Convert the current frame to an inline frame."
"<br>"
"<br>Place the inline frame within the text at the point nearest to the "
"frames current position."
msgstr ""
"Ŝanĝu nunan kadron al enmetitan kadron. "
"<br> "
"<br>Enmetas la enan kadron je tiu ĉi posicio en la teksto, kio estas plej "
"proksime al la nuna posicio de la kadro"

#: kwview.cc:998
msgid "Open Link"
msgstr "Malfermu ligon"

#: kwview.cc:1001
msgid "Open the link with the appropriate application."
msgstr "Malfermas la ligon kun la koncerna programo."

#: kwview.cc:1002
msgid ""
"Open the link with the appropriate application."
"<br>"
"<br>Web addresses are opened in a browser."
"<br>Email addresses begin a new message addressed to the link."
"<br>File links are opened by the appropriate viewer or editor."
msgstr ""
"Malfermas la ligon kun la koncerna programo. "
"<br> "
"<br>Interetaj adresoj estas malfermitaj en navigilo. "
"<br>Retpoŝtadresoj komencas novan mesaĝon "
"<br>Dosierligoj estas malfermitaj kun koncerna rigardilo aŭ redaktilo."

#: kwview.cc:1004
msgid "Change Link..."
msgstr "Ŝanĝu ligon..."

#: kwview.cc:1007
msgid "Change the content of the currently selected link."
msgstr "Ŝanĝu la enhavon de la nun elektita ligo."

#: kwview.cc:1008
msgid "Change the details of the currently selected link."
msgstr "Ŝanĝu atributojn de nun elektita ligo."

#: kwview.cc:1011
msgid "Show Doc Structure"
msgstr "Montru dokumentstrukturon"

