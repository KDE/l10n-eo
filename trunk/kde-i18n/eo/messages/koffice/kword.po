msgid ""
"Change autocorrection options including:"
"<p> "
"<UL>"
"<LI>"
"<P>exceptions to autocorrection</P> "
"<LI>"
"<P>add/remove autocorrection replacement text</P> "
"<LI><P>and basic autocorrection options</P>."
msgstr ""
"Ŝanĝu agordon de aŭtokorektado, kun: "
"<p> "
"<UL> "
"<LI> "
"<P>esceptoj de aŭtokorektado</P> "
"<LI> "
"<P>aldonu/forigu aŭtokorektado-anstataŭigo-tekston</P> "
"<LI> <P>kaj ĝeneralaj opcioj de aŭtokorektado</P>."

#: kwview.cc:960
msgid "Custom &Variables..."
msgstr "&Propraj variabloj..."

#: kwview.cc:964
msgid "&Personal Expressions..."
msgstr "&Personaj esprimoj..."

#: kwview.cc:967
msgid "Add or change one or more personal expressions."
msgstr "Aldonu aŭ ŝanĝu unu aŭ pli personajn esprimojn."

#: kwview.cc:968
msgid ""
"Add or change one or more personal expressions."
"<p>"
"Personal expressions are a way to quickly insert commonly used phrases or "
"text into your document."
msgstr ""
"Add or change one or more personal expressions. "
"<p>"
" Personaj esprimoj estas bona ideo por rapide enmeti ofte uzitajn frazojn "
"kaj tekstojn en vian dokumenton."

#: kwview.cc:970
msgid "Change Case..."
msgstr "Ŝanĝu usklecon..."

#: kwview.cc:973
msgid "Alter the capitalization of selected text."
msgstr "Ŝanĝu usklecon de elektita teksto."

#: kwview.cc:974
msgid ""
"Alter the capitalization of selected text to one of five pre-defined "
"patterns."
"<p>You can also switch all letters from uppercase to lower case and from "
"lower case to upper case in one move."
msgstr ""
"Ŝanĝu usklecon de elektita teksto al unu de kvin antaŭdifinitaj "
"ŝablonoj. "
"<p>Vi same povas majuskligi aux minuskligi ĉiujn literojn en unu paŝo."

#: kwview.cc:980
msgid "Change Picture..."
msgstr "Ŝanĝu bildon..."

#: kwview.cc:983
msgid "Change the picture in the currently selected frame."
msgstr "Ŝanĝas la bildon en la nune elektita kadro."

#: kwview.cc:984
msgid ""
"You can specify a different picture in the current frame."
"<br>"
"<br>KWord automatically resizes the new picture to fit within the old frame."
msgstr ""
"Vi povas doni alian bildon en la nunan kadron."
"<br> "
"<br>Verkilo aŭtomate alĝustigas la novan bildon por havi la saman "
"grandecon kiel la malnova kadro."

#: kwview.cc:986
msgid "Configure Header/Footer..."
msgstr "Agordu kapon/piednotojn..."

