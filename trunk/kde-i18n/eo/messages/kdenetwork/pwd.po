msgstr "Protokolfenestro"

#: pwswidget.cpp:88
msgid "Delete Server"
msgstr "Forigu servilon"

#: pwswidget.cpp:90
msgid "Add Server"
msgstr "Aldonu servilon"

#: kfileio.cpp:25
msgid "File I/O Error"
msgstr "Dosiero-En/El-Eraro"

#: kfileio.cpp:26
msgid "Ok"
msgstr "Bone"

#: kfileio.cpp:45
#, c-format
msgid ""
"The specified file does not exist:\n"
"%s"
msgstr ""
"La indikita dosiero ne ekzistas:\n"
"%s"

#: kfileio.cpp:52
#, c-format
msgid ""
"This is a directory and not a file:\n"
"%s"
msgstr ""
"Tio ĉi estas dosierujo kaj ne dosiero:\n"
"%s"

#: kfileio.cpp:59
#, c-format
msgid ""
"You do not have read permissions to the file:\n"
"%s"
msgstr ""
"Vi ne havas legpermeson por la dosiero:\n"
"%s"

#: kfileio.cpp:70
#, c-format
msgid ""
"Could not read file:\n"
"%s"
msgstr ""
"Ne eblis legi la dosieron:\n"
"%s"

#: kfileio.cpp:73
#, c-format
msgid ""
"Could not open file:\n"
"%s"
msgstr ""
"Ne eblis malfermi la dosieron:\n"
"%s"

#: kfileio.cpp:76
#, c-format
msgid ""
"Error while reading file:\n"
"%s"
msgstr ""
"Eraro dum legado de dosiero:\n"
"%s"

#: kfileio.cpp:93
#, c-format
msgid "Could only read %u bytes of %u."
msgstr "NE eblis legi %u bitokojn de %u"

#: kfileio.cpp:122
#, c-format
msgid ""
"File %s exists.\n"
"Do you want to replace it ?"
msgstr ""
"Dosiero %s ekzistas.\n"
"Ĉu vi volas anstataŭigi ĝin?"

#: kfileio.cpp:125 kfileio.cpp:143
msgid "&Ok"
msgstr "&Bone"

#: kfileio.cpp:142
#, c-format
msgid ""
"Failed to make a backup copy of %s.\n"
"Continue anyway ?"
msgstr ""
"Malsukcesis fari sekurkopion de %s.\n"
"Ĉu tamen daŭrigi?"

#: kfileio.cpp:154 kfileio.cpp:172
#, c-format
msgid ""
"Could not write to file:\n"
"%s"
msgstr ""
"NE eblis skribi al dosiero:\n"
"%s"

#: kfileio.cpp:157
#, c-format
msgid ""
"Could not open file for writing:\n"
"%s"
msgstr ""
"Ne eblis malfermi la dosieron por skribi:\n"
"%s"

#: kfileio.cpp:161
#, c-format
msgid ""
"Error while writing file:\n"
"%s"
msgstr ""
"Eraro dum skribado de dosiero:\n"
"%s"

#: kfileio.cpp:178
#, c-format
msgid "Could only write %d bytes of %d."
msgstr "Povis skribi nur %d bitkojn de %d"

#: addwizard.cpp:41
msgid "Server Name"
msgstr "Servilonomo"

#: addwizard.cpp:45
msgid "Server's Public Directory"
msgstr "Publika dosierujo de la servilo"

#: addwizard.cpp:49
msgid "Server's Port Number"
msgstr "Pordnumero de la servilo"

#: addwizard.cpp:53
msgid "Finish"
msgstr "Finu"

#: addwizard.cpp:86
msgid ""
"Enter a name for this server.\n"
"This name is used to identify\n"
"this configuration."
msgstr ""
"Donu nomon por tiu ĉi servilo.\n"
"La nomo estas uzata por identigi\n"
"tiun ĉi agordon."

#: addwizard.cpp:93
msgid "Name:"
msgstr "Nomo:"

#: addwizard.cpp:97
msgid "MyServer"
msgstr "Mia servilo"

#: addwizard.cpp:123 addwizard.cpp:136 addwizard.cpp:196
msgid "PWS: Error"
msgstr "PWS: Eraro"

#: addwizard.cpp:124
msgid ""
"Nothing is not a name.\n"
"Please choose one"
msgstr ""
"'Nenio' ne estas nomo.\n"
"Bonvolu doni iun"

#: addwizard.cpp:137
msgid ""
"That server name already exists.\n"
"Please choose a new one"
msgstr ""
"La servilnomo jam ekzistas.\n"
"Bonvolu elekti alian"

#: addwizard.cpp:155
msgid ""
"Enter the name of the directory where\n"
"the web pages are located.\n"
msgstr ""
"Donu la nomon de la dosierujo, kie\n"
"la TTT-paĝoj troviĝas.\n"

#: addwizard.cpp:161
msgid "Directory:"
msgstr "Dosierujo:"

#: addwizard.cpp:197
msgid ""
"That directory doesn't exist.\n"
"Do you want me to create it?"
msgstr ""
"Tiu dosierujo ne ekzistas.\n"
"Ĉu mi kreu ĝin?"

#: addwizard.cpp:228
msgid ""
"Enter a port for this server.\n"
"The port is part of the URL for the server\n"
"for example, in http://my.server.org:800\n"
"800 is the port number.\n"
"The standard port for web servers is 80\n"
"To use a port number under 1024 you will \n"
"need the root password."
msgstr ""
"Donu prodon por tiu servilo.\n"
"La pordo estas parto de la URL por tiu servilo\n"
"ekz. en http://mia.servilo.org:800\n"
"la 800 estas la prodnumero.\n"
"La norma pordo por TTT-servoj estas 80\n"
"Por uzi pordonumeron sub 1024 vi bezonas la"
"sistemeestro-pasvorton."

#: addwizard.cpp:240
msgid "Port Number:"
msgstr "Pordnumero:"

#: addwizard.cpp:273
msgid ""
"You have finished configuring\n"
"the web server.\n"
"Press Finish to save it, Cancel to\n"
"forget about it.\n"
msgstr ""
"Vi finis la agordon de la TTT-servo.\n"
"Premu 'Finu' por sekurigi ĝin, 'Rezignu' por\n"
"forgesi ĝin.\n"

