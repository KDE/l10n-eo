#: kpgp.cpp:157 kpgp.cpp:219
msgid ""
"Couldn't find PGP executable.\n"
"Please check your PATH is set correctly."
msgstr ""
"Ne eblis trovi la PGP-programon.\n"
"Bonvolu kontroli, ĉu via variablo PATH estas ĝusta."

#: kpgp.cpp:236
msgid "The pass phrase is missing."
msgstr "La pasfrazo mankas."

#: kpgp.cpp:318
msgid ""
"Could not find the public keys for the\n"
"recipients of this mail.\n"
"Message will not be encrypted."
msgstr ""
"Ne eblis trovi la publikan ŝlosilon por la\n"
"ricecvontoj de tiu retpoŝto.\n"
"La mesaĝo ne estos ĉifrita."

#: kpgp.cpp:321 kpgp.cpp:345 kpgp.cpp:365 kpgp.cpp:382 kpgp.cpp:401
msgid "PGP Warning"
msgstr "PGP-Averto"

#: kpgp.cpp:321 kpgp.cpp:346
msgid "C&ontinue"
msgstr "&Daŭrigu"

#: kpgp.cpp:327
msgid "Could not find the public keys for\n"
msgstr "Ne eblis trovi la publikan ŝlosilon por\n"

#: kpgp.cpp:338
msgid "These persons will not be able to decrypt the message\n"
msgstr "Tiuj personoj ne povos malĉifri la mesaĝon\n"

#: kpgp.cpp:340
msgid "This person will not be able to decrypt the message\n"
msgstr "Tiu persono ne povos malĉifri la mesagon\n"

#: kpgp.cpp:361
msgid ""
"You just entered an invalid passphrase.\n"
"Do you want to try again, continue and\n"
"leave the message unsigned, or cancel sending the message?"
msgstr ""
"Vi ĵus entajpis nevalidan pasfrazon.\n"
"Ĉu vi volas reprovi, daŭrigi kaj lasi\n"
"la mesaĝon neĉifrita, aŭ rezigni pri la sendado?"

#: kpgp.cpp:366
msgid "&Retry"
msgstr "&Reprovu"

#: kpgp.cpp:366
msgid "Send &unsigned"
msgstr "Sendu &neĉifrita"

#: kpgp.cpp:378
msgid ""
"Do you want to encrypt anyway, leave the\n"
"message as is, or cancel the message?"
msgstr ""
"Ĉu vi volas ĉifri tamen, lasi la\n"
"mesaĝon kiel ĝi estas, aŭ rezigni pri ĝi?"

#: kpgp.cpp:383
msgid "&Encrypt"
msgstr "Ĉ&ifru"

#: kpgp.cpp:383
msgid "&Send unencrypted"
msgstr "&Sendu neĉifrita"

#: kpgp.cpp:397
msgid ""
"Do you want to leave the message as is,\n"
"or cancel the message?"
msgstr ""
"Ĉu vi volas lasi la mesaĝon kiel ĝi estas\n"
"aŭ rezigni pri ĝi?"

#: kpgp.cpp:402
msgid "&Send as is"
msgstr "&Sendu tiel"

#: kpgp.cpp:622
msgid ""
"Sorry, but this feature\n"
"is still missing"
msgstr ""
"Pardonu, sed tiu funkcio ankoraŭ\n"
"mankas"

#: kpgp.cpp:905 kpgp.cpp:943
msgid "OpenPGP Security Check"
msgstr "Sekureckontrolo de OpenPGP"

#: kpgp.cpp:919
msgid "Please enter your OpenPGP passphrase"
msgstr "Bonvolu doni vian pasfrazon por OpenPGP"

#: kpgp.cpp:921
msgid ""
"Please enter the OpenPGP passphrase for\n"
"\"%1\""
msgstr ""
"Bonvolu doni la pasfrazon de OpenPGP por\n"
"\"%1\""

#: kpgp.cpp:962
msgid "Select key"
msgstr "Elektu ŝlosilon"

#: kpgp.cpp:975
msgid "Please select the public key to insert"
msgstr "Bonvolu elekti la enmetendan publikan ŝlosilon"

#: kpgp.cpp:1031
msgid ""
"<qt>Please check if encryption really works before you start using it "
"seriously. Also note that attachments are not encrypted by the Pgp "
"module.</qt>"
msgstr ""
"<qt>Bonvolu kontroli, ĉu la ĉifrado fakte funkcias antaŭ kiam vi komencas "
"uzi ĝin serioze. Krome notu, ke kunsendaĵoj ne estas ĉifrataj de la PGP-modulo.</qt>"

#: kpgp.cpp:1041
msgid "Keep passphrase in memory"
msgstr "Tenu pasfrazon en la memoro"

#: kpgp.cpp:1042
msgid "Always encrypt to self"
msgstr "Ĉiam ĉifru ankaŭ por mi mem"

#: kpgp.cpp:1044
msgid "Show ciphered text after composing"
msgstr "Montru ĉifritan tekston por pretigo"

#: kpgp.cpp:1050
msgid "Encryption tool"
msgstr "Ĉifrilo"

#: kpgp.cpp:1055
msgid "Auto-detect"
msgstr "Aŭtomata rekono"

#: kpgp.cpp:1059
msgid "GPG - Gnu Privacy Guard"
msgstr "GPG - GNUa Privateco-Gardilo"

#: kpgp.cpp:1063
msgid "PGP Version 2.x"
msgstr "PGP versio 2.x"

#: kpgp.cpp:1067
msgid "PGP Version 5.x"
msgstr "PGP versio 5.x"

#: kpgp.cpp:1071
msgid "PGP Version 6.x"
msgstr "PGP versio 6.x"

#: kpgp.cpp:1139
msgid "PGP Key Selection"
msgstr "PGP Ŝlosilelekto"

#: kpgp.cpp:1145
msgid "Select public key for recipient \"%1\""
msgstr "Elektu publikan ŝlosilon por ricevonto \"%1\""

#: kpgp.cpp:1190
msgid "OpenPGP Information"
msgstr "Informo pri OpenPGP"

#: kpgp.cpp:1196
msgid "Result of the last encryption / sign operation:"
msgstr "Rezulto de la lasta ĉifrado / subskribo:"

#: kpgpbase.cpp:565 kpgpbase.cpp:941
msgid "Bad pass Phrase; couldn't sign"
msgstr "Malbona pasfrazo; ne povis subskribi"

#: kpgpbase.cpp:610
msgid "error running gpg"
msgstr "Eraro ĉe lanĉo de GPG"

#: kpgpbase.cpp:628 kpgpbase.cpp:1005 kpgpbase.cpp:1329 kpgpbase.cpp:1522
msgid "Bad pass Phrase; couldn't decrypt"
msgstr "Malbona pasfrazo; ne povus malĉifri"

#: kpgpbase.cpp:648
msgid "Do not have the public key for this message"
msgstr "Ne troviĝis la publika ŝlosilo por tiu mesaĝo"

#: kpgpbase.cpp:677 kpgpbase.cpp:1044 kpgpbase.cpp:1547
msgid "unknown key ID "
msgstr "nekonata ŝlosilo-identigilo"

#: kpgpbase.cpp:712
msgid "??? (file ~/.gnupg/pubring.gpg not found)"
msgstr "??? (dosiero ~/.gnupg/pubring.gpg ne troviĝis)"

#: kpgpbase.cpp:949
msgid ""
"PGP error occured. Please check\n"
"your PGP setup and key rings."
msgstr ""
"Okazis PGP-eraro. Bonvolu kontroli\n"
"vian PGP-agordon kaj ŝlosilaron."

#: kpgpbase.cpp:988 kpgpbase.cpp:1500 kpgpbase.cpp:1677
msgid "error running pgp"
msgstr "eraro ĉe lanĉo de PGP"

#: kpgpbase.cpp:1016 kpgpbase.cpp:1340 kpgpbase.cpp:1530
msgid "Do not have the secret key for this message"
msgstr "Ne havas la sekretan ŝlosilon por tiu mesaĝo"

#: kpgpbase.cpp:1064
msgid "??? (file ~/.pgp/pubring.pgp not found)"
msgstr "??? (dosiero ~/.pgp/pubring.pgp ne troviĝis)"

#: kpgpbase.cpp:1246
msgid "The passphrase you entered is invalid."
msgstr "La pasfrazo tajpita de vi ne estas valida."

#: kpgpbase.cpp:1272
msgid ""
"The key(s) you want to encrypt your message\n"
"to are not trusted. No encryption done."
msgstr ""
"La ŝlosilo(j), per kiu(j) vi volas ĉifri vian mesaĝon\n"
"ne estas fidataj. Ĉifrado ne okazas."

#: kpgpbase.cpp:1275
msgid ""
"The following key(s) are not trusted:\n"
"%1\n"
"They will not be able to decrypt the message"
msgstr ""
"La sekva(j) ŝlosilo(j) ne estas fidataj:\n"
"%1\n"
"Ili ne povos malĉifri la mesaĝon"

#: kpgpbase.cpp:1571
msgid "??? (file ~/.pgp/pubring.pkr not found)"
msgstr "??? (dosiero ~/.pgp/pubring.pkr ne troviĝis)"

