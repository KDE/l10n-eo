#: kpgp.cpp:177
msgid ""
"Couldn't find PGP executable.\n"
"Please check your PATH is set correctly."
msgstr ""
"Ne eblis trovi la PGP-programon.\n"
"Bonvolu kontroli, ĉu via variablo PATH estas ĝusta."

#: kpgp.cpp:189
msgid "OpenPGP Security Check"
msgstr "Sekureckontrolo de OpenPGP"

#: kpgp.cpp:197
msgid "Passphrase is too long, it must contain less than 1024 characters."
msgstr "Pasfrazo estas tro longa, ĉi devas enhavi malpli ol 1024 signoj."

#: kpgp.cpp:199
msgid "Out of memory."
msgstr "Memoro ne sufiĉas."

#: kpgp.cpp:269
msgid ""
"You just entered an invalid passphrase.\n"
"Do you want to try again, or cancel and view the message undecrypted?"
msgstr ""
"Vi ĵus entajpis nevalidan pasfrazon.\n"
"Ĉu vi volas reprovi aŭ rezigni kaj rigardi la ĉifritan mesaĝon?"

#: kpgp.cpp:272 kpgp.cpp:365 kpgp.cpp:383 kpgp.cpp:411 kpgp.cpp:441
#: kpgp.cpp:460 kpgp.cpp:484
msgid "PGP Warning"
msgstr "PGP-Averto"

#: kpgp.cpp:272 kpgp.cpp:412
msgid "&Retry"
msgstr "&Reprovu"

#: kpgp.cpp:356
msgid ""
"You didn't select an encryption key for the recipient of this message. "
"Therefore the message will not be encrypted."
msgstr ""
"Vi ne elektis ĉifro-ŝlosilon por la ricevonto de tiu mesaĝo. Do la "
"mesaĝo ne estos ĉifrita."

#: kpgp.cpp:359
msgid ""
"You didn't select an encryption key for any of the recipients of this "
"message. Therefore the message will not be encrypted."
msgstr ""
"Vi ne elektis ĉifro-ŝlosilon por tiu el la ricevontoj de tiu mesaĝo.Do la "
"mesaĝo ne estos ĉifrita."

#: kpgp.cpp:366 kpgp.cpp:385 kpgp.cpp:462
msgid "Send &unencrypted"
msgstr "&Sendu neĉifrita"

#: kpgp.cpp:374
msgid ""
"You didn't select an encryption key for one of the recipients. This person "
"will not be able to decrypt the message if you encrypt it."
msgstr ""
"Vi ne elektis ĉifro-ŝlosilon por unu ricevonton. Tiu persono ne povos "
"malĉifir la mesaĝon, se vi ĉifros ĝin."

#: kpgp.cpp:377
msgid ""
"You didn't select encryption keys for some of the recipients. These persons "
"will not be able to decrypt the message if you encrypt it."
msgstr ""
"Vi ne elektis ĉifro-ŝlosilon por kelkaj ricevontoj. Tiuj personoj ne povos "
"malĉifri la mesaĝon, se vi ĉifros ĝin."

#: kpgp.cpp:384 kpgp.cpp:461
msgid "Send &encrypted"
msgstr "Sendu ĉ&ifrita"

#: kpgp.cpp:405
msgid ""
"You entered an invalid passphrase.\n"
"Do you want to try again, continue and leave the message unsigned, or cancel "
"sending the message?"
msgstr ""
"Vi donis nevalidan pasfrazon.\n"
"Ĉu vi volas reprovi, daŭrigi kaj lasi\n"
"la mesaĝon neĉifrita, aŭ rezigni pri la sendado?"

#: kpgp.cpp:413 kpgp.cpp:442
msgid "Send &unsigned"
msgstr "Sendu &neĉifrita"

#: kpgp.cpp:435
msgid ""
"_: %1 = 'signing failed' error message\n"
"%1\n"
"Do you want to send the message unsigned, or cancel sending the message?"
msgstr ""
"%1\n"
"Ĉu vi volas sendi la mesaĝon neĉifrita, aŭ rezigni pri la sendado?"

#: kpgp.cpp:454
msgid ""
"_: %1 = 'bad keys' error message\n"
"%1\n"
"Do you want to encrypt anyway, leave the message as is, or cancel sending "
"the message?"
msgstr ""
"%1\n"
"Ĉu vi volas ĉifri tamen, lasi la\n"
"mesaĝon kiel ĝi estas, aŭ rezigni pri sendado?"

#: kpgp.cpp:478
msgid ""
"_: %1 = 'missing keys' error message\n"
"%1\n"
"Do you want to leave the message as is, or cancel sending the message?"
msgstr ""
"%1\n"
"Ĉu vi volas lasi la mesaĝon kiel ĝi estas\n"
"aŭ rezigni pri sendado?"

#: kpgp.cpp:485
msgid "&Send as is"
msgstr "&Sendu tiel"

#: kpgp.cpp:496
#, c-format
msgid ""
"The following error occurred:\n"
"%1"
msgstr ""
"La sekva eraro okazis:\n"
"%1"

#: kpgp.cpp:498
msgid ""
"This is the error message of %1:\n"
"%2"
msgstr ""
"Jen la eraromesaĝo de %1:\n"
"%2"

#: kpgp.cpp:784 kpgp.cpp:809 kpgpui.cpp:667
msgid "Encryption Key Selection"
msgstr "Elekto de ĉifro-ŝlosilo"

#: kpgp.cpp:785
msgid ""
"No valid and trusted OpenPGP key was found for \"%1\".\n"
"\n"
"Select the key which should be used for this recipient."
msgstr ""
"Ne troviĝis valida kaj fidata OpenPGP-ŝlosilo por \"%1\".\n"
"\n"
"Elektu la ŝlosilon uzotan por tiu ricevonto."

#: kpgp.cpp:810
msgid ""
"More than one key match \"%1\".\n"
"\n"
"Select the key which should be used for this recipient."
msgstr ""
"Pli ol unu ŝlosilo konvenas al \"%1\".\n"
"\n"
"Elektu la ŝlosilon uzotan por tiu ricevonto."

#: kpgp.cpp:956
msgid ""
"Sorry, but this feature\n"
"is still missing"
msgstr ""
"Pardonu, sed tiu funkcio ankoraŭ\n"
"mankas"

#: kpgp.cpp:1004 kpgp.cpp:1040
msgid "You either don't have GnuPG/PGP installed or you chose not to use GnuPG/PGP."
msgstr "Aŭ vi ne instalis GnuPG/PGP aŭ vi elektis ne uzi ĝin."

#: kpgpbase2.cpp:134 kpgpbaseG.cpp:141
msgid ""
"Could not find public keys matching the userid(s)\n"
"%1.\n"
"The message is not encrypted."
msgstr ""
"Ne eblis trovi la publikan ŝlosilon por uzanto(j)\n"
"%1.\n"
"La mesaĝo ne estos ĉifrita."

#: kpgpbase2.cpp:139 kpgpbaseG.cpp:146
msgid ""
"Could not find public keys matching the userid(s)\n"
"%1.\n"
"These persons won't be able to read the message."
msgstr ""
"Ne eblis trovi publikan ŝlosilon por la uzanto(j)\n"
"%1.\n"
"Tiuj personoj ne povos legi la mesaĝon."

#: kpgpbase2.cpp:165
msgid ""
"Public keys not certified with trusted signature for userid(s)\n"
"%1.\n"
"The message is not encrypted."
msgstr ""
"La publikaj ŝlosiloj ne estas atestitaj per fidata subskribo por la "
"uzanto(j)\n"
"%1.\n"
"La mesaĝo ne estos ĉifrita."

#: kpgpbase2.cpp:171
msgid ""
"Public keys not certified with trusted signature for userid(s)\n"
"%1.\n"
"These persons won't be able to read the message."
msgstr ""
"La publikaj ŝlosiloj ne estas atestitaj per fidata subskribo por la "
"uzanto(j)\n"
"%1.\n"
"Tiuj personoj ne povos legi la mesaĝon."

#: kpgpbase2.cpp:192
msgid "Bad passphrase; couldn't sign."
msgstr "Malbona pasfrazo; ne povis subskribi."

#: kpgpbase2.cpp:200
msgid ""
"Signing failed! Please check your PGP User Identity, the PGP setup and the "
"key rings."
msgstr ""
"Subskribo malsukcesis! Bonvolu kontroli\n"
"vian PGP-identecon, la PGP-agordon kaj ŝlosilaron."

#: kpgpbase2.cpp:208
msgid "Encryption failed! Please check your PGP setup and the key rings."
msgstr ""
"Malĉifrado malsukcesis! Bonvolu kontroli\n"
"vian PGP-agordon kaj ŝlosilaron."

#: kpgpbase2.cpp:254 kpgpbase6.cpp:60 kpgpbase6.cpp:384
msgid "error running PGP"
msgstr "Eraro ĉe lanĉo de PGP"

#: kpgpbase2.cpp:294 kpgpbase5.cpp:226 kpgpbaseG.cpp:245
msgid "Bad passphrase; couldn't decrypt."
msgstr "Malbona pasfrazo; ne povas malĉifri."

#: kpgpbase2.cpp:305 kpgpbase5.cpp:237 kpgpbaseG.cpp:266
msgid "You don't have the secret key needed to decrypt this message."
msgstr "Vi ne havas la sekretan ŝlosilon necesan por malĉifri tiun mesaĝon."

#: kpgpbase2.cpp:445
msgid ""
"The keyring file %1 does not exist.\n"
"Please check your PGP setup."
msgstr ""
"La ŝlosilaro-dosiero %1 ne ekzistas.\n"
"Bonvolu kontroli vian agordon de PGP."

#: kpgpbase2.cpp:451
msgid "Unknown error"
msgstr "Nekonata eraro"

#: kpgpbase5.cpp:85
msgid "Neither recipients nor passphrase specified."
msgstr "Nek ricevontoj ne pasfrazo donita."

#: kpgpbase5.cpp:127
msgid "The passphrase you entered is invalid."
msgstr "La pasfrazo tajpita de vi ne estas valida."

#: kpgpbase5.cpp:153
msgid ""
"The key(s) you want to encrypt your message to are not trusted. No "
"encryption done."
msgstr ""
"La ŝlosilo(j), per kiu(j) vi volas ĉifri vian mesaĝon ne estas fidataj. "
"Ĉifrado ne okazas."

#: kpgpbase5.cpp:156
msgid ""
"The following key(s) are not trusted:\n"
"%1\n"
"Their owner(s) will not be able to decrypt the message."
msgstr ""
"La sekva(j) ŝlosilo(j) ne estas fidataj:\n"
"%1\n"
"Iliaj posedantoj ne povos malĉifri la mesaĝon."

#: kpgpbase5.cpp:168
#, c-format
msgid ""
"Missing encryption key(s) for:\n"
"%1"
msgstr ""
"Mankas ĉifro-ŝlosilo(j) por:\n"
"%1"

#: kpgpbase5.cpp:205
msgid "Error running PGP"
msgstr "Eraro ĉe lanĉo de PGP"

#: kpgpbase6.cpp:85
msgid "Bad passphrase; couldn't decrypt"
msgstr "Malbona pasfrazo; ne povus malĉifri"

#: kpgpbase6.cpp:93
msgid "You do not have the secret key for this message"
msgstr "Vi ne havas la sekretan ŝlosilon por tiu mesaĝo"

#: kpgpbase6.cpp:170
msgid "??? (file ~/.pgp/pubring.pkr not found)"
msgstr "??? (dosiero ~/.pgp/pubring.pkr ne troviĝis)"

#: kpgpbaseG.cpp:108
msgid "Unknown error!"
msgstr "Nekonata eraro!"

#: kpgpbaseG.cpp:171
msgid "Signing failed because the passphrase is wrong."
msgstr "Subskribo malsukcesis pro malĝusta pasfrazo."

#: kpgpbaseG.cpp:178
msgid "Signing failed because your secret key is unusable."
msgstr "Subskribo malsukcesis, ĉar via sekreta ŝlosilo estas neuzebla."

#: kpgpbaseG.cpp:209
msgid "Error running gpg"
msgstr "Eraro ĉe lanĉo de GPG"

#: kpgpbaseG.cpp:341
