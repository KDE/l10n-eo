#: configparser.cpp:655
msgid "cannot open %1 for reading"
msgstr "ne eblis malfermi %1 por legado"

#: configuration.cpp:97
msgid "Are you sure you want to overwrite your existing kernel configuration in %1?"
msgstr "Ĉu vi vere volas anstataŭigi vian ekzistantan kerno-agordon en %1?"

#: configuration.cpp:110
msgid ""
"You do not have sufficient permissions to write %1\n"
"Do you want to write the configuration to a different file instead?"
msgstr ""
"Vi ne havas sufiĉajn permesojn por skribi al %1\n"
"Ĉu vi volas skribi la agordon al alia dosiero anstataŭe?"

#: configuration.cpp:122
msgid "Do you really want to reset all kernel options to their default values?"
msgstr "Ĉu vi vere volas restarigi ĉiujn kerno-opciojn per la aprioraj valoroj?"

#: configuration.cpp:148
msgid ""
"_: Error message\n"
"<p>%1</p"
msgstr "<p>%1</p"

#: configuration.cpp:154
msgid ""
"<p>%1, line %2:</p>\n"
"<pre>%3<span style=\"color: red\">%4</span>%5\n"
"%6^ %7</pre>"
msgstr ""
"<p>%1, linio %2:</p>\n"
"<pre>%3<span style=\"color: red\">%4</span>%5\n"
"%6^ %7</pre>"

#: configuration.cpp:167
msgid ""
"<p>Either your kernel sources contain invalid configuration rules or you "
"just found a bug in the KDE Kernel Configurator.</p>"
msgstr ""
"<p>Aŭ viaj kernofontoj enhavas nevalidajn agordoregulojn aŭ vi ĵus trovis eraron "
"en la KDE-Kernagordilo.</p>"

#: configuration.cpp:189
msgid ""
"_n: The kernel configuration could not be read due to the following error:\n"
"The kernel configuration could not be read due to the following errors:"
msgstr ""
"Ne povis legi la kernagordon pro la sekva eraro:\n"
"Ne povis legi la kernagordon pro la sekvaj eraroj:"

#: configuration.cpp:244
msgid "Linux Kernel Configurator"
msgstr "Linuksa Kernagordilo"

#: configuration.cpp:245
msgid "Option is disabled"
msgstr "Opcio estas elŝaltita"

#: configuration.cpp:246
msgid "Option is enabled"
msgstr "Opcio estas enŝaltita"

#: configuration.cpp:247
msgid "Compiled as a module"
msgstr "Kompilita kiel modulo"

#: configuration.cpp:330
msgid ""
"Your kernel configuration has been saved.\n"
"You need to run 'make symlinks dep' now."
msgstr ""
"Via kernagordo estas sekurigita.\n"
"Vi nun devas lanĉi 'make symlinks dep'."

#: configuration.cpp:334
msgid ""
"Your kernel configuration has been saved.\n"
"You may run 'make bzImage', 'make bzDisk' or 'make install' now."
msgstr ""
"Via kernagordo estas sekurigita.\n"
"Vi povas nun lanĉi 'make bzImage', 'make bzDisk' aŭ "
"'make install'."

#: configuration.cpp:340
msgid ""
"Your kernel configuration has been saved.\n"
"The file %1, which is needed for the kernel build could not be written "
"though.\n"
"Please run 'make oldconfig'."
msgstr ""
"Via kernagordo estas sekurigita.\n"
"La dosiero %1 necesa por la kreado de la kerno ne estis skribebla.\n"
"Bonvolu lanĉi 'make oldconfig'."

#: configuration.cpp:347
msgid "Your kernel configuration has been saved."
msgstr "Via kernagordo estas sekurigita."

#: configuration.cpp:352
msgid "The kernel configuration could not be saved."
msgstr "Ne eblis sekurigi la kernagordon."

