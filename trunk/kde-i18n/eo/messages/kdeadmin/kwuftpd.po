#: EditLimit.cpp:42 EditLimit.cpp:43
msgid ""
"Use this to specify at which hours this limit is in effect.\n"
"Example:\n"
"0630-1310 -> 06:30 AM - 01:10 PM\n"
"Defaults to 0000-2400."
msgstr ""
"Uzu tion por indiki, je kiuj horoj la limoj estas aktivaj.\n"
"Ekzemplo:\n"
"0630-1310 -> 06:30 - 13:10\n"
"Implicite je 0000-2400."

#: EditUpload.cpp:19
msgid "Edit Upload"
msgstr "Redaktu alŝuton"

#: Logging.cpp:20
msgid ""
"Use these check boxes to control for which types of users all commands will "
"be logged."
msgstr ""
"Uzu tiujn elektilojn por difini por kiuj uzantotipoj ĉiuj komandoj estu "
"protokolataj."

#: Logging.cpp:21
msgid "Log inbound transfers (uploads to this server)"
msgstr "Protokolu alŝutojn al tiu ĉi servilo"

#: Logging.cpp:22
msgid "Log outbound transfers (downloads from this server)"
msgstr "Protokolu deŝutojn de tiu ĉi servilo"

#: Logging.cpp:23
msgid "Log security-related messages (failed logins etc.)"
msgstr "Protokolu sekurecrilatajn mesaĝojn (malsukcesaj salutoj ktp.)"

#: Logging.cpp:24
msgid ""
"Log commands given by anonymous (username <i>ftp</i> or <i>anonymous</i>) "
"users."
msgstr ""
"Protokolu komandojn de anonimaj uzantoj (salutnomo <i>ftp</i> aŭ "
"<i>anonymous</i>)."

#: Logging.cpp:25
msgid ""
"Log commands given by guest users (users with a real account, but restricted "
"access)."
msgstr ""
"Protokolu komandojn de gastuzantoj (uzantoj kun reala konto, sed limigita "
"aliro)."

#: Logging.cpp:26
msgid ""
"Log commands given by real users (users with an unrestricted account on the "
"server"
msgstr ""
"Protokolu komandojn de realaj uzantoj (uzantoj kun nelimigita konto sur la "
"servilo)"

#: Logging.cpp:27
msgid ""
"Log inbound transfers (uploads to the server) by anonymous users (username "
"<i>ftp</i> or <i>anonymous</i>)"
msgstr ""
"Protokolu alŝutojn de anonimaj uzantoj (salutnomo <i>ftp</i> aŭ "
"<i>anonymous</i>)"

#: Logging.cpp:28
msgid ""
"Log inbound transfers (uploads to the server) by guest users (users with a "
"real account, but restricted access)"
msgstr "Protokolu alŝutojn de gastuzantoj (uzantoj kun reala sed limigita konto)"

#: Logging.cpp:29
msgid ""
"Log inbound transfers (uploads to the server) by real users (users with a "
"real account and without restrictions)"
msgstr "Protokolu alŝutojn de realaj uzantoj (kun nelimigita konto)"

#: Logging.cpp:30
msgid ""
"Log outbound transfers (downloads from the server) by anonymous users "
"(username <i>ftp</i> or <i>anonymous</i>)"
msgstr ""
"Protokolu deŝutojn de anonimaj uzantoj (salutnomo <i>ftp</i> aŭ "
"<i>anonymous</i>)"

#: Logging.cpp:31
msgid ""
"Log outbound transfers (downloads from the server) by guest users (users "
"with a real account, but restricted access)"
msgstr "Protokolu deŝutojn de gastaj uzantoj (kun reala sed limigita konto)"

#: Logging.cpp:32
msgid ""
"Log outbound transfers (downloads from the server) by real users (users with "
"a real account and without restrictions)"
msgstr "Protokolu deŝutojn de realaj uzantoj (kun reala nelimigita konto)"

#: Logging.cpp:33
msgid ""
"Keep a security log (failed login attempts etc.) for anonymous users "
"(username <i>anonymous</i> or <i>ftp</i>)"
msgstr ""
"Tenu sekurecprotokolon (malsukcesaj salutoj ktp.) por anonimaj uzantoj "
"(salutnomo <i>anonymous</i> aŭ <i>ftp</i>)"

#: Logging.cpp:34
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with restricted access)"
msgstr ""
"Tenu sekurecprotokolon (malsukcesaj salutoj ktp.) por gastuzantoj (realaj "
"uzantoj kun limigita konto)"

#: Logging.cpp:35
msgid ""
"Keep a security log (failed login attempts etc.) for guest users (real users "
"with unrestricted access)"
msgstr ""
"Tenu sekurecprotokolon (malsukcesaj salutoj ktp.) por realaj uzantoj (realaj "
"uzantoj kun nelimigita konto)"

#: Logging.cpp:36
msgid "Log to syslog instead of logfiles"
msgstr "Skribu al sistemprotokolo anstataŭ al protokoldosieroj"

#: Logging.cpp:37
msgid "Automatically notify the administrator of uploads from anonymous users"
msgstr "Aŭtomate atentigu la administranton pri alŝutoj de anonimaj uzantoj"

#: Logging.cpp:38
msgid ""
"The address entered here will appear in the <i>From:</i> header of upload "
"notification email messages sent by wu-ftpd."
msgstr ""
"La adreso donita tie ĉi aperos en la <i>From:</i>-kaplinio de retpoŝto "
"sendita de wu-Ftp ĉe alŝutoj."

#: Logging.cpp:39
msgid ""
"The mail server entered here will be used to transmit upload notification "
"email messages sent by wu-ftpd. If left blank, localhost will be used."
msgstr ""
"La retpoŝtservilo donita tie ĉi estos uzata por forsendi retpoŝtojn de "
"wu-Ftp ĉe alŝutoj. Se vi lasas malplena, \"localhost\" estas uzata."

#: Logging.cpp:41 Logging.cpp:42
msgid ""
"This list box shows the recipient(s) of upload notification emails. Use the "
"<b>Add</b> and <b>Remove</b> buttons below to modify the recipients."
msgstr ""
"Tiu listo montras la ricevonto(j)n de atentigaj retpoŝtoj. Uzu la butonojn "
"<b>Aldonu</b> kaj <b>Forigu</b> por ŝanĝi la enhavon."

#: Logging.cpp:44
msgid "Add a new recipient for upload notification emails"
msgstr "Aldonu novan ricevonton por alŝuto-anoncoj"

#: Logging.cpp:45
msgid "Remove the currently selected recipient for upload notification emails"
msgstr "Forigu la elektitan ricevonton por alŝuto-anoncoj"

#: Messages.cpp:16
#, fuzzy
msgid ""
"The file selected here will be displayed to\n"
"FTP users before login.\n"
"May break compatibility with truly ancient clients."
msgstr ""
"La dosiero tie ĉi elektita estos montrata al\n"
"FTP-uzantoj antaŭ saluto.\n"
"Tio povus misfunkciigi ver malnovajn klientprogramojn."

#: Messages.cpp:17
msgid ""
"The hostname given here will be shown at login and for\n"
"the %L cookie in message files.\n"
"If this is blank, the canonical hostname of your system will be used."
msgstr ""
"La servilonomo donita tie ĉi estos montrata ĉe saluto kajpor la %L-kuketo "
"en mesaĝdosieroj.\n"
"Se vi lasas ĝin malplena, la normala komputilnomo devia sistemo estos uzata."

#: Messages.cpp:18
#, c-format
msgid "Email address returned with the %E cookie in message files."
msgstr "Retpoŝtadreso redonita per la %E-kuketo en mesaĝdosieroj."

#: Messages.cpp:19
msgid "If this is not checked, message files at CWD will be displayed only once."
msgstr "Se tio ne estas elektita, mesaĝdosieroj ĉe CWD estos montrataj nur unufoje."

#: Messages.cpp:20
msgid "If this is not checked, hints on README files will be displayed only once."
msgstr ""
"Se tio ne estas elektita, helpindikoj de LEGUMIN-dosieroj estosmontrata nur "
"unufoje"

#: Messages.cpp:22 Messages.cpp:23 Messages.cpp:24
msgid ""
"Messages are files that are automatically displayed to the user after "
"logging in or after entering a directory. Use the <b>Add Message</b> and "
"<b>Remove Message</b> buttons to modify the messages."
msgstr ""
"Mesagoj estas dosieroj aŭtomate montrataj al la uzantoj post saluto aŭ "
"post aliro de dosierujo. Uzu la butonojn <b>Aldonu mesaĝon</b> kaj "
"<b>Forigu mesaĝon</b> por alordigi mesaĝojn."

#: Messages.cpp:26 Messages.cpp:27 Messages.cpp:28
msgid ""
"When you've defined README files, users changing to a directory containing "
"files matching the glob listed here will be pointed to these files with a "
"<i>Please read the file README, last modified x days ago</i> message."
"<br>Use the <b>Add Readme</b> and <b>Remove Readme</b>"
" buttons to modify the list of README files."
msgstr ""
"Se vi difinis LEGUMIN-dosierojn, uzantoj estos atentigataj al tiuj ĉe "
"dosieraliro per mesaĝo <i>Bonvolu legi la LEGUMIN-dosieron, laste "
"ŝanĝitan antaŭ x tagoj</i>."
"<br>Uzu la butonojn <b>Aldonu Legumin-dosieron</b> kaj <b>Forigu "
"Legumin-dosieron</b> por ŝanĝi la liston de LEGUMIN-dosieroj."

#: NewClass.cpp:11
msgid "Add New User Class"
msgstr "Aldonu novan uzantoklason"

#: NewClass.cpp:17 NewClass.cpp:18
msgid ""
"The name of your new user class -\n"
"may be anything, but may not contain whitespaces."
msgstr ""
"La nomo de via uzantoklaso -\n"
"povas esti iu ajn, sed ne enhavu spacsignojn."

#: NewClass.cpp:19
msgid ""
"Anonymous users\n"
"(login=ftp or anonymous)"
msgstr ""
"Anonimaj uzantoj\n"
"(salutnomo=ftp aŭ anonymous)"

#: NewClass.cpp:20
msgid ""
"Guest users\n"
"(chrooted real users)"
msgstr ""
"Gastuzantoj\n"
"(radikigitaj realaj uzantoj)"

#: NewClass.cpp:21
msgid "Real users"
msgstr "Realaj uzantoj"

#: NewClass.cpp:22 NewClass.cpp:23 UserClasses.cpp:28 UserClasses.cpp:29
msgid ""
"Specify the addresses for this user class here;\n"
"may be globbed:\n"
"* = any address\n"
"*.localdomain.com = any address in localdomain.com\n"
"127.0.0.* = IPs 127.0.0.1-127.0.0.255\n"
"..."
msgstr ""
"Indiku la adresojn por tiu ĉi uzantoklaso tie ĉi;\n"
"vi povas uzi ĵokersignojn:\n"
"* = ĉiuj adresoj\n"
"*.localdomain.com = ĉiu adreso en localmain.com\n"
"127.0.0.* = IP-adresoj 127.0.0.1 - 127.0.0.255\n"
"..."

#: NewClass.cpp:37
msgid "Class name may not be empty."
msgstr "Klasnomo ne estu malplena."

#: NewClass.cpp:42
msgid "Class name may not contain whitespaces"
msgstr "Klasnomo ne enhavu spacsignojn"

#: NewClass.cpp:49
msgid "You must check at least one of Anonymous, Guest or Real!"
msgstr "Vi devas elekti almenaŭ unu el Anonimulo, Gasto, Reala!"

#: NewClass.cpp:55
msgid "Addresses can not be empty. Assume '*'?"
msgstr "Adresoj ne estu malplenaj. Ĉu supozi '*'?"

