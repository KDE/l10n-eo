#: kdecore/kapp.cpp:940
msgid ""
"There was some error setting up inter-process\n"
"communications for KDE.  The message returned\n"
"by the system was:\n"
"\n"
msgstr ""
"Okazis eraro dum starto de komunikado inter\n"
"la KDE-procesoj. La mesaĝo redonita de la\n"
"operaciumo estas:\n"

#: kdecore/kapp.cpp:944
msgid ""
"\n"
"\n"
"Please check that the \"dcopserver\" program is running!"
msgstr ""
"\n"
"\n"
"Kontrolu, ĉu la programo \"dcopserver\" estas lanĉita!"

#: kdecore/kapp.cpp:947
msgid "DCOP communications error (%1)"
msgstr "DCOP-komunikado-eraro (%1)"

#: kdecore/kapp.cpp:955
msgid "Use the X-server display 'displayname'"
msgstr "Uzu la X-servilan ekranono 'ekrannomo'"

#: kdecore/kapp.cpp:956
msgid "Set default font to 'fontname'"
msgstr "Difinu aprioran tiparon kiel 'tiparnomo'"

#: kdecore/kapp.cpp:957
msgid "Restore the application for the given 'sessionId'"
msgstr "Restarigu la aplikaĵon por la donita 'seancnumero'"

#: kdecore/kapp.cpp:958
msgid ""
"Causes the application to install a private color map on an 8-bit display"
msgstr ""
"Faras, ke la aplikaĵo instalas propran kolorpaletron ĉe 8-bita ekrano"

#: kdecore/kapp.cpp:959
msgid ""
"Limits the number of colors allocated in the color cube on a 8-bit display,\n"
"if the application is using the QApplication::ManyColor color specification"
msgstr ""
"Limigas la nombron de koloroj rezervitaj en la kolorkubo ĉe 8-bita ekrano,\n"
"se la aplikaĵo uzas QApplication::ManyColor"

#: kdecore/kapp.cpp:960
msgid "tells Qt to never grab the mouse or the keyboard."
msgstr "diras al Qt, ke ĝi neniam transprenu la muson aŭ la klavaron."

#: kdecore/kapp.cpp:961
msgid ""
"running under a debugger can cause an implicit -nograb, use -dograb to "
"override."
msgstr ""
"ruliĝante sub sencimigilo tio povas kaŭzi transdonon de implicita "
"argumento -nograb, uzu -dograb por ŝanĝi tion."

#: kdecore/kapp.cpp:962
msgid "switches to synchronous mode for debugging."
msgstr "ŝaltiloj por sinkrona moduso ĉe sencimigado."

#: kdecore/kapp.cpp:963
msgid ""
"sets the application GUI style. Possible values are motif, windows, and "
"platinum."
msgstr ""
"difinas la grafikan aspekton de la aplikaĵo. Eblaj vaoloroj estas 'motif', "
"'windows' kaj 'platinum'."

#: kdecore/kapp.cpp:964
msgid "sets the client geometry of the main widget."
msgstr "difinas la klientogeometrion de la precipa fenestro."

#: kdecore/kapp.cpp:966
msgid "defines the application font."
msgstr "difinas la tiparon de la aplikaĵo"

#: kdecore/kapp.cpp:968
msgid ""
"sets the default background color and an application palette (light and dark "
"shades are calculated)."
msgstr ""
"difinas la aprioran fonkoloron kaj paletron por la aplikaĵo(helaĵoj kaj "
"malhelaĵoj estas kalkulitaj surbaze de la koloro)."

#: kdecore/kapp.cpp:970
msgid "sets the default foreground color."
msgstr "difinas la aprioran tekstkoloron."

#: kdecore/kapp.cpp:972
msgid "sets the default button color."
msgstr "difinas la aprioran koloron de butonoj."

#: kdecore/kapp.cpp:973
msgid "sets the application name."
msgstr "donas la nomon de la aplikaĵo."

#: kdecore/kapp.cpp:974
msgid "sets the application title (caption)."
msgstr "donas la titolon de la aplikaĵo."

#: kdecore/kapp.cpp:975
msgid "forces the application to use a TrueColor visual on an 8-bit display."
msgstr ""
"Faras, ke la aplikaĵo uzas fenestraĵon 'TrueColor visual' ĉe 8-bita "
"ekrano."

#: kdecore/kapp.cpp:976
msgid ""
"sets XIM(X Input Method) input style. Possible values are onthespot, "
"overthespot, offthespot and root"
msgstr ""
"Difinas la enigstilon de XIM (X-enIg-Metodo). Eblaj valoroj estas "
"\"onthespot\", \"overthespot\", \"offthespot\" kaj \"root\"."

#: kdecore/kapp.cpp:982
msgid "Use 'caption' as name in the titlebar"
msgstr "Uzu 'titolo' kiel nomon en la titollistelo"

#: kdecore/kapp.cpp:983
msgid "Use 'icon' as the application icon"
msgstr "Uzu 'piktogramon' kiel piktogramo de la aplikaĵo"

#: kdecore/kapp.cpp:984
msgid "Use 'icon' as the icon in the titlebar"
msgstr "Uzu 'piktogramo' kiel piktrogramon en la titollistelo"

#: kdecore/kapp.cpp:985
msgid "Use the DCOP Server specified by 'server'"
msgstr "Uzu la DCOP-servilon donitan de 'servilo'"

#: kdecore/kapp.cpp:986
msgid "Disable crash handler, to get core dumps"
msgstr ""
"Malŝaltu kraŝtraktilon por ricevi konvenciajn erardosierojn (Core dump)"

#: kdecore/kapp.cpp:987
msgid "Waits for a WM_NET compatible windowmanager"
msgstr "Atendas WM_NET-kongruan fenestroadministrilon"

#: kdecore/kapp.cpp:1405 kdecore/kstyle.cpp:316
#: kstyles/highcolor/hcstyle.cpp:1802 kstyles/klegacy/klegacystyle.cpp:3043
msgid "modified"
msgstr "ŝanĝita"

#: kdecore/kapp.cpp:1734
msgid "Could not register with DCOP.\n"
msgstr "Ne eblis registriĝi ĉe DCOP.\n"

#: kdecore/kapp.cpp:1758
msgid "KLauncher could not be reached via DCOP.\n"
msgstr "Ne eblis atingi la programon KLauncher per DCOP.\n"

#: kdecore/kcompletion.cpp:447
msgid ""
"You reached the end of the list\n"
"of matching items.\n"
msgstr "Jen fino de la listo de konvenaj eroj.\n"

#: kdecore/kcompletion.cpp:452
msgid ""
"The completion is ambiguous, more than one\n"
"match is available.\n"
msgstr ""
"La kompletigo ne estas unika, pli ol unu konvenaĵo estus\n"
"uzebla.\n"

#: kdecore/kcompletion.cpp:459
msgid "There is no matching item available.\n"
msgstr "Ne ekzitas konvena ero.\n"

