#: kdecore/kapp.cpp:996
msgid ""
"There was some error setting up inter-process\n"
"communications for KDE.  The message returned\n"
"by the system was:\n"
"\n"
msgstr ""
"Okazis eraro dum starto de komunikado inter\n"
"la KDE-procezoj. La mesaĝo redonita de la\n"
"operaciumo estas:\n"

#: kdecore/kapp.cpp:1000
msgid ""
"\n"
"\n"
"Please check that the \"dcopserver\" program is running!"
msgstr ""
"\n"
"\n"
"Kontrolu, ĉu la programo \"dcopserver\" estas lanĉita!"

#: kdecore/kapp.cpp:1003
msgid "DCOP communications error (%1)"
msgstr "DCOP-komunikado-eraro (%1)"

#: kdecore/kapp.cpp:1011
msgid "Use the X-server display 'displayname'."
msgstr "Uzu la X-servilan ekranon 'ekranonomo'."

#: kdecore/kapp.cpp:1012
msgid "Restore the application for the given 'sessionId'."
msgstr "Restarigu la aplikaĵon por la donita 'seanconumero'."

#: kdecore/kapp.cpp:1013
msgid ""
"Causes the application to install a private color\n"
"map on an 8-bit display."
msgstr ""
"Faras, ke la aplikaĵo instalas propran kolorpaletron\n"
"ĉe 8-bita ekrano."

#: kdecore/kapp.cpp:1014
msgid ""
"Limits the number of colors allocated in the color\n"
"cube on a 8-bit display, if the application is\n"
"using the QApplication::ManyColor color\n"
"specification."
msgstr ""
"Limigas la nombron de koloroj rezervitaj\n"
"en la kolorkubo ĉe 8-bita ekrano,\n"
"se la aplikaĵo uzas QApplication::ManyColor."

#: kdecore/kapp.cpp:1015
msgid "tells Qt to never grab the mouse or the keyboard."
msgstr "diras al Qt, ke ĝi neniam transprenu la muson aŭ la klavaron."

#: kdecore/kapp.cpp:1016
msgid ""
"running under a debugger can cause an implicit\n"
"-nograb, use -dograb to override."
msgstr ""
"ruliĝante sub sencimigilo tio povas kaŭzi\n"
"transdonon de implicita argumento -nograb,\n"
"uzu -dograb por ŝanĝi tion."

#: kdecore/kapp.cpp:1017
msgid "switches to synchronous mode for debugging."
msgstr "ŝaltiloj por sinkrona moduso ĉe sencimigado."

#: kdecore/kapp.cpp:1019
msgid "defines the application font."
msgstr "difinas la tiparon de la aplikaĵo"

#: kdecore/kapp.cpp:1021
msgid ""
"sets the default background color and an\n"
"application palette (light and dark shades are\n"
"calculated)."
msgstr ""
"difinas la aprioran fonkoloron kaj paletron por la aplikaĵo\n"
"(helaĵoj kaj malhelaĵoj estas kalkulitaj surbaze de la koloro)."

#: kdecore/kapp.cpp:1023
msgid "sets the default foreground color."
msgstr "difinas la aprioran tekstkoloron."

#: kdecore/kapp.cpp:1025
msgid "sets the default button color."
msgstr "difinas la aprioran koloron de butonoj."

#: kdecore/kapp.cpp:1026
msgid "sets the application name."
msgstr "donas la nomon de la aplikaĵo."

#: kdecore/kapp.cpp:1027
msgid "sets the application title (caption)."
msgstr "donas la titolon de la aplikaĵo."

#: kdecore/kapp.cpp:1028
msgid ""
"forces the application to use a TrueColor visual on\n"
"an 8-bit display."
msgstr ""
"Faras, ke la aplikaĵo uzas fenestraĵon 'TrueColor visual'\n"
"ĉe 8-bita ekrano."

#: kdecore/kapp.cpp:1029
msgid ""
"sets XIM (X Input Method) input style. Possible\n"
"values are onthespot, overthespot, offthespot and\n"
"root."
msgstr ""
"Difinas la enigstilon de XIM (X-enIg-Metodo). Eblaj\n"
"valoroj estas  \"onthespot\", \"overthespot\", \"offthespot\"\n"
"kaj \"root\"."

#: kdecore/kapp.cpp:1030
msgid "set XIM server."
msgstr "difinu XIM-servilon."

#: kdecore/kapp.cpp:1031
msgid "disable XIM."
msgstr "elŝaltu XIM."

#: kdecore/kapp.cpp:1037
msgid "Use 'caption' as name in the titlebar."
msgstr "Uzu 'titolo' kiel nomon en la titollistelo."

#: kdecore/kapp.cpp:1038
msgid "Use 'icon' as the application icon."
msgstr "Uzu 'piktogramon' kiel piktogramo de la aplikaĵo."

#: kdecore/kapp.cpp:1039
msgid "Use 'icon' as the icon in the titlebar."
msgstr "Uzu 'piktogramo' kiel piktogramon en la titollistelo."

#: kdecore/kapp.cpp:1040
msgid "Use the DCOP Server specified by 'server'."
msgstr "Uzu la DCOP-servilon donitan de 'servilo'."

#: kdecore/kapp.cpp:1041
msgid "Disable crash handler, to get core dumps."
msgstr "Malŝaltu kraŝtraktilon por ricevi konvenciajn erardosierojn (Core dump)."

#: kdecore/kapp.cpp:1042
msgid "Waits for a WM_NET compatible windowmanager."
msgstr "Atendas WM_NET-kongruan fenestroadministrilon."

#: kdecore/kapp.cpp:1043
msgid "sets the application GUI style."
msgstr "difinas la grafikstilon de la aplikaĵo."

#: kdecore/kapp.cpp:1044
msgid "sets the client geometry of the main widget."
msgstr "difinas la klientogeometrion de la precipa fenestro."

#: kdecore/kapp.cpp:1080
msgid ""
"The style %1 was not found\n"
msgstr ""
"La stilo %1 ne troviĝis\n"

