#: runapplet.cpp:59
msgid "Run Command:"
msgstr "Lanĉu komandon:"

#: runapplet.cpp:150
msgid "< Run"
msgstr "< Lanĉu"

#: runapplet.cpp:157
msgid "Run >"
msgstr "Lanĉu >"

#: runapplet.cpp:212
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "Vi devas unue entajpi komandon lanĉendan aŭ URLon malfermendan."

#: runapplet.cpp:220
msgid ""
"Could not logout properly.  The sesion manager cannot\n"
"be contacted.  You can try to force a shutdown by pressing\n"
"the CTRL, SHIFT and BACKSPACE keys at the same time.  Note\n"
"however that your current session will not be saved with a\n"
"forced shutdown."
msgstr ""
"Ne eblis adiaŭi ĝuste. La seancadministrilo ne estas kontaktebla.\n"
"Vi povas perforte adiaŭi premante Ktrl, Majuskl kaj Retro samtempe.\n"
"Atentu, ke tiukaze via nuna seanco ne estos sekurigata."

#: runapplet.cpp:259
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found.  Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>La programnomo aŭ komando <b>%1</b>\n"
"ne troviĝis. Bonvolu korekti la komandon aŭ URLon kaj\n"
"reprovi</qt>"

#: runapplet.cpp:270
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>Ne eblis lanĉi <b>%1</b>.\n"
"Bonvolu korekti la komandon aŭ URLon kaj reprovi.</qt>"
