#: joywidget.cpp:325
msgid ""
"<qt>Calibration is about to check the precision.<br><br><b>Please move all "
"axes to their center position and then don't touch the joystick anymore.</"
"b><br><br>Click OK to start the calibration.</qt>"
msgstr ""
"<qt>Por esplori la precizecon vi necesas la kalibrecon. "
"<br><br><b>Movu ĉiujn aksojn al siaj mezaj pozcioj kaj ne plu tuŝu la stirstangon.</b> "
"<br><br>Kliku \"Konfirmu\" por lanĉi la kalibrecon.</qt>"

