#: kio_sftp.cpp:294
msgid "Opening connection to host <b>%1:%2</b>"
msgstr "Malfermante konekton al komputilo <b>%1:%2</b>"

#: kio_sftp.cpp:355
msgid "Sftp Login"
msgstr "SFTP-Saluto"

#: kio_sftp.cpp:357
msgid "site:"
msgstr "retejo:"

#: kio_sftp.cpp:369
msgid "Login failed. Retrying..."
msgstr "Saluto malsukcesis. Reprovante..."

#: kio_sftp.cpp:391
msgid "Please enter your username and password."
msgstr "Bonvolu doni vian salutnomon kaj pasvorton."

#: kio_sftp.cpp:394
msgid ""
"Login failed.\n"
"Please confirm your username and password, and enter them again."
msgstr ""
"Saluto malsukcesis.\n"
"Bonvolu kontroli vian salutnomon kaj pasvorton kaj reprovi."

#: kio_sftp.cpp:399
msgid "Please enter a username and password"
msgstr "Bonvolu doni salutnomon kaj pasvorton"

#: kio_sftp.cpp:419
msgid "Connection failed."
msgstr "Kontakto malsukcesis."

#: kio_sftp.cpp:425
msgid "Warning: Host key not found!"
msgstr "Averto: Komputilo ne troviĝis!"

#: kio_sftp.cpp:429
msgid "Warning: Host key has changed!"
msgstr "Averto: Komputiloŝlosilo ŝanĝiĝis!"

#: kio_sftp.cpp:440
msgid "Shall we continue connecting to %1?"
msgstr "Ĉu daŭrigi kontaktadon al %1?"

#: kio_sftp.cpp:457
msgid "Connected to "
msgstr "Konektita al "

#: kio_sftp.cpp:488
msgid "Timed out waiting for a response from the server."
msgstr "La servo ne respondis ene de difinita tempolimo."

#: kio_sftp.cpp:501
msgid "Login failed."
msgstr "Saluto malsukcesis."

#: kio_sftp.cpp:503
msgid ""
"Could not login to %1.\n"
"Maximum number of retries exceeded."
msgstr ""
"Ne eblis saluti al %1.\n"
"Jam provis difinitan maksimumom da fojoj."

#: kio_sftp.cpp:531
msgid "Login OK"
msgstr "Saluto sukcesis"

