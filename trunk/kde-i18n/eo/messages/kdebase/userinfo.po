#: userinfo.cpp:113
msgid ""
"Click on this button to change your real name. Your password will be "
"required."
msgstr "Kliku tiun butonon por ŝanĝi vian realnomon. Vi necesas vian pasvorton."

#: userinfo.cpp:114
msgid "Click on this button to change your password."
msgstr "Kliku tiun butonon por ŝanĝi vian pasvorton."

#: userinfo.cpp:137 userinfo_chface.cpp:110
