#: main.cpp:30
msgid "Printer/destination to print on"
msgstr "Prescelo"

#: main.cpp:32
msgid "Title/Name for the print job"
msgstr "Titolo/Nomo por la presotasko"

#: main.cpp:34
msgid "Number of copies"
msgstr "Nombro da kopioj"

#: main.cpp:35
msgid "Printer option"
msgstr "Presopcio"

#: main.cpp:36
msgid "Job output mode (gui, console, none)"
msgstr "Taskeligmaniero (grafike, konzolo, neniu)"

#: main.cpp:37
msgid "Print system to use (lpd, cups)"
msgstr "Uzenda presosistemo (lpd, cups)"

#: main.cpp:38
msgid "Allow printing from STDIN"
msgstr "Permesu presadon el normala enigo (STDIN)"

#: main.cpp:39
msgid "Do not show the print dialog (print directly)."
msgstr "Ne montru la presdialogon (presu tuj)."

#: main.cpp:40
msgid "Files to load"
msgstr "Legendaj dosieroj"

#: main.cpp:46
msgid "A printer tool for KDE"
msgstr "Presilo por KDE"

#: printwrapper.cpp:55
msgid "Print information"
msgstr "Presinformo"

#: printwrapper.cpp:56 printwrapper.cpp:63
msgid "Print warning"
msgstr "Presaverto"

#: printwrapper.cpp:57 printwrapper.cpp:63
msgid "Print error"
msgstr "Preseraro"

#: printwrapper.cpp:63
msgid "Print info"
msgstr "Presinformo"

#: printwrapper.cpp:138
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr "Doniĝis dosiero en la komandlinio. Presado de STDIN estas malŝaltata."

#: printwrapper.cpp:143
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"Se vi uzas '--nodialog', vi devas doni almenaŭ unu dosieron presendan aŭ "
"uzi la argumenton '--stdin'."

#: printwrapper.cpp:164
msgid "The specified printer or the default printer could not be found."
msgstr "La donita presilo aŭ apriora presilo ne troviĝis."

#: printwrapper.cpp:166
msgid "Operation aborted."
msgstr "Operacio haltigita."

#: printwrapper.cpp:188
msgid "Unable to construct the print dialog."
msgstr "Ne eblas konstrui la presodialogon."

#: printwrapper.cpp:217
msgid ""
"Can't print from STDIN: use '--stdin' option, or specify a file to print in "
"the file selection area."
msgstr ""
"Ne eblas presi de STDIN: uzu la argumenton '--stdin' aŭ donu presendan "
"dosieron en la dosierelektejo."

#: printwrapper.cpp:242
msgid "Unable to open temporary file."
msgstr "Ne eblas malfermi provizoran dosieron"

#: printwrapper.cpp:254
msgid "Stdin is empty, no job sent."
msgstr "Normala enigo (STDIN) estas malplena, neniu tasko sendita."

#: printwrapper.cpp:269
msgid "Error while printing files"
msgstr "Eraro dum presado de dosieroj"

#: printwrapper.cpp:272
msgid "<nobr>File(s) sent to printer <b>%1</b>.</nobr>"
msgstr "<nobr>Dosiero(j) sendita(j) al presilo <b>%1</b>.</nobr>"
