#: kfmclient.cc:50
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"Sintakso:\n"

#: kfmclient.cc:51
msgid ""
"  kfmclient openURL\n"
"            # Opens a dialog to ask you for the URL\n"
"\n"
msgstr ""
"  kfmclient openURL\n"
"            # malfermas dialogon por entajpi URLon\n"
"\n"

#: kfmclient.cc:53
msgid ""
"  kfmclient openURL 'url'\n"
"            # Opens a window showing 'url'. If such a window\n"
msgstr ""
"  kfmclient openURL \"url\"\n"
"            # malfermas fenestron montrantan la dokumenton sub la URL\n"

#: kfmclient.cc:55
msgid ""
"            #   exists, it is shown. 'url' may be \"trash:/\"\n"
"            #   to open the trash bin.\n"
"\n"
msgstr ""
"            # se jam ekzistas tia fenstro, øi estas montrata. Kiel\n"
"            # URL vi povas indiki \"trash:/\" por malfermi la rubujon.\n"
"\n"

#: kfmclient.cc:57
msgid ""
"  kfmclient openProperties 'url'\n"
"            # Opens a properties menu\n"
"\n"
msgstr ""
"  kfmclient openProperties \"url\"\n"
"            # malfermas la eco-menuon\n"
"\n"

#: kfmclient.cc:59
msgid ""
"  kfmclient exec ['url' ['binding']]\n"
"            # Tries to execute 'url'. 'url' may be a usual\n"
"            #   URL, this URL will be opened. You may omit\n"
"            #   'binding'. In this case the default binding\n"
msgstr ""
"  kfmclient exec [\"url\" [\"binding\"]}\n"
"            # provas lanæi URLon, kiu povas esti normala URLo\n"
"            # Se vi forlasas \"binding\" la implicita estas uzata\n"

#: kfmclient.cc:63
msgid ""
"            #   is tried. Of course URL may be the URL of a\n"
"            #   document, or it may be a *.desktop file.\n"
msgstr ""
"            # La URL povas referenci kompreneble al dokumento aý\n"
"            # al *.desktop-dosiero.\n"

#: kfmclient.cc:65
msgid ""
"            #   This way you could for example mount a device\n"
"            #   by passing 'Mount default' as binding to \n"
"            #   'cdrom.desktop'\n"
"\n"
msgstr ""
"            # Tiel vi ekzemple povus kroæi aparaton tajpante ekz.\n"
"            # exec \"cdrom.desktop\" \"Mount default\".\n"
"\n"

#: kfmclient.cc:68
msgid ""
"  kfmclient move 'src' 'dest'\n"
"            # Moves the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
msgstr ""
"  kfmclient move \"src\" \"dest\"\n"
"            # þovas la URL on \"src\" al \"dest\".\n"
"            # \"src\" povas esti listo de URLoj.\n"

#: kfmclient.cc:71
msgid ""
"            #   'dest' may be \"trash:/\" to move the files\n"
"            #   in the trash bin.\n"
"\n"
msgstr ""
"            # \"dest\" povas esti \"trash:/\" por þovi dosierojn\n"
"            # en la rubujon.\n"
"\n"

#: kfmclient.cc:73
msgid ""
"  kfmclient copy 'src' 'dest'\n"
"            # Copies the URL 'src' to 'dest'.\n"
"            #   'src' may be a list of URLs.\n"
"\n"
msgstr ""
"  kfmclient copy \"src\" \"dest\"\n"
"            # kopias la URLo(j)n \"src\" al \"dest\"\n"
"\n"

#: kfmclient.cc:76
msgid ""
"  kfmclient sortDesktop\n"
"            # Rearranges all icons on the desktop.\n"
"\n"
msgstr ""
"  kfmclient sortDesktop\n"
"            # rearanøas la piktogramojn sur la labortabulo.\n"
"\n"

#: kfmclient.cc:78
msgid ""
"  kfmclient selectDesktopIcons x y w h add\n"
"            # Selects the icons on the desktop in the given rectangle\n"
"            # If add is 1, adds selection to the current one\n"
"\n"
msgstr ""
"  kfmclient selectDesktopIcons x y w h add\n"
"            # elektas la piktogramojn sur la labortabulo en la donita\n"
"            # rektangulo, sed add estas 1, tiam la elekto estas aldonita\n"
"            # al la jama.\n"
"\n"


#: kfmclient.cc:81
msgid ""
"  kfmclient configure\n"
"            # Re-read konqueror's configuration.\n"
"\n"
msgstr ""
"  kfmclient configure\n"
"            # Relegas la agorda¼on de Konkeranto.\n"

#: kfmclient.cc:83
msgid ""
"  kfmclient configureDesktop\n"
"            # Re-read kdesktop's configuration.\n"
"\n"
msgstr ""
"  kfmclient configureDesktop\n"
"            # relegas la agorda¼on de KDesktop.\n"
"\n"

#: kfmclient.cc:86
msgid ""
"*** Examples:\n"
"  kfmclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // Mounts the CDROM\n"
"\n"
msgstr ""
"*** Ekzemploj:\n"
"  kfmclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
"             // kroæas la lumdiskon\n"
"\n"

#: kfmclient.cc:89
msgid ""
"  kfmclient exec file:/home/weis/data/test.html\n"
"             // Opens the file with default binding\n"
"\n"
msgstr ""
"  kfmclient exec file:/home/weis/data/test.html\n"
"             // malfermas la dosieron kun la implicita aplika¼o\n"
"\n"

#: kfmclient.cc:91
msgid ""
"  kfmclient exec file:/home/weis/data/test.html Netscape\n"
"             // Opens the file with netscape\n"
"\n"
msgstr ""
"  kfmclient exec file:/home/weis/data/test.html Netscape\n"
"             // malfermas la doserion kun Netscape\n"
"\n"

#: kfmclient.cc:93
msgid ""
"  kfmclient exec ftp://localhost/\n"
"             // Opens new window with URL\n"
"\n"
msgstr ""
"  kfmclient exec ftp://localhost/\n"
"             // malfermas novan fenestron kun la URLo\n"
"\n"

#: kfmclient.cc:95
msgid ""
"  kfmclient exec file:/root/Desktop/emacs.desktop\n"
"             // Starts emacs\n"
"\n"
msgstr ""
"  kfmclient exec file:/root/Desktop/emacs.desktop\n"
"             // Lanæas Emacs\n"
"\n"

#: kfmclient.cc:97
msgid ""
"  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Opens the CD-ROM's mount directory\n"
"\n"
msgstr ""
"  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
"             // malfermas la kroædosierujon de la lumdisko\n"
"\n"

#: kfmclient.cc:130 kfmclient.cc:198 kfmclient.cc:217
msgid "Syntax Error: Too few arguments\n"
msgstr "Sintakseraro: Mankas argumento(j)\n"

#: kfmclient.cc:146 kfmclient.cc:236 kfmclient.cc:267 kfmclient.cc:277
msgid "Syntax Error: Too many arguments\n"
msgstr "Sintakseraro: Tro multaj argumentoj\n"

#: kfmclient.cc:160 kfmclient.cc:190 kfmclient.cc:259
msgid "Syntax Error: Wrong number of arguments\n"
msgstr "Sintakseraro: Maløusta nombro de argumentoj\n"

#: kfmclient.cc:286
#, c-format
msgid "Syntax Error: Unknown command '%s'\n"
msgstr "Sintakseraro: Nekonata komando \"%s\"\n"


