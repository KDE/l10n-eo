#: knewthemedlg.cpp:28
msgid "New Theme"
msgstr "Nova etoso"

#: kthememanager.cpp:154 kthememanager.cpp:403
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr "Tiu stirmodulo organizas instalon, forigon kaj kreon de KDEaj etosoj."

#: kthememanager.cpp:199
msgid "Theme Files"
msgstr "Etosodosieroj"

#: kthememanager.cpp:200
msgid "Select Theme File"
msgstr "Elektu etosodosieron"

#: kthememanager.cpp:233
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "Ĉu vi vere volas forigi la etoson <b>%1</b>?"

#: kthememanager.cpp:234
msgid "Remove Theme"
msgstr "Forigu etoson"

#: kthememanager.cpp:255
msgid "My Theme"
msgstr "Mia etoso"

#: kthememanager.cpp:266
msgid "Theme %1 already exists."
msgstr "Etoso %1 jam ekzistas."

#: kthememanager.cpp:285
#, c-format
msgid "Your theme has been successfully created in %1."
msgstr "Via etoso sukcese estas kreita en %1."

#: kthememanager.cpp:286
msgid "Theme Created"
msgstr "Etoso kreita"

#: kthememanager.cpp:288
msgid "An error occured while creating your theme."
msgstr "Etoskreo fiaskis."

#: kthememanager.cpp:289
msgid "Theme Not Created"
msgstr "Etoso ne kreita"

#: kthememanager.cpp:316
msgid "This theme doesn't contain a preview."
msgstr "Tiu etoso ne enhavas antaŭrigardaĵon."

