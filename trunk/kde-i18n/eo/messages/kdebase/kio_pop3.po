#: pop3.cc:157
msgid "No response from POP3 server in 600 secs."
msgstr "Neniu respondo de la POP3-servilo dum 600 sekundoj."

#: pop3.cc:197
msgid "PASS <your password>"
msgstr "PASS <via pasvorto>"

#: pop3.cc:199
msgid ""
"I said:\n"
"   \"%1\"\n"
"\n"
"And then the server said:\n"
"   \"%2\""
msgstr ""
"Mi diris:\n"
"   \"%1\"\n"
"\n"
"Kaj la servilo respondis:\n"
"   \"%2\""

#: pop3.cc:207
msgid "The server terminated the connection."
msgstr "La servilo finis la kontakton."

#: pop3.cc:208
msgid ""
"Invalid response from server:\n"
"   \"%1\""
msgstr ""
"Nevalida respondo de la servilo:\n"
"   \"%1\""

#: pop3.cc:233
msgid "Could not send to server.\n"
msgstr "Ne eblis sendi al servilo.\n"

#: pop3.cc:286 pop3.cc:449 pop3.cc:465
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Ne eblis saluti al %1.\n"
"\n"

#: pop3.cc:287
msgid "The server terminated the connection immediately."
msgstr "La servilo finis la konekton subite."

#: pop3.cc:287
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"La servilo ne responda ĝuste:\n"
"%1\n"

#: pop3.cc:320
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful.  "
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"Via POP3-servilo asertas subteni TLS, sed la negocado malsukcesis. "
"Vi povas malaktivigi TLS en KDE per la agordmodulo Ĉifrado."

#: pop3.cc:331
msgid ""
"Your POP3 server does not support TLS. Disable\n"
"TLS, if you want to connect without encryption."
msgstr ""
"Via POP3-servilo ne subtenas TLS. Malaktivigu\n"
"TLS, se vi volas kontakti ĝin sen ĉifrado."

#: pop3.cc:342
msgid "Username and password for your POP3 account:"
msgstr "Uzantonomo kaj pasvorto de via POP3-konto:"

#: pop3.cc:590 pop3.cc:627 pop3.cc:640 pop3.cc:652 pop3.cc:660 pop3.cc:665
#: pop3.cc:723
msgid "Unexpected response from POP3 server."
msgstr "Neatendita respondo de la POP3-servilo."

#: pop3.cc:697
msgid "Couldn't login."
msgstr "Ne eblis saluti."

