#: kcmsmserver.cpp:130
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed, whether the session should be restored again when logging in and "
"whether the computer should be automatically shut down after session exit by "
"default."
msgstr ""
"<h1>Seancadministrilo</h1> Vi povas agordi la seancoadministrilon tie ĉi. "
"Tio estas ekzemple, ĉu adiaŭo okazos nur post konfirmo, ĉu la seanco "
"konserviĝu kaj ĉu normale la komputilo aŭtomate malŝaltiĝu post fino de "
"la seanco."

#: rc.cpp:1
msgid "Session Manager"
msgstr "Seancoadministrilo"

#: rc.cpp:2
msgid "General"
msgstr "Ĝenerale"

#: rc.cpp:3
msgid "Conf&irm logout"
msgstr "Konfirmu &adiaŭon"

#: rc.cpp:4
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr "Enŝaltu, se la seancoadministrilo montru adiaŭokonfirman dialogfenestron."

#: rc.cpp:5
msgid "On Login"
msgstr "Ĉe saluto"

#: rc.cpp:6
msgid "Restore &previous session"
msgstr "&Restarigu antaŭan seancon"

#: rc.cpp:7
msgid "Restore &manually saved session"
msgstr "Restarigu &mane konservitan seancon"

#: rc.cpp:8
msgid "Start with an &empty session"
msgstr "Komencu kun &malplena seanco"

#: rc.cpp:9
msgid "Default Action After Logout"
msgstr "Apriora ago post seancofino"

#: rc.cpp:10
msgid ""
"Here you can choose what should happen by default when you log out. This "
"only has meaning, if you logged in through KDM."
msgstr ""
"Tie ĉi vi povas elekti, kio okazu normale ĉe seancofino. Tio havas "
"signifon nur se vi lanĉis KDE per la grafika salutilo \"KDM\"."

#: rc.cpp:11
msgid "&Login as different user"
msgstr "&Salutu kiel alia uzanto"

#: rc.cpp:12
msgid "&Turn off computer"
msgstr "&Malŝaltu komputilon"

#: rc.cpp:13
msgid "&Restart computer"
msgstr "&Relanĉu komputilon"

#~ msgid "&Save session for future logins"
#~ msgstr "&Konservu seancon ĝis estonta saluto"

#~ msgid ""
#~ "Check this option if you want the session manager to save the running "
#~ "session when logging out. At login time the last saved session will be "
#~ "restored."
#~ msgstr ""
#~ "Elektu tion, se la seancoadministrilo konservu la nunan seancon dum "
#~ "adiaŭo. Ĉe la sekva saluto restariĝas la lasta konservita seanco."
