#: kcmsmserver.cpp:37
msgid "Confirm &logout"
msgstr "Konfirmu &adiaŭon"

#: kcmsmserver.cpp:39
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr "Enŝaltu, se la seancoadministrilo montru adiaŭokonfirman dialogfenestron."

#: kcmsmserver.cpp:43
msgid "&Restore previous session when logging in"
msgstr "&Restarigu antaŭan senacon ĉe saluto"

#: kcmsmserver.cpp:45
msgid ""
"Check this option if you want the session manager to save the running "
"session when logging out and restore it on the next login."
msgstr ""
"Enŝaltu, se la seancoadministrilo sekurigu la nunan seancon dum "
"adiaŭo kaj restarigu ĝin ĉe la sekva saluto."

#: kcmsmserver.cpp:101
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed and if the previous session should be restored when logging in."
msgstr ""
"<h1>Seancadministrilo</h1> Vi povas agordi la seancoadministrilon "
"tie ĉi. Tio estas ekzemple, ĉu ĉe adiaŭo prezentiĝu konfirma dialogo kaj "
"ĉu la antaŭa seanco estu restarigata ĉe saluto."

