#: legacyimport.cpp:24
msgid ""
"<QT><b>Legacy Theme Importer</b><P>KDE now supports utilizing older themes fr"
"om other platforms in your new KDE desktop. The most common type of legacy th"
"eme is for the GTK toolkit, which is imported to KDE's Control Center with th"
"is utility.<P>In order to do this you must specify at least one item: the fol"
"der where the pixmaps for the theme is located. You may also have to specify "
"the  theme's gtkrc file if it's not in the same folder as the pixmaps. Both a"
"re usually in the folder \"gtk\" inside the theme's directory.</QT>"
msgstr ""
"<QT><b>Importilo por fremdaj etosoj</b><P>KDE nun subtenas importi etosojn de"
" aliaj medioj en vian KDE-Tabulmedion. La plej konata tipo de fremdaj etosoj "
"estas la GTKaj, kiujn vi povas importi al la KDEa Stircentro per tiu ĉi prog"
"ramo.<P>Por fari tion vi devas aldoni almenaŭ unu aferon: la dosierujon, kie"
" la grafikoj por la etoso troviĝas. Eble vi devas doni ankaŭ la gtkrc-dosie"
"ron, se ĝi ne troviĝas en la sama dosierujo. Ambaŭ normale estas en la dos"
"ierujo \"gtk\" ene de laetosdosierujo.</QT>"

#: legacyimport.cpp:34
msgid "Step 1: Specify theme's pixmap folder:"
msgstr "Paŝo 1: Donu la dosierujon kun la etosografikoj:"

#: legacyimport.cpp:37 legacyimport.cpp:63
msgid "Browse"
msgstr "Rigardu"

#: legacyimport.cpp:52
msgid "Specify pixmap directory"
msgstr "Donu grafikodosierujon"

#: legacyimport.cpp:56
msgid ""
"<QT><b>Legacy Theme Importer</b><P>A gtkrc file was not found in the specifie"
"d directory. If it exists somewhere other than where the pixmaps are located "
"enter it here.</QT>"
msgstr ""
"<QT><b>Importilo por fremdaj etosoj</b><P>gtkrc-dosiero ne troviĝis en la do"
"nita dosierujo. Se ĝi troviĝas ie aliloke ol la grafikoj, donu ĝin tie ĉi"
".</QT>"

#: legacyimport.cpp:60
msgid "Step 2: Specify theme's gtkrc:"
msgstr "Paŝo 2: Donu la \"gtkrc\"-dosieron de la etoso:"

#: legacyimport.cpp:77
msgid "Specify gtkrc directory"
msgstr "Donu gtkrc-dosierujon"

#: legacyimport.cpp:86
msgid "Legacy Import"
msgstr "Importo de fremdaj etosoj"

#: legacyimport.cpp:94
msgid "GTK theme's folder"
msgstr "GTK-etosdosierujo"

#: legacyimport.cpp:118 legacyimport.cpp:139
msgid "You did not enter a valid file!"
msgstr "Vi ne donis validan dosieron!"

#: legacyimport.cpp:126
msgid "Gtkrc theme file"
msgstr "Gtkrc-etosdosiero"

#: legacyimport.cpp:146
msgid "Theme title"
msgstr "Etostitolo"

#: legacyimport.cpp:147
msgid "Please enter a short title for this theme"
msgstr "Bonvolu doni mallongan titolon por tiu etoso"

#: legacyimport.cpp:155
msgid "Legacy widget theme"
msgstr "Fremda etoso"

#: legacyimport.cpp:161
msgid "The theme is now installed and will be shown in KDE's control center."
msgstr "La etoso nun estas instalita kaj aperos en la KDE-Stircentro."

#: legacyimport.cpp:168
msgid "KLegacyImport"
msgstr "KEtosimporto"

#: legacyimport.cpp:169
msgid "Importer for legacy themes"
msgstr "Importilo por fremdaj etosoj"
