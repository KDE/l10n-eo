#: main.cpp:45
msgid "KFM Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KFM-Lanĉo - MAlfermas forajn dosierojn, observas ŝanĝojn, demandas pri "
"alŝuto."

#: main.cpp:51
msgid "Command to execute."
msgstr "Komando lanĉenda."

#: main.cpp:52
msgid "URL(s) or local file used for 'command'."
msgstr "URLo(j) aŭ lokaj dosieroj uzataj kiel 'komando'."

#: main.cpp:68
msgid "'command' expected.\n"
msgstr "'komando' atendita.\n"

#: main.cpp:93
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"La URLo %1\n"
"estas misformita"

#: main.cpp:184
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"La dosiero\n"
"%1\n"
"estas ŝanĝita.\n"
"Ĉu vi volas alŝuti la ŝanĝojn?"

#: main.cpp:185
msgid "File changed"
msgstr "Dosiero ŝanĝita"

#: main.cpp:247
msgid "KFMExec"
msgstr "KFM-Lanĉo"

#: main.cpp:262
msgid ""
"Syntax Error:\n"
"kfmexec command [URLs ....]"
msgstr ""
"Sintakseraro:\n"
"kfmexec komando [URLoj ...]"
