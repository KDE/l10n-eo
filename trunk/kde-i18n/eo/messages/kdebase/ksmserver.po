#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"La fidinda KDE-seancadministrilo parolanta la norman X11R6-seancadministran "
"protokolon XSMP."

#: main.cpp:35
msgid "Restores the previous session if available"
msgstr "Restarigu la antaŭan seancon, se ekzistas"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Lanĉas 'wm', se neniu alia fenstroadministrilo partumas\n"
"en la seanco. Normale estas uzata 'kwin'"

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Permesu ankaŭ traretajn kontaktojn."

#: main.cpp:166
msgid "The KDE Session Manager"
msgstr "La KDE-Seanco-administrilo"

#: shutdown.cpp:81
#, c-format
msgid "End session for %1"
msgstr "Finu seancoj por %1"

#: shutdown.cpp:105
msgid "What do you want to do next?"
msgstr "Kion vi volas fari sekve?"

#: shutdown.cpp:106
msgid "&Login as different user"
msgstr "&Saluti kiel alia uzanto"

#: shutdown.cpp:107
msgid "&Turn off computer"
msgstr "&Malŝalti la komputilon"

#: shutdown.cpp:108
msgid "&Restart computer"
msgstr "&Relanĉi la komputilon"

#: shutdown.cpp:121
msgid "Shutdown mode"
msgstr "Adiaŭomaniero"

#: shutdown.cpp:122
msgid "Sch&edule"
msgstr "&Planu"

#: shutdown.cpp:124
msgid "&Force Now"
msgstr "&Devigu nun"

#: shutdown.cpp:125
msgid "&Try Now"
msgstr "&Provu nun"

#: shutdown.cpp:130
msgid "&Save session for future logins"
msgstr "&Konservu seancon por estonta saluto"

#: shutdown.cpp:138
msgid "&Logout"
msgstr "&Adiaŭu"
