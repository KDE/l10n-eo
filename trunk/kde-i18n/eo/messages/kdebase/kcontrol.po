#: dockcontainer.cpp:43 modules.cpp:146
msgid "<big>Loading ...</big>"
msgstr "<big>Legante...</big>"

#: dockcontainer.cpp:77
msgid ""
"There are unsaved changes in the active module.\n"
"Do you want to apply the changes before running\n"
"the new module or forget the changes?"
msgstr ""
"Vi ne sekurigis ŝanĝojn en la aktiva modulo.\n"
"Ĉu vi volas apliki la ŝanĝojn antaŭ aktivigo de\n"
"la nova modulo aŭ ĉu forgesi la ŝanĝojn?"

#: dockcontainer.cpp:82
msgid ""
"There are unsaved changes in the active module.\n"
"Do you want to apply the changes before exiting\n"
"the Control Center or forget the changes?"
msgstr ""
"Vi ne sekurigis ŝanĝojn en la aktiva modulo.\n"
"Ĉu vi volas apliki la ŝanĝojn antaŭ forlaso de\n"
"la Stircentro aŭ ĉu forgesi la ŝanĝojn?"

#: dockcontainer.cpp:87
msgid "Unsaved changes"
msgstr "Nesekurigitaj ŝanĝoj"

