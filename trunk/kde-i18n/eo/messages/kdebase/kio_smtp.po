#: smtp.cc:249 smtp.cc:303
msgid "The sender address is missing."
msgstr "La sendinto-adreso mankas."

#: smtp.cc:259
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "La funkcio SMTPProtocol::smtp_open malsukcesis (%1)"

#: smtp.cc:264
#, c-format
msgid ""
"The server didn't accept the sender address:\n"
"%1"
msgstr ""
"La servilo ne akceptis la sendinto-adreson:\n"
"%1"

#: smtp.cc:281
#, c-format
msgid ""
"The attempt to start sending the message content failed.\n"
"The server said:\n"
"%1"
msgstr ""
"La provo eksendi la mesaĝenhavon malsukcesis.\n"
"La servo diris:\n"
"%1"

#: smtp.cc:347
#, c-format
msgid ""
"The server didn't accept the message content:\n"
"%1"
msgstr ""
"La servo ne akceptis la mesaĝenhavon:\n"
"%1"

#: smtp.cc:364
msgid ""
"The server didn't accept one of the recipients.\n"
"It said: "
msgstr ""
"La servo ne akceptis unu el la ricevontoj.\n"
"Ĝi diris: "

#: smtp.cc:417 smtp.cc:437
msgid "Invalid SMTP response received."
msgstr "Riceviĝis nevalida SMTP-respondo."

#: smtp.cc:463
#, c-format
msgid "Invalid SMTP response received: %1"
msgstr "Riceviĝis nevalida SMTP-respondo: %1"

#: smtp.cc:479
msgid ""
"Could not send to server.\n"
msgstr ""
"Ne eblis sendi al servilo.\n"

#: smtp.cc:500
#, c-format
msgid "The server didn't accept the connection: %1"
msgstr "La servilo ne akceptis la konekton: %1"

#: smtp.cc:525 smtp.cc:559
#, c-format
msgid "The server said: %1"
msgstr "La servilo diris: %1"

#: smtp.cc:548
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"Via SMTP-servo asertas subteni TLS, sed la marĉandado ne sukcesis.\n"
"Vi povas malsalti TLS en la KDE-Stircentro per la ĉifromodulo ."

#: smtp.cc:553
msgid "Connection Failed"
msgstr "Konekto malsukcesis"

#: smtp.cc:566
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"Via SMTP-servo ne subtenas TLS. Malŝalut TLS, se vi volas konekti sen "
"ĉifrado."

#: smtp.cc:577
msgid "Username and password for your SMTP account:"
msgstr "Salutnomo kaj pasvorto por via SMTP-konto:"

#: smtp.cc:579
msgid "When prompted, you ran away."
msgstr "Kiam invitite, vi forkuris."

#: smtp.cc:628
msgid "No compatible authentication methods found."
msgstr "Neniu kongrua legitimig-metodo troviĝis."

#: smtp.cc:640
msgid ""
"Your SMTP server doesn't support %1.\n"
"Choose a different authentication method."
msgstr ""
"Via SMTP-servilo ne subtenas %1.\n"
"Elektu alian legitmigometodon."

#: smtp.cc:661
#, c-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server said: %1"
msgstr ""
"Legitimigo malsukcesis.\n"
"Plej verŝajne la pasvorto estas malĝusta.\n"
"La servilo diris: %1"
