"Name=La aplikaĵo %progname (%appname), procezo-n-ro %pid, mortis kaj "
"kaŭzis la signalon %signum (%signame)."

#: kdebase/drkonqi/presets/developerrc:1
msgid "Name=You might want to fix your program. Take a look at the backtrace tab."
msgstr "Name=Eble vi volas korekti vian programon. Rigardu sur la paĝon Reŝpurado."

