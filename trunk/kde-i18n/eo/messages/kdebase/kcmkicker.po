msgid "&K menu:"
msgstr "&K menuo:"

#: rc.cpp:69 rc.cpp:89
msgid "Choose a tile image for the K menu."
msgstr "Elektas kvadratspecon por la K-Menuo."

#: rc.cpp:70
msgid "&Legacy applications:"
msgstr "&Konvenciaj aplikaĵoj:"

#: rc.cpp:71 rc.cpp:79
msgid "Choose a tile image for legacy application buttons."
