#: kgreeter.cpp:549
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile for more information\n"
"or contact your system administrator."
msgstr ""
"Okazis grava eraro.\n"
"Bonvolu rigardi en la protokoldosieron de KDM por pliaj informoj\n"
"aŭ kontaktu vian sistemestron."

#: kgreeter.cpp:554
msgid "Home directory not available."
msgstr "Hejmdosierujo ne estas alirebla."

#: kgreeter.cpp:557
msgid "Root logins are not allowed."
msgstr "Sistemestro-salutoj ne estas permesitaj."

#: kgreeter.cpp:561
msgid "Your login shell is not listed in /etc/shells."
msgstr "Via salut-ŝelo ne estas listigita en /etc/shells."

#: kgreeter.cpp:564
msgid "Your account has expired."
msgstr "Via konto malvalidiĝis"

#: kgreeter.cpp:567
msgid "Your password has expired."
msgstr "Via pasvorto malvalidiĝis."

#: kgreeter.cpp:570
msgid ""
"You are not allowed to login\n"
"at the moment."
msgstr ""
"Al vi ne estas permesata\n"
"saluti momente."

#: kgreeter.cpp:587
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Ne estas permesata saluti momente.\n"
"Provu iom poste."

#: kgreeter.cpp:622
msgid "Your account expires today."
msgstr "Via konto malvalidiĝas hodiaŭ."

#: kgreeter.cpp:624
msgid "Your account expires tomorrow."
msgstr "Via konto malvalidiĝos morgaŭ."

#: kgreeter.cpp:627
msgid "Your account expires in %1 days."
msgstr "Via konto malvalidiĝos post %1 tagoj."

#: kgreeter.cpp:632
msgid "Your password expires today."
msgstr "Via pasvorto malvalidiĝas hodiaŭ."

#: kgreeter.cpp:634
msgid "Your password expires tomorrow."
msgstr "Via pasvorto malvalidiĝos morgaŭ."

#: kgreeter.cpp:637
msgid "Your password expires in %1 days."
msgstr "Via pasvorto malvalidiĝos post %1 tagoj."
