msgid "Login:"
msgstr "Uzantonomo:"

#: kgreeter.cpp:324
msgid "Password:"
msgstr "Pasvorto:"

#: kgreeter.cpp:327
msgid "Session Type:"
msgstr "Seancotipo:"

#: kgreeter.cpp:356
msgid "G&o!"
msgstr "&Ek!"

#: kgreeter.cpp:361
msgid "&Clear"
msgstr "&Purigu"

#: kgreeter.cpp:367
msgid "C&hooser"
msgstr "&Elektilo"

#: kgreeter.cpp:373
msgid "R&estart X Server"
msgstr "&Relanĉu la X-servilon"

#: kgreeter.cpp:373
msgid "Clos&e Connection"
msgstr "&Fermu kontakton"

#: kgreeter.cpp:384
msgid "&Shutdown..."
msgstr "&Adiaŭu..."

#: kgreeter.cpp:651
msgid "Could not access the login capabilities database or out of memory."
msgstr "Ne eblis aliri la datumbazo pri saluteblecoj, aŭ nesufiĉo de memoro"

#: kgreeter.cpp:655
msgid "Home directory not available."
msgstr "Hejmdosierujo ne estas alirebla."

#: kgreeter.cpp:659
msgid "Root logins are not allowed."
msgstr "Sistemestro-salutoj ne estas permesitaj."

#: kgreeter.cpp:663
msgid "Your login shell is not listed in /etc/shells."
msgstr "Via salut-ŝelo ne estas listigita en /etc/shells."

#: kgreeter.cpp:667
msgid "Your account has expired."
msgstr "Via konto malvalidiĝis"

#: kgreeter.cpp:671
msgid "Your password has expired."
msgstr "Via pasvorto malvalidiĝis."

#: kgreeter.cpp:675
msgid "You are not allowed to login at the moment."
msgstr "Al vi ne estas permesata saluti momente."

#: kgreeter.cpp:689
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Ne estas permesata saluti momente.\n"
"Provu iom poste."

#: kgreeter.cpp:695
#, c-format
msgid "Your account expires on %1."
msgstr "Via konto malvalidiĝos je %1"

#: kgreeter.cpp:701
#, c-format
msgid "Your password expires on %1."
msgstr "Via pasvorto malvalidiĝos je %1."

#: kgreeter.cpp:714
msgid "Login failed!"
msgstr "Saluto malsukcesis!"

#: kgreeter.cpp:1006
msgid ""
"Startup program %1 exited with non-zero status.\n"
"Please contact your system administrator.\n"
"Please press OK to retry."
msgstr ""
"Laĉita programo %1 finis kun nenula stato.\n"
"Bonvolu kontakti vian sistemadministranton.\n"
"Bonvolu premi OK por reprovi."

#: liloinfo.cpp:335
msgid "No next option found!"
msgstr "Ne troviĝis sekva opcio!"

#: liloinfo.cpp:338
msgid "Next option not found in option list!"
msgstr "Sekva opcio ne troviĝis en la opciolisto!"

#: liloinfo.cpp:341
msgid "Lilo hack is not enabled!"
msgstr "Lilo-kodumo ne estas enŝaltita!"

#: liloinfo.cpp:344
msgid "Attempted to write invalid next boot option!"
msgstr "Skribprovo de nevalida sekva startopcio!"

#: liloinfo.cpp:347
msgid "Lilo location is a non-existing file."
msgstr "Ĉe loko de \"Lilo\" ne troviĝas ekzistanta dosiero."

#: liloinfo.cpp:350
msgid "Boot map location is a non-existing file."
msgstr "Ĉe loko de \"Boot map\" ne troviĝas ekzistanta dosiero."

#: liloinfo.cpp:353
msgid "Unknown error!"
msgstr "Nekonata eraro!"
