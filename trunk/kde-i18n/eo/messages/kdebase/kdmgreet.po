msgid "Shutdown or reboot?"
msgstr "Ĉu adiaŭi aŭ relanĉi?"

#: kdmshutdown.cpp:106
msgid "(Enter Root Password)"
msgstr "(Entajpu la pasvorton de la sistemestro)"

#: kdmshutdown.cpp:125
msgid "&Shutdown"
msgstr "&Adiaŭu"

#: kdmshutdown.cpp:142
msgid "&Reboot"
msgstr "&Relanĉu"

#: kdmshutdown.cpp:171
msgid "Console &Mode"
msgstr "Konzola &moduso"

#: kgreeter.cpp:132
msgid "KDE Display Manager"
msgstr "KDE-Ekranadministrilo"

