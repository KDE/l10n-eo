#: kio_smb.cpp:200 kio_smb.cpp:214 kio_smb.cpp:403 kio_smb.cpp:433
#: kio_smb.cpp:1180 kio_smb.cpp:1211
msgid ""
"\n"
"Make sure that the samba package is installed properly on your system."
msgstr ""
"\n"
"Certigu, ke la Sambo-pakaĵo estas ĝuste instalita en via sistemo."

#: kio_smb.cpp:210
msgid ""
"\n"
"There is probably no SMB service running on this host."
msgstr ""
"\n"
"Ŝajne ne ruliĝas SMB-servo en tiu komputilo."

#: kio_smb.cpp:229 kio_smb.cpp:234
msgid ""
"\n"
"Invalid user/password combination."
msgstr ""
"\n"
"Nevalida uzanto/pasvort-kombino."

#: kio_smb.cpp:253
msgid "Hmm..."
msgstr "Nu..."

#: kio_smb.cpp:420 kio_smb.cpp:1198
msgid "Username and password required:"
msgstr "Salutnomo kaj pasvorto necesa:"

#: kio_smb.cpp:557 kio_smb.cpp:1058
msgid ""
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"Por aliri retdosierujon de komputilo uzu smb://komputilo\n"
"Por ricevi liston de ĉiuj komputiloj en la loka reto uzo lan:/ aŭ rlan:/\n"
"Pliajn informojn vi trovas en la KDEa Stircentro sub Reto->Loka Reto."

#: kio_smb.cpp:891
msgid ""
"\n"
