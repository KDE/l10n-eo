#: kio_smb.cpp:342 kio_smb.cpp:358 kio_smb.cpp:606 kio_smb.cpp:641
#: kio_smb.cpp:1717 kio_smb.cpp:1907 kio_smb.cpp:2159 kio_smb.cpp:2194
#: kio_smb.cpp:2274 kio_smb.cpp:2325 kio_smb.cpp:2339 kio_smb.cpp:2358
msgid ""
"\n"
"Make sure that the samba package is installed properly on your system."
msgstr ""
"\n"
"Certigu, ke la Sambo-pakaĵo estas ĝuste instalita en via sistemo."

#: kio_smb.cpp:353
msgid ""
"\n"
"There is probably no SMB service running on this host."
msgstr ""
"\n"
"Ŝajne ne ruliĝas SMB-servo en tiu komputilo."

#: kio_smb.cpp:376 kio_smb.cpp:382
msgid ""
"\n"
"Invalid user/password combination."
msgstr ""
"\n"
"Nevalida uzanto/pasvort-kombino."

#: kio_smb.cpp:415
msgid "Unable to parse response message."
msgstr "Ne eblas analizi respondon."

#: kio_smb.cpp:568
msgid "Server"
msgstr "Servilo"

#: kio_smb.cpp:571
msgid "Workgroup"
msgstr "Laborgrupo"

#: kio_smb.cpp:576
msgid "Share"
msgstr "Retdosierujo"

#: kio_smb.cpp:765
msgid ""
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"Por aliri retdosierujon de komputilo uzu smb://komputilo\n"
"Por ricevi liston de ĉiuj komputiloj en la loka reto uzo lan:/ aŭ rlan:/\n"
"Pliajn informojn vi trovas en la KDEa Stircentro sub Reto->Loka Reto."

#: kio_smb.cpp:1256
msgid ""
"\n"
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"\n"
"Por aliri retdosierujon de komputilo uzu smb://komputilo\n"
"Por ricevi liston de ĉiuj komputiloj en la loka reto uzo lan:/ aŭ rlan:/\n"
"Pliajn informojn vi trovas en la KDEa Stircentro sub Reto->Loka Reto."

#: kio_smb.cpp:1298 kio_smb.cpp:1348 kio_smb.cpp:1471 kio_smb.cpp:1503
#, c-format
msgid ""
"\n"
"Could not create required pipe %1."
msgstr ""
"\n"
"Ne eblis krei necesan dukton %1."

#: kio_smb.cpp:1335
msgid ""
"To be able to write to a remote Samba share you must patch and recompile "
"smbclient.\n"
"Visit http://lisa-home.sourceforge.net/smbclientpatch.html and follow the "
"instructions there."
msgstr ""
"Por skribi al malproksima retdosierujo vi devas ŝanĝi kaj traduki la "
"smbklienton.\n"
"Vidu http://lisa-home.sourceforge.net/smbclientpatch.html kaj sekvu la "
"instrukcion tie."

#: kio_smb.cpp:1358 kio_smb.cpp:1366 kio_smb.cpp:1514 kio_smb.cpp:1522
#, c-format
msgid ""
"\n"
"Could not fcntl() pipe %1."
msgstr ""
"\n"
"Ne eblis apliki funkcion fcntl() al dukto %1."

#~ msgid "Hmm..."
#~ msgstr "Nu..."

#~ msgid "Username and password required:"
#~ msgstr "Salutnomo kaj pasvorto necesa:"
