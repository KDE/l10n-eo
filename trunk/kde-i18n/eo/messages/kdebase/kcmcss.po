#: rc.cpp:1
msgid "Stylesheets"
msgstr "Stilfolioj"

#: rc.cpp:2 rc.cpp:3
msgid ""
"<b>Stylesheets</b><p>See http://www.w3.org/Style/CSS for further information "
"on cascading style sheets.</p>"
msgstr ""

#: rc.cpp:4
msgid "&General"
msgstr "Ĝ&enerale"

#: rc.cpp:5
msgid "&Stylesheets"
msgstr "&Stildifinoj"

#: rc.cpp:6
msgid ""
"<b>Stylesheets</b><p>Use this groupbox to determine how Konqueror will "
"render style sheets.</p>"
msgstr ""

#: rc.cpp:8
msgid "Use &user-defined stylesheet"
msgstr ""

#: rc.cpp:9 rc.cpp:10 rc.cpp:11
msgid ""
"<b>Use user-defined stylesheet</b><p>If this box is checked, konqueror will "
"try to load a user defined style sheet as specified in the location below. "
"The style sheet allows you to completely override the way web pages are "
"rendered in your browser. The file specified should contain a valid style "
"sheet (see http://www.w3.org/Style/CSS for further information on cascading "
"style sheets).</p>"
msgstr ""

#: rc.cpp:12
msgid "Use &accessiblity stylesheet defined in \"Customize\"-tab"
msgstr ""

#: rc.cpp:13 rc.cpp:14
msgid ""
"<b>Use accessiblity stylesheet defined in "
"&quot;Customize&quot;-tab</b><p>Selecting this option will allow you to "
"define a default font, font size, and font color with a few simple clicks of "
"the mouse.  Simply wander over to the Customize tab and pick out your "
"desired options.</p>"
msgstr ""

#: rc.cpp:15
msgid "Use &default stylesheet"
msgstr "Uzu &aprioran stilfolion"

#: rc.cpp:16 rc.cpp:17
msgid ""
"<b>Use default stylesheet</b><p>Select this option to use the default "
"stylesheet.</p>"
msgstr ""

#: rc.cpp:18
msgid "&Customize"
msgstr "&Agordu"

#: rc.cpp:19
msgid "Font &size"
msgstr ""

#: rc.cpp:20 rc.cpp:21
msgid "<b>Font size</b>"
msgstr "<b>Tipargrandeco</b>"

#: rc.cpp:22
msgid "&Use same size for all elements"
msgstr ""

#: rc.cpp:23 rc.cpp:24
msgid ""
"<b>Use same size for all elements</b><p>Select this option to override "
"custom font sizes in favor of the base font size.  All fonts will be "
"displayed in the same size.</p>"
msgstr ""

