msgid "64"
msgstr "64"

#: rc.cpp:39
msgid "&Colors"
msgstr "&Koloroj"

#: rc.cpp:40
msgid "&Black on White"
msgstr "&Nigra sur blanka"

#: rc.cpp:41
msgid ""
"<p>Activating this will cause the cookie monster to appear in your "
"dreams.</p>"
msgstr "<p>Se enŝaltita la kuketo-monstro aperas en viaj sonĝoj.</p>"

#: rc.cpp:42
msgid "<b>Black on White</b><p>This is what you normally see.</p"
msgstr "<b>Nigra sur blanka</b><p>Tio estas, kion vi normale vidas.</p"

#: rc.cpp:43
msgid "Use same color for all text"
msgstr "Uzu saman koloron por ĉiuj tekstoj"

#: rc.cpp:44 rc.cpp:45
msgid ""
"<b>Use same color for all text</b><p>Select this option to apply your chosen "
"color to the default font as well as any custom fonts as specified in a "
"stylesheet.</p>"
msgstr ""

#: rc.cpp:46
msgid "&Custom"
msgstr "&Propra"

#: rc.cpp:47 rc.cpp:48
msgid ""
"<b>Custom</b><p>Select this option to define a custom color for the default "
"font.</p>"
msgstr ""

#: rc.cpp:49 rc.cpp:50
msgid ""
"<b>Background</b><p>Behind this door lays the ability to choose a custom "
"default background.</p>"
msgstr ""

#: rc.cpp:51
msgid "B&ackground:"
msgstr "&Fono:"

#: rc.cpp:52 rc.cpp:53
msgid ""
"<b>Background</b><p>This background color is the one displayed behind the "
"text by default. A background image will override this.</p>"
msgstr ""

#: rc.cpp:54
msgid "&Foreground:"
msgstr "&Teksto:"

#: rc.cpp:55 rc.cpp:56 rc.cpp:60 rc.cpp:61
msgid ""
"<b>Foreground color</b><p>The foreground color is the color that the text is "
"drawn in.</p>"
msgstr ""
"<b>Tekstkoloro</b><p>La tekskoloro estas la koloro, per kiu teksto estas "
"prezentata.</p>"

#: rc.cpp:57
msgid "&White on Black"
msgstr "&Blanka sur nigra"

#: rc.cpp:58
msgid ""
"<p>Factoid of the day: khtml is an amazing piece of work.  Compare it to "
"what Netscape's Navigator uses.  Imagine implementing everything with "
"JavaScript.  Bleh.</p>"
msgstr ""

#: rc.cpp:59
msgid "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
msgstr ""

#: rc.cpp:62
msgid "Font &family"
msgstr "Tiparo&familio"

#: rc.cpp:63 rc.cpp:64
msgid ""
"<b>Font family</b><p>A font family is a group of fonts that resemble one "
"another, with family members that are e.g. bold, italic, or any number of "
"the above.</p>"
msgstr ""

#: rc.cpp:65
msgid "<p>This is the currently selected font family</p>"
msgstr ""

#: rc.cpp:66
msgid "Base &family:"
msgstr "Baza &familio:"

#: rc.cpp:67
msgid "Use same family for all text"
msgstr ""

#: rc.cpp:68 rc.cpp:69
msgid ""
"<b>Use same family for all text</b><p>Select this option to override custom "
"fonts everywhere in favor of the base font.</p>"
msgstr ""

#: rc.cpp:70
msgid "&Images"
msgstr "&Bildoj"

#: rc.cpp:71
msgid "<b>Images</b><p></b>"
msgstr "<b>Bildoj</b><p></b>"

#: rc.cpp:72
msgid "&Supress images"
msgstr ""

#: rc.cpp:73 rc.cpp:74
msgid ""
"<b>Supress images</b><p>Selecting this will prevent Konqueror from loading "
"images.</p>"
msgstr ""

#: rc.cpp:75
msgid "Supress background images"
msgstr "Subpremu fonbildojn"

#: rc.cpp:76 rc.cpp:77
msgid ""
"<b>Supress background images</b><p>Selecting this option will prevent "
"Konqueror from loading background images.</p>"
msgstr ""

#: rc.cpp:78
msgid "&Preview..."
msgstr "&Antaŭrigardo..."

#: rc.cpp:79 rc.cpp:80
msgid ""
"<b>Preview</b><p>Click on this button to see what your selections look like "
"in action.</p>"
msgstr ""

#: rc.cpp:81
msgid "Preview"
msgstr "Antaŭrigardo"

