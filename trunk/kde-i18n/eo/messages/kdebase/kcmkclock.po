#: dtime.cpp:62
msgid "Here you can change the system date's month."
msgstr "Tie ĉi vi povas ŝanĝi la monaton de la sistemdato."

#: dtime.cpp:68
msgid "Here you can change the system date's year."
msgstr "Tie ĉi vi povas ŝangi la jaron de la sistemdato."

#: dtime.cpp:72
msgid "Here you can change the system date's day of the month."
msgstr "Tie ĉi vi povas ŝanĝi la tagon de la monato de la sistemdato."

#: dtime.cpp:136
msgid ""
"Here you can change the system time. Click into the hours, minutes or "
"seconds field to change the relevant value, either using the up and down "
"buttons to the right or by entering a new value."
msgstr ""
"Tie ĉi vi povas ŝanĝi la sistemtempon. Klaku al horoj, minutoj aŭ "
"sekundoj por ŝangi la koncernan valoron. Tion vi povas fari per la butonoj "
"kun la sagetoj aŭ per rekta entajpo."

