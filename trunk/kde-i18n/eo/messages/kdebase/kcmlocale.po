#: localetime.cpp:414
msgid ""
"<p>The text in this textbox will be used to format time strings. The "
"sequences below will be replaced:</p>"
"<table>"
"<tr>"
"<td><b>HH</b></td>"
"<td>The hour as a decimal number using a 24-hour clock "
"(00-23).</td></tr>"
"<tr>"
"<td><b>hH</b></td>"
"<td>The hour (24-hour clock) as a decimal number "
"(0-23).</td></tr>"
"<tr>"
"<td><b>PH</b></td>"
"<td>The hour as a decimal number using a 12-hour clock "
"(01-12).</td></tr>"
"<tr>"
"<td><b>pH</b></td>"
"<td>The hour (12-hour clock) as a decimal number "
"(1-12).</td></tr>"
"<tr>"
"<td><b>MM</b></td>"
"<td>The minutes as a decimal number "
"(00-59).</td>"
"<tr>"
"<tr>"
"<td><b>SS</b></td>"
"<td>The seconds as a decimal number "
"(00-59).</td></tr>"
"<tr>"
"<td><b>AMPM</b></td>"
"<td>Either \"am\" or \"pm\" according to the given time value. Noon is "
"treated as \"pm\" and midnight as \"am\".</td></tr></table>"
msgstr ""
"<p>La teksto en tiu ĉi fenestreto estas uzata por konstrui tempo-indikojn. "
"La sekvajn variablojn vipovas uzi:</p>"
"<table>"
"<tr>"
"<td><b>H</b></td>"
"<td>La horo kiel du ciferoj (00-23).</td></tr>"
"<tr>"
"<td><b>hH</b></td>"
"<td>La horo  (0-23).</td></tr>"
"<tr>"
"<td><b>PH</b></td>"
"<td>La horo kiel du ciferoj (01-12).</td></tr>"
"<tr>"
"<td><b>pH</b></td>"
"<td>La horo  (1-12).</td></tr>"
"<tr>"
"<td><b>M</b></td>"
"<td>La minutoj  (00-59).</td></tr>"
"<tr>"
"<td><b>S</b></td>"
"<td>La sekundoj  (00-59).</td></tr>"
"<tr>"
"<td><b>AMPM</b></td>"
"<td>Aŭ AM aŭ PM laŭ la donita tempo. Tagmezo apartenas al PM kaj "
"noktomezo al AM.</td></tr></table>"

