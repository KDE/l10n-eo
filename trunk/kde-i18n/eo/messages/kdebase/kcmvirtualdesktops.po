#: desktop.cpp:65
msgid "&Number of Desktops: "
msgstr "&Nombro de tabuloj: "

#: desktop.cpp:70
msgid ""
"Here you can set how many virtual desktops you want on your KDE desktop. "
"Move the slider to change the value."
msgstr ""
"Jen vi povas agordi la nombron de tabuloj, kiujn vi volas uzi en KDE. Ŝovu "
"la glitilon por ŝanĝi la nombron."

#: desktop.cpp:93 desktop.cpp:94
msgid "Desktop%1:"
msgstr "Tabulo %1:"

#: desktop.cpp:97 desktop.cpp:98 desktop.cpp:99 desktop.cpp:100
#, c-format
msgid "Here you can enter the name for desktop %1"
msgstr "Jen vi povas doni la nomon de la tabulo %1"

#: desktop.cpp:158 desktop.cpp:176
#, c-format
msgid "Desktop %1"
msgstr "Tabulo %1"

#: desktop.cpp:167
msgid ""
"<h1>Desktop Number & Names</h1>In this module, you can configure how many "
"virtual desktops you want and how these should be labelled."
msgstr ""
"<h1>Tabulonombro kaj -nomoj</h1> En tiu ĉi agordmodulo vi povas agordi la "
"nombron de la tabuloj kaj iliajn nomojn."
