msgstr "&Forigu vidigilon"

#: SensorDisplay.cc:141
msgid ""
"<qt><p>This is a sensor display. To customize a sensor display click and hold"
" the right mouse button on either the frame or the display box and select the"
" <i>Properties</i> entry from the popup menu. Select <i>Remove</i> to delete "
"the display from the work sheet.</p>%1</qt>"
msgstr ""
"<qt><p>Jen sentilo-vidigilo. Por agordi ĝin, klaku per la dekstra musbutono "
"sur la kadro aŭ la vidigilo-areo kaj elektu la eron <i>Ecoj</i> el la ĉelok"
"a menuo. Elektu <i>Forigu</i> por forigi la vidigilon el la laborfolio.</p>%1"
"</qt>"

