#: rc.cpp:11 rc.cpp:238
msgid ""
"This setting controls the width/height ratio for horizontal panels and the "
"height/width ratio for vertical panels (e.g. To have the displays in a "
"horizontal panel twice as wide as their height enter 200%. To have them half "
"as wide enter 50%)."
msgstr ""
"Tiu agordaĵo donas la proporcion inter larĝeco kaj alteco por horizontalaj "
"paneloj kaj la proporcion inter alteco kaj larĝeco por vertikalaj paneloj. "
"(Se ekz. vidigilo en horizontala panelo estu duoble tiom larĝa kiel alta, "
"donu 200%. Se ĝi estu duone tiom larĝa, kiom alta donu 50%)."

