msgid "Steps into the next statement"
msgstr ""

#: parts/debugger/debuggerpart.cpp:192
#: parts/javadebugger/javadebuggerpart.cpp:179
msgid ""
"Step into\n"
"\n"
"Executes exactly one line of source. If the source line is a call to a "
"function then execution will stop after the function has been entered."
msgstr ""

#: parts/debugger/debuggerpart.cpp:198
#: parts/javadebugger/javadebuggerpart.cpp:185
