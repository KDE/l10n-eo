#: src/service/plugins/activitytemplates/kactivitymanagerd-plugin-activitytemplates.json
msgctxt "Name"
msgid "Activity Templates"
msgstr "Agado-Ŝablonoj"

#: src/service/plugins/eventspy/kactivitymanagerd-plugin-eventspy.json
msgctxt "Name"
msgid "Event Spy"
msgstr "Eventa Spiono"

#: src/service/plugins/globalshortcuts/kactivitymanagerd-plugin-globalshortcuts.json
msgctxt "Name"
msgid "Global Shortcuts"
msgstr "Ĉieaj Ŝparvojoj"

#: src/service/plugins/gtk-eventspy/kactivitymanagerd-plugin-gtk-eventspy.json
msgctxt "Name"
msgid "Gtk Event Spy"
msgstr "Gtk Eventa Spiono"

#: src/service/plugins/krunner/kactivitymanagerd-plugin-activityrunner.json
msgctxt "Name"
msgid "Activity Runner"
msgstr "Aktiva Kuristo"

#: src/service/plugins/runapplication/kactivitymanagerd-plugin-runapplication.json
msgctxt "Name"
msgid "Run applications on activity state change"
msgstr "Ruli aplikaĵojn je aktiveca statoŝanĝo"

#: src/service/plugins/slc/kactivitymanagerd-plugin-slc.json
msgctxt "Name"
msgid "Share-Like-Connect"
msgstr "Kunhavigu-Kiel-Konekti"

#: src/service/plugins/sqlite/kactivitymanagerd-plugin-sqlite.json
msgctxt "Name"
msgid "SQLite Feeder"
msgstr "SQLite Feeder"

#: src/service/plugins/virtualdesktopswitch/kactivitymanagerd-plugin-virtualdesktopswitch.json
msgctxt "Name"
msgid "Virtual desktop switcher"
msgstr "Virtuala labortabla ŝaltilo"

#: src/service/plugins/activitytemplates/kactivitymanagerd-plugin-activitytemplates.json
msgctxt "Description"
msgid "Support for creating templated activities"
msgstr "Subteno por krei ŝablonojn de agadoj"

#: src/service/plugins/eventspy/kactivitymanagerd-plugin-eventspy.json
msgctxt "Description"
msgid ""
"Collects events from applications that support recent documents specification"
msgstr ""
"Kolektas eventojn de aplikaĵoj, kiuj subtenas specifojn pri lastatempaj "
"dokumentoj"

#: src/service/plugins/globalshortcuts/kactivitymanagerd-plugin-globalshortcuts.json
msgctxt "Description"
msgid "Adds global keyboard shortcuts for activity switching"
msgstr "Aldonas ĉieajn klavarajn ŝparvojojn por aktiva ŝanĝado"

#: src/service/plugins/gtk-eventspy/kactivitymanagerd-plugin-gtk-eventspy.json
msgctxt "Description"
msgid ""
"Collects events from applications that use GtkFileChooser and "
"GtkRecentManager as specified by https://www.freedesktop.org/wiki/"
"Specifications/desktop-bookmark-spec/"
msgstr ""
"Kolektas eventojn de aplikoj kiuj uzas GtkFileChooser kaj GtkRecentManager "
"kiel specifite de https://www.freedesktop.org/wiki/Specifications/desktop-"
"bookmark-spec/"

#: src/service/plugins/krunner/kactivitymanagerd-plugin-activityrunner.json
msgctxt "Description"
msgid "KRunner plugin to list and switch activities"
msgstr "KRunner kromaĵo por listigi kaj ŝanĝi agadojn"

#: src/service/plugins/runapplication/kactivitymanagerd-plugin-runapplication.json
msgctxt "Description"
msgid ""
"When switching activities, or when starting and stopping them, execute "
"specified applications"
msgstr ""
"Kiam oni ŝanĝas agadojn, aŭ kiam oni komencas kaj haltigas ilin, ekzekutu "
"specifitajn aplikojn"

#: src/service/plugins/slc/kactivitymanagerd-plugin-slc.json
msgctxt "Description"
msgid "Provides data to Share-Like-Connect applet"
msgstr "Provizas datumojn al Share-Like-Connect-apleto"

#: src/service/plugins/sqlite/kactivitymanagerd-plugin-sqlite.json
msgctxt "Description"
msgid "Plugin to store and score events in SQLite"
msgstr "Kromaĵo por konservi kaj noti eventojn en SQLite"

#: src/service/plugins/virtualdesktopswitch/kactivitymanagerd-plugin-virtualdesktopswitch.json
msgctxt "Description"
msgid ""
"When switching to an activity, opens the virtual desktop last used with that "
"activity"
msgstr ""
"Kiam vi ŝanĝas al agado, malfermas la virtualan labortablon laste uzatan kun "
"tiu agado"

