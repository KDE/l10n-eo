#: src/service/plugins/virtualdesktopswitch/kactivitymanagerd-plugin-virtualdesktopswitch.json
msgctxt "Name"
msgid "Virtual desktop switcher"
msgstr "Virtuala labortabla ŝaltilo"

#: src/service/plugins/virtualdesktopswitch/kactivitymanagerd-plugin-virtualdesktopswitch.json
msgctxt "Description"
msgid ""
"When switching to an activity, opens the virtual desktop last used with that "
"activity"
msgstr ""
"Kiam vi ŝanĝas al agado, malfermas la virtualan labortablon laste uzatan kun "
"tiu agado"

