#: daemon/backends/upower/backlight_helper_actions.actions:2
#: daemon/backends/upower/discretegpu_helper_actions.actions:2
#: daemon/chargethreshold_helper_actions.actions:2
msgctxt "Name"
msgid "KDE"
msgstr "KDE"

#: daemon/backends/upower/backlight_helper_actions.actions:58
msgctxt "Name"
msgid "Get maximum brightness value"
msgstr "Akiri maksimuman brilvaloron"

#: daemon/backends/upower/backlight_helper_actions.actions:110
#: daemon/backends/upower/backlight_helper_actions.actions:217
msgctxt "Description"
msgid "System policies prevent you from getting the brightness level."
msgstr "Sistemaj politikoj malhelpas vin akiri la brilnivelon."

#: daemon/backends/upower/backlight_helper_actions.actions:165
msgctxt "Name"
msgid "Get brightness"
msgstr "Akiri brilon"

#: daemon/backends/upower/backlight_helper_actions.actions:272
msgctxt "Name"
msgid "Set brightness"
msgstr "Agordi brilon"

#: daemon/backends/upower/backlight_helper_actions.actions:324
msgctxt "Description"
msgid "System policies prevent you from setting the brightness level."
msgstr "Sistemaj politikoj malhelpas vin agordi la brilnivelon."

#: daemon/backends/upower/backlight_helper_actions.actions:378
msgctxt "Name"
msgid "Get syspath"
msgstr "Akiri syspath"

#: daemon/backends/upower/backlight_helper_actions.actions:427
msgctxt "Description"
msgid "System policies prevent you from getting the syspath"
msgstr "Sistemaj politikoj malhelpas vin akiri la syspath"

#: daemon/backends/upower/discretegpu_helper_actions.actions:58
msgctxt "Name"
msgid "Check existence of discrete gpu"
msgstr "Kontroli ekziston de diskreta gpu"

#: daemon/backends/upower/discretegpu_helper_actions.actions:105
msgctxt "Description"
msgid ""
"System policies prevent you from checking the existence of discrete gpu."
msgstr ""
"Sistemaj politikoj malhelpas vin kontroli la ekziston de diskreta gpu."

#: daemon/backends/upower/powerdevilupowerbackend.desktop:7
msgctxt "Name"
msgid "UPower PowerDevil Backend"
msgstr "UPower PowerDevil Backend"

#: daemon/backends/upower/powerdevilupowerbackend.desktop:56
msgctxt "Comment"
msgid "Use KDE Power Management system through freedesktop.org upower daemon"
msgstr ""
"Uzi KDE-Potencadministran sistemon per freedesktop.org upower-demono"

#: daemon/chargethreshold_helper_actions.actions:58
msgctxt "Name"
msgid "Get current battery charge limit"
msgstr "Akiri la aktualan limon de baterioŝarĝo"

#: daemon/chargethreshold_helper_actions.actions:97
msgctxt "Description"
msgid ""
"System policies prevent you from getting the current battery charge limit."
msgstr ""
"Sistemaj politikoj malhelpas vin akiri la nunan limon de baterioŝarĝo."

#: daemon/chargethreshold_helper_actions.actions:141
msgctxt "Name"
msgid "Set battery charge limit"
msgstr "Agordi la limon de ŝarĝo de la baterioj"

#: daemon/chargethreshold_helper_actions.actions:181
msgctxt "Description"
msgid "System policies prevent you from setting a battery charge limit."
msgstr ""
"Sistemaj politikoj malhelpas vin agordi limon de baterioŝarĝo."

#: daemon/powerdevil.desktop.cmake:4 powerdevil.notifyrc:2
msgctxt "Name"
msgid "Power Management"
msgstr "Potenca Administrado"

#: daemon/powerdevil.desktop.cmake:62
msgctxt "Comment"
msgid "Battery, Display and CPU power management and notification"
msgstr "Baterio, Ekrano kaj CPU-potencadministrado kaj sciigo"

#: powerdevil.notifyrc:55
msgctxt "Comment"
msgid "Power Management System"
msgstr "Potencadministra Sistemo"

#: powerdevil.notifyrc:110
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: powerdevil.notifyrc:162
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Uzita por avertaj sciigoj"

#: powerdevil.notifyrc:216
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: powerdevil.notifyrc:269
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Uzita por normaj sciigoj"

#: powerdevil.notifyrc:323
msgctxt "Name"
msgid "Critical notification"
msgstr "Kritika sciigo"

#: powerdevil.notifyrc:375
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Sciigas kritikan eventon"

#: powerdevil.notifyrc:429
msgctxt "Name"
msgid "Battery Low"
msgstr "Baterio Malalta"

#: powerdevil.notifyrc:481
msgctxt "Comment"
msgid "Your battery has reached low level"
msgstr "Via baterio atingis malaltan nivelon"

#: powerdevil.notifyrc:539
msgctxt "Name"
msgid "Battery Critical"
msgstr "Baterio Kritika"

#: powerdevil.notifyrc:591
msgctxt "Comment"
msgid ""
"Your battery has reached critical level. This notification triggers a "
"countdown before doing the configured action, hence it is strongly advised "
"to leave that on."
msgstr ""
"Via baterio atingis kritikan nivelon. Ĉi tiu sciigo ekigas retronombradon "
"antaŭ ol fari la agorditan agon, tial estas forte konsilite lasi tion."

#: powerdevil.notifyrc:649
msgctxt "Name"
msgid "Charge Complete"
msgstr "Ŝarĝo Kompleta"

#: powerdevil.notifyrc:700
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "La baterio estas plene ŝargita"

#: powerdevil.notifyrc:757
msgctxt "Name"
msgid "Peripheral Battery Low"
msgstr "Ekstercentra Baterio Malalta"

#: powerdevil.notifyrc:806
msgctxt "Comment"
msgid "The battery in a connected device, such as mouse or keyboard, is low"
msgstr "La baterio en konektita aparato, kiel muso aŭ klavaro, estas malalta"

#: powerdevil.notifyrc:861
msgctxt "Name"
msgid "Power source connected"
msgstr "Elektrofonto konektita"

#: powerdevil.notifyrc:902
msgctxt "Comment"
msgid "The power source has been connected"
msgstr "La energifonto estis konektita"

#: powerdevil.notifyrc:949
msgctxt "Name"
msgid "Power source disconnected"
msgstr "Elektrofonto malkonektita"

#: powerdevil.notifyrc:990
msgctxt "Comment"
msgid "The power source has been disconnected"
msgstr "La energifonto estis malkonektita"

