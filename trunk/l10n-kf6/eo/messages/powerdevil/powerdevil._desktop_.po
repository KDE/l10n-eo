msgctxt "Name"
msgid "KDE"
msgstr "KDE"

#: daemon/backends/upower/backlight_helper_actions.actions:60
msgctxt "Name"
msgid "Get maximum brightness value"
msgstr "Akiri maksimuman brilvaloron"

#: daemon/backends/upower/backlight_helper_actions.actions:114
msgctxt "Description"
msgid "Authenticate to see the maximum brightness level."
msgstr "Aŭtentiĝu por vidi la maksimuman brilnivelon."

#: daemon/backends/upower/backlight_helper_actions.actions:137
msgctxt "Name"
msgid "Get brightness"
msgstr "Akiri brilon"

#: daemon/backends/upower/backlight_helper_actions.actions:191
msgctxt "Description"
msgid "Authenticate to see the brightness level."
msgstr "Aŭtentiĝu por vidi la brilnivelon."

#: daemon/backends/upower/backlight_helper_actions.actions:214
msgctxt "Name"
msgid "Set brightness"
msgstr "Agordi brilon"

#: daemon/backends/upower/backlight_helper_actions.actions:268
msgctxt "Description"
msgid "Authenticate to set the brightness level."
msgstr "Aŭtentiĝu por meti la brilnivelon."

#: daemon/backends/upower/backlight_helper_actions.actions:290
msgctxt "Name"
msgid "Get syspath"
msgstr "Akiri syspath"

#: daemon/backends/upower/backlight_helper_actions.actions:340
msgctxt "Description"
msgid "Authenticate to see the syspath."
msgstr "Aŭtentiĝu por vidi la syspath."

#: daemon/backends/upower/discretegpu_helper_actions.actions:60
msgctxt "Name"
msgid "Check for existence of discrete GPU"
msgstr "Kontroli pri ekzisto de diskreta GPU"

#: daemon/backends/upower/discretegpu_helper_actions.actions:80
msgctxt "Description"
msgid "Authenticate to check for the existence of a discrete GPU."
msgstr "Aŭtentiĝu por kontroli pri la ekzisto de diskreta GPU."

#: daemon/backends/upower/powerdevilupowerbackend.desktop:7
msgctxt "Name"
msgid "UPower PowerDevil Backend"
msgstr "UPower PowerDevil Backend"

#: daemon/backends/upower/powerdevilupowerbackend.desktop:57
msgctxt "Comment"
msgid "Use KDE Power Management system through freedesktop.org upower daemon"
msgstr "Uzi KDE-Potencadministran sistemon per freedesktop.org upower-demono"

#: daemon/chargethreshold_helper_actions.actions:60
msgctxt "Name"
msgid "Get current battery charge limit"
msgstr "Akiri la aktualan limon de baterioŝarĝo"

#: daemon/chargethreshold_helper_actions.actions:102
msgctxt "Description"
msgid "Authenticate to see the current battery charge limit."
msgstr "Aŭtentiĝu por vidi la aktualan limon de baterioŝarĝo."

#: daemon/chargethreshold_helper_actions.actions:125
msgctxt "Name"
msgid "Set battery charge limit"
msgstr "Agordi la limon de ŝarĝo de la baterioj"

#: daemon/chargethreshold_helper_actions.actions:168
msgctxt "Description"
msgid "Authenticate to set the battery charge limit."
msgstr "Aŭtentiĝu por meti la aktualan limon de baterioŝarĝo."

#: daemon/powerdevil.desktop.cmake:4 powerdevil.notifyrc:2
msgctxt "Name"
msgid "Power Management"
msgstr "Potenca Administrado"

#: daemon/powerdevil.desktop.cmake:63
msgctxt "Comment"
msgid "Battery, Display and CPU power management and notification"
msgstr "Baterio, Ekrano kaj CPU-potencadministrado kaj sciigo"

#: powerdevil.notifyrc:56
msgctxt "Comment"
msgid "Power Management System"
msgstr "Potencadministra Sistemo"

#: powerdevil.notifyrc:112
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: powerdevil.notifyrc:165
msgctxt "Comment"
msgid "Used for warning notifications"
msgstr "Uzita por avertaj sciigoj"

#: powerdevil.notifyrc:220
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: powerdevil.notifyrc:274
msgctxt "Comment"
msgid "Used for standard notifications"
msgstr "Uzita por normaj sciigoj"

#: powerdevil.notifyrc:329
msgctxt "Name"
msgid "Critical notification"
msgstr "Kritika sciigo"

#: powerdevil.notifyrc:382
msgctxt "Comment"
msgid "Notifies a critical event"
msgstr "Sciigas kritikan eventon"

#: powerdevil.notifyrc:437
msgctxt "Name"
msgid "Battery Low"
msgstr "Baterio Malalta"

#: powerdevil.notifyrc:490
msgctxt "Comment"
msgid "Your battery has reached low level"
msgstr "Via baterio atingis malaltan nivelon"

#: powerdevil.notifyrc:549
msgctxt "Name"
msgid "Battery Critical"
msgstr "Baterio Kritika"

#: powerdevil.notifyrc:602
msgctxt "Comment"
msgid ""
"Your battery has reached critical level. This notification triggers a "
"countdown before doing the configured action, hence it is strongly advised "
"to leave that on."
msgstr ""
"Via baterio atingis kritikan nivelon. Ĉi tiu sciigo ekigas retronombradon "
"antaŭ ol fari la agorditan agon, tial estas forte konsilite lasi tion."

#: powerdevil.notifyrc:661
msgctxt "Name"
msgid "Charge Complete"
msgstr "Ŝarĝo Kompleta"

#: powerdevil.notifyrc:713
msgctxt "Comment"
msgid "The battery is fully charged"
msgstr "La baterio estas plene ŝargita"

#: powerdevil.notifyrc:771
msgctxt "Name"
msgid "Peripheral Battery Low"
msgstr "Ekstercentra Baterio Malalta"

#: powerdevil.notifyrc:821
msgctxt "Comment"
msgid "The battery in a connected device, such as mouse or keyboard, is low"
msgstr "La baterio en konektita aparato, kiel muso aŭ klavaro, estas malalta"

#: powerdevil.notifyrc:877
msgctxt "Name"
msgid "Power source connected"
msgstr "Elektrofonto konektita"

#: powerdevil.notifyrc:920
msgctxt "Comment"
msgid "The power source has been connected"
msgstr "La energifonto estis konektita"

#: powerdevil.notifyrc:969
msgctxt "Name"
msgid "Power source disconnected"
msgstr "Elektrofonto malkonektita"

#: powerdevil.notifyrc:1012
msgctxt "Comment"
msgid "The power source has been disconnected"
msgstr "La energifonto estis malkonektita"
