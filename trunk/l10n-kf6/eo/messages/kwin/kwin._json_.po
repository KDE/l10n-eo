#: src/plugins/backgroundcontrast/metadata.json
msgctxt "Description"
msgid "Improve contrast and readability behind semi-transparent windows"
msgstr "Plibonigu kontraston kaj legeblecon malantaŭ duontravideblaj fenestroj"

#: src/plugins/blendchanges/metadata.json
msgctxt "Description"
msgid "Animates system style changes"
msgstr "Animas sistemajn stilŝanĝojn"

#: src/plugins/blur/metadata.json
msgctxt "Description"
msgid "Blurs the background behind semi-transparent windows"
msgstr "Malklarigas la fonon malantaŭ duontravideblaj fenestroj"

#: src/plugins/colorblindnesscorrection/metadata.json
msgctxt "Description"
msgid "Enhances color perception for color blindness"
msgstr ""

#: src/plugins/colorpicker/metadata.json
msgctxt "Description"
msgid "Supports picking a color"
msgstr "Subtenas elekton de koloro"

#: src/plugins/desktopchangeosd/package/metadata.json
msgctxt "Description"
msgid "An on screen display indicating the desktop change"
msgstr "Ekrana ekrano indikanta la surtablan ŝanĝon"

#: src/plugins/dialogparent/package/metadata.json
msgctxt "Description"
msgid "Darkens the parent window of the currently active dialog"
msgstr "Malheligas la gepatran fenestron de la nun aktiva dialogo"

#: src/plugins/diminactive/metadata.json
msgctxt "Description"
msgid "Darken inactive windows"
msgstr "Mallumigi neaktivajn fenestrojn"

#: src/plugins/dimscreen/package/metadata.json
msgctxt "Description"
msgid "Darkens the entire screen when requesting root privileges"
msgstr "Mallumigas la tutan ekranon kiam oni petas radikajn privilegiojn"

#: src/plugins/eyeonscreen/package/metadata.json
msgctxt "Description"
msgid "Suck windows into the desktop"
msgstr "Suĉi fenestrojn en la labortablon"

#: src/plugins/fadedesktop/package/metadata.json
msgctxt "Description"
msgid "Fade between virtual desktops when switching between them"
msgstr "Fade inter virtualaj labortabloj kiam ŝanĝas inter ili"

#: src/plugins/fade/package/metadata.json
msgctxt "Description"
msgid "Make windows smoothly fade in and out when they are shown or hidden"
msgstr ""
"Igi fenestrojn glate malpli- kaj plipaliĝi kiam ili estas montritaj aŭ "
"kaŝitaj"

#: src/plugins/fadingpopups/package/metadata.json
msgctxt "Description"
msgid "Make popups smoothly fade in and out when they are shown or hidden"
msgstr ""
"Fari ŝprucfenestrojn glate mal- kaj fordissolvi kiam ili estas montritaj aŭ "
"kaŝitaj"

#: src/plugins/fallapart/metadata.json
msgctxt "Description"
msgid "Closed windows fall into pieces"
msgstr "Fermitaj fenestroj falas en pecojn"

#: src/plugins/frozenapp/package/metadata.json
msgctxt "Description"
msgid "Desaturate windows of unresponsive (frozen) applications"
msgstr "Malsaturigi fenestrojn de nerespondemaj (frostigitaj) aplikaĵoj"

#: src/plugins/fullscreen/package/metadata.json
msgctxt "Description"
msgid "Animation for a window going to and leaving full screen mode"
msgstr "Animacio por fenestro iranta kaj forlasanta plenekranan reĝimon"

#: src/plugins/glide/metadata.json
msgctxt "Description"
msgid "Glide windows as they appear or disappear"
msgstr "Gliti fenestrojn kiel ili aperas aŭ malaperas"

#: src/plugins/highlightwindow/metadata.json
msgctxt "Description"
msgid "Highlight the appropriate window when hovering over taskbar entries"
msgstr "Emfazu la taŭgan fenestron kiam ŝvebas super taskobretaj eniroj"

#: src/plugins/invert/metadata.json
msgctxt "Description"
msgid "Inverts the color of the desktop and windows"
msgstr "Inversas la koloron de la labortablo kaj fenestroj"

#: src/plugins/kdecorations/aurorae/src/config/kcm_auroraeconfig.json
msgctxt "Description"
msgid "Window Decoration Theme Engine"
msgstr "Fenestrodekora Etosmotoro"

#: src/plugins/kdecorations/aurorae/themes/plastik/package/metadata.json
msgctxt "Description"
msgid "The classic theme known from KDE 3"
msgstr "La klasika etoso konata de KDE 3"

#: src/plugins/kscreen/metadata.json
msgctxt "Description"
msgid "Helper Effect for KScreen"
msgstr "Helpa Efekto por KScreen"

#: src/plugins/login/package/metadata.json
msgctxt "Description"
msgid "Smoothly fade to the desktop when logging in"
msgstr "Glate dissolvi al la labortablo dum ensaluto"

#: src/plugins/logout/package/metadata.json
msgctxt "Description"
msgid "Smoothly fade to the logout screen"
msgstr "Glate paliĝi al la elsalutekrano"

#: src/plugins/magiclamp/metadata.json
msgctxt "Description"
msgid "Simulate a magic lamp when minimizing windows"
msgstr "Simuli magian lampon dum minimumigo de fenestroj"

#: src/plugins/magnifier/metadata.json
msgctxt "Description"
msgid "Magnify the section of the screen that is near the mouse cursor"
msgstr ""
"Pligrandigu la sekcion de la ekrano, kiu estas proksime de la muskursoro"

#: src/plugins/maximize/package/metadata.json
msgctxt "Description"
msgid "Animation for a window going to maximize/restore from maximize"
msgstr "Animacio por fenestro maksimumigi/restarigi de maksimumigi"

#: src/plugins/minimizeall/package/metadata.json
msgctxt "Description"
msgid "Adds a shortcut to minimize and restore all windows"
msgstr "Aldonas ŝparvojon por minimumigi kaj restarigi ĉiujn fenestrojn"

#: src/plugins/morphingpopups/package/metadata.json
msgctxt "Description"
msgid ""
"Cross fade animation when Tooltips or Notifications change their geometry"
msgstr "Krucfada animacio kiam Konsiletoj aŭ Sciigoj ŝanĝas sian geometrion"

#: src/plugins/mouseclick/metadata.json
msgctxt "Description"
msgid ""
"Creates an animation whenever a mouse button is clicked. This is useful for "
"screenrecordings/presentations"
msgstr ""
"Kreas animacion kiam ajn musbutono estas klakita. Ĉi tio utilas por "
"ekranregistradoj/prezentoj"

#: src/plugins/mousemark/metadata.json
msgctxt "Description"
msgid "Allows you to draw lines on the desktop"
msgstr "Permesas al vi desegni liniojn sur la labortablo"

#: src/plugins/overview/metadata.json
msgctxt "Description"
msgid "Allows you to overview virtual desktops and windows"
msgstr "Ebligas al vi superrigardi virtualajn labortablojn kaj fenestrojn"

#: src/plugins/scale/package/metadata.json
msgctxt "Description"
msgid "Make windows smoothly scale in and out when they are shown or hidden"
msgstr ""
"Fari fenestrojn glate grimpi en kaj eksteren kiam ili estas montritaj aŭ "
"kaŝitaj"

#: src/plugins/screenedge/metadata.json
msgctxt "Description"
msgid "Highlights a screen edge when approaching"
msgstr "Elstarigas ekranrandon kiam alproksimiĝas"

#: src/plugins/screenshot/metadata.json
msgctxt "Description"
msgid "Helper effect for screenshot tools"
msgstr "Helpa efiko por ekrankopaj iloj"

#: src/plugins/screentransform/metadata.json
msgctxt "Description"
msgid "Animates display transformations"
msgstr "Animas ekranajn transformojn"

#: src/plugins/sessionquit/package/metadata.json
msgctxt "Description"
msgid "Keep the desktop background alive during logout until the end"
msgstr "Konservu la labortablan fonon dum elsaluto ĝis la fino"

#: src/plugins/sheet/metadata.json
msgctxt "Description"
msgid ""
"Make modal dialogs smoothly fly in and out when they are shown or hidden"
msgstr ""
"Fari modalajn dialogojn glate enflugi kaj eksteren kiam ili estas montritaj "
"aŭ kaŝitaj"

#: src/plugins/showfps/metadata.json
msgctxt "Description"
msgid "Display KWin's performance in the corner of the screen"
msgstr "Montri la agadon de KWin en la angulo de la ekrano"

#: src/plugins/showpaint/metadata.json
msgctxt "Description"
msgid "Highlight areas of the desktop that have been recently updated"
msgstr "Marki areojn de la labortablo kiuj estis lastatempe ĝisdatigitaj"

#: src/plugins/slideback/metadata.json
msgctxt "Description"
msgid "Slide back windows when another window is raised"
msgstr "Glitigi malantaŭen fenestrojn kiam alia fenestro estas levita"

#: src/plugins/slide/metadata.json
msgctxt "Description"
msgid "Slide desktops when switching virtual desktops"
msgstr "Glitigi labortablojn dum ŝanĝado de virtualaj labortabloj"

#: src/plugins/slidingpopups/metadata.json
msgctxt "Description"
msgid "Sliding animation for Plasma popups"
msgstr "Glita animacio por Plasma ŝprucfenestroj"

#: src/plugins/snaphelper/metadata.json
msgctxt "Description"
msgid "Help you locate the center of the screen when moving a window"
msgstr "Helpi vin lokalizi la centron de la ekrano kiam vi movas fenestron"

#: src/plugins/squash/package/metadata.json
msgctxt "Description"
msgid "Squash windows when they are minimized"
msgstr "Squash fenestroj kiam ili estas minimumigitaj"

#: src/plugins/startupfeedback/metadata.json
msgctxt "Description"
msgid "Helper effect for startup feedback"
msgstr "Helpema efiko por komencaj sugestoj"

#: src/plugins/synchronizeskipswitcher/package/metadata.json
msgctxt "Description"
msgid ""
"Hides all windows marked as Skip Taskbar to be also excluded from window "
"switchers (e.g. Alt+Tab)"
msgstr ""
"Kaŝas ĉiujn fenestrojn markitajn kiel Skip Taskbar por ankaŭ esti "
"ekskluditaj de fenestraj ŝaltiloj (ekz. Alt+Tab)"

#: src/plugins/thumbnailaside/metadata.json
msgctxt "Description"
msgid "Display window thumbnails on the edge of the screen"
msgstr "Montri fenestrajn bildetojn ĉe la rando de la ekrano"

#: src/plugins/tileseditor/metadata.json
msgctxt "Description"
msgid "Editor for the tiling areas"
msgstr "Redaktilo por la kahelaroj"

#: src/plugins/touchpoints/metadata.json
msgctxt "Description"
msgid "Visualize touch points"
msgstr "Vidigi tuŝpunktojn"

#: src/plugins/trackmouse/metadata.json
msgctxt "Description"
msgid "Display a mouse cursor locating effect when activated"
msgstr "Montri muskursoro lokalizan efikon kiam aktivigita"

#: src/plugins/translucency/package/metadata.json
msgctxt "Description"
msgid "Make windows translucent under different conditions"
msgstr "Igi fenestrojn travideblaj sub malsamaj kondiĉoj"

#: src/plugins/videowall/package/metadata.json
msgctxt "Description"
msgid ""
"Spans fullscreen video player over all attached screens to create a Video "
"Wall"
msgstr ""
"Enhavas plenekranan videoludilon super ĉiuj kunigitaj ekranoj por krei "
"Videomuron"

#: src/plugins/windowaperture/package/metadata.json
msgctxt "Description"
msgid "Move windows into screen corners"
msgstr "Movi fenestrojn en ekranangulojn"

#: src/plugins/windowview/metadata.json
msgctxt "Description"
msgid "Zoom out until all opened windows can be displayed side-by-side"
msgstr ""
"Malzomi ĝis ĉiuj malfermitaj fenestroj povas esti montrataj flank-al-flanke"

#: src/plugins/wobblywindows/metadata.json
msgctxt "Description"
msgid "Deform windows while they are moving"
msgstr "Misformi fenestrojn dum kiam ili moviĝas"

#: src/plugins/zoom/metadata.json
msgctxt "Description"
msgid "Magnify the entire desktop"
msgstr "Pligrandigi la tutan labortablon"

#: src/tabbox/switchers/thumbnail_grid/metadata.json
msgctxt "Description"
msgid "A window switcher layout using a small grid of thumbnails"
msgstr "Fenestroŝaltila aranĝo uzante malgrandan kradon de bildetoj"

