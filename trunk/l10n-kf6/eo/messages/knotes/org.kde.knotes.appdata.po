#. (itstool) path: component/name
#: org.kde.knotes.appdata.xml:10
msgid "KNotes"
msgstr "KNotoj"

#. (itstool) path: component/summary
#: org.kde.knotes.appdata.xml:11
msgid "Sticky notes application"
msgstr "Apliko al gluiĝaj notoj"

#. (itstool) path: description/p
#: org.kde.knotes.appdata.xml:13
msgid ""
"KNotes is a program that lets you write the computer equivalent of sticky "
"notes. The notes are saved automatically when you exit the program, and they "
"display when you open the program."
msgstr ""
"KNotes estas programo kiu permesas vin skribi la komputilan ekvivalenton de "
"gluaj notoj. La notoj estas konservitaj aŭtomate kiam vi eliras la "
"programon, kaj ili aperas kiam vi malfermas la programon."

#. (itstool) path: description/p
#: org.kde.knotes.appdata.xml:17
msgid "Features:"
msgstr "Trajtoj:"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:19
msgid "Write notes in your choice of font and background color"
msgstr "Skribu notojn laŭ via elekto de tiparo kaj fonkoloro"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:20
msgid "Use drag and drop to email your notes"
msgstr "Uzu ŝovi kaj demeti por retpoŝti viajn notojn"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:21
msgid "Can be dragged into Calendar to book a time-slot"
msgstr "Povas esti ŝovita en Kalendaron por rezervi tempoperiodon"

#. (itstool) path: ul/li
#: org.kde.knotes.appdata.xml:22
msgid "Notes can be printed"
msgstr "Notoj povas esti presitaj"

