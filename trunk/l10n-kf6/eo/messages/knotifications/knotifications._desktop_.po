#: src/android_defaults.notifyrc:2
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fatala Eraro"

#: src/android_defaults.notifyrc:60
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Okazis grava eraro kaŭzante la eliro de la programo"

#: src/android_defaults.notifyrc:120
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: src/android_defaults.notifyrc:177
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Io speciala okazis en la programo"

#: src/android_defaults.notifyrc:236
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: src/android_defaults.notifyrc:293
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Estis eraro en la programo, kiu povas kaŭzi problemojn"

#: src/android_defaults.notifyrc:352
msgctxt "Name"
msgid "Catastrophe"
msgstr "Katastrofo"

#: src/android_defaults.notifyrc:408
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Tre grava eraro okazis, almenaŭ kaŭzante la eliro de la programo"
