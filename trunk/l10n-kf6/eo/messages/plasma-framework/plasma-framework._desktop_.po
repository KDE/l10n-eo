#: templates/cpp-plasmoid/cpp-plasmoid.kdevtemplate:3
msgctxt "Name"
msgid "Plasma QML/C++ Applet"
msgstr "Plasma QML/C++ Apleto"

#: templates/cpp-plasmoid/cpp-plasmoid.kdevtemplate:48
msgctxt "Comment"
msgid ""
"A Plasma Applet template written in an hybrid mix of QML and C++: a Plasma "
"applet template displaying a SVG picture and a text"
msgstr ""
"Plasma Applet-ŝablono skribita en hibrida miksaĵo de QML kaj C++: Plasma "
"Applet-ŝablono elmontranta SVG-bildon kaj tekston"

#: templates/plasma-wallpaper/plasma-wallpaper.kdevtemplate:3
msgctxt "Name"
msgid "Simple Plasma Wallpaper"
msgstr "Simpla Plasma Tapeto"

#: templates/plasma-wallpaper/plasma-wallpaper.kdevtemplate:50
msgctxt "Comment"
msgid ""
"Simple Plasma Wallpaper template: a Plasma wallpaper template displaying a "
"text"
msgstr "Simpla Plasma Tapeta ŝablono: Plasma Tapeta ŝablono montranta tekston"

#: templates/plasma-wallpaper-with-qml-extension/plasma-wallpaper-with-qml-extension.kdevtemplate:2
msgctxt "Name"
msgid "Simple Plasma Wallpaper with QML extension"
msgstr "Simpla Plasma Tapeto kun QML-etendo"

#: templates/plasma-wallpaper-with-qml-extension/plasma-wallpaper-with-qml-extension.kdevtemplate:42
msgctxt "Comment"
msgid ""
