msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Neniu kongrua kompletigo estis trovita"

#: plasma_workspace.notifyrc:355
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Tekstokompletigo: Parta Kongruo"

#: plasma_workspace.notifyrc:407
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Estas pli ol unu ebla kongruo"

#: plasma_workspace.notifyrc:464
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fatala Eraro"

