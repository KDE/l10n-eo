#: plasma_workspace.notifyrc:41
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Rubujo: Malplenigita"

#: plasma_workspace.notifyrc:96
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "La rubujo estas malplenigita"

#: plasma_workspace.notifyrc:155
msgctxt "Name"
msgid "Textcompletion: Rotation"
