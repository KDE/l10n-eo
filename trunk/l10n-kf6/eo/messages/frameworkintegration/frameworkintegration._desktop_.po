#: plasma_workspace.notifyrc:3
msgctxt "Comment"
msgid "System Notifications"
msgstr "Sistemsciigoj"

#: plasma_workspace.notifyrc:27
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Rubujo: Malplenigita"

#: plasma_workspace.notifyrc:80
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "La rubujo estas malplenigita"

#: plasma_workspace.notifyrc:137
msgctxt "Name"
msgid "Textcompletion: Rotation"
msgstr "Tekstokompletigo: Rotacio"

#: plasma_workspace.notifyrc:189
msgctxt "Comment"
msgid "The end of the list of matches has been reached"
msgstr "La fino de la listo de kongruoj estas atingita"

#: plasma_workspace.notifyrc:245
msgctxt "Name"
msgid "Textcompletion: No Match"
msgstr "Tekstokompletigo: Neniu Kongruo"

#: plasma_workspace.notifyrc:297
msgctxt "Comment"
msgid "No matching completion was found"
msgstr "Neniu kongrua kompletigo estis trovita"

#: plasma_workspace.notifyrc:353
msgctxt "Name"
msgid "Textcompletion: Partial Match"
msgstr "Tekstokompletigo: Parta Kongruo"

#: plasma_workspace.notifyrc:405
msgctxt "Comment"
msgid "There is more than one possible match"
msgstr "Estas pli ol unu ebla kongruo"

#: plasma_workspace.notifyrc:462
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fatala Eraro"

#: plasma_workspace.notifyrc:516
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Okazis grava eraro kaŭzante la eliro de la programo"

#: plasma_workspace.notifyrc:573
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: plasma_workspace.notifyrc:627
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Io speciala okazis en la programo"

#: plasma_workspace.notifyrc:683
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: plasma_workspace.notifyrc:737
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Estis eraro en la programo, kiu povas kaŭzi problemojn"

#: plasma_workspace.notifyrc:794
msgctxt "Name"
msgid "Catastrophe"
msgstr "Katastrofo"

#: plasma_workspace.notifyrc:847
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Tre grava eraro okazis, almenaŭ kaŭzante la eliro de la programo"

#: plasma_workspace.notifyrc:903
msgctxt "Name"
msgid "Application Crash"
msgstr "Aplika Paneo"

#: plasma_workspace.notifyrc:953
msgctxt "Comment"
msgid "An application just closed unexpectedly"
msgstr "Apliko ĵus fermiĝis neatendite"

#: plasma_workspace.notifyrc:1005
msgctxt "Name"
msgid "Login"
msgstr "Ensaluti"

