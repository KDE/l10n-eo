msgctxt "Comment"
msgid "Session is exiting"
msgstr "Seanco estas eliranta"

#: plasma_workspace.notifyrc:1224
msgctxt "Name"
msgid "Logout Canceled"
msgstr "Elsaluto Nuligis"

#: plasma_workspace.notifyrc:1277
msgctxt "Comment"
msgid "Plasma logout was canceled"
msgstr "Plasma elsaluto estis nuligita"

#: plasma_workspace.notifyrc:1333
msgctxt "Name"
msgid "Print Error"
msgstr "Presa Eraro"

#: plasma_workspace.notifyrc:1387
msgctxt "Comment"
