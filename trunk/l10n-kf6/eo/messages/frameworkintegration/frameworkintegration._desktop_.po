#: plasma_workspace.notifyrc:2101
msgctxt "Name"
msgid "Widget deleted"
msgstr "Fenestraĵo forigita"

#: plasma_workspace.notifyrc:2153
msgctxt "Comment"
msgid "A widget has been deleted"
msgstr "Fenestraĵo estis forigita"

