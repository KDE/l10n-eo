msgid "Device plugged in"
msgstr "Aparato enŝtopiĝis"

#: plasma_workspace.notifyrc:2246
msgctxt "Comment"
msgid "A device was plugged in"
msgstr "Aparato estis enŝtopita"

#: plasma_workspace.notifyrc:2288
msgctxt "Name"
msgid "Device unplugged"
msgstr "Aparato elŝtopiĝis"

#: plasma_workspace.notifyrc:2326
msgctxt "Comment"
msgid "A device was unplugged"
msgstr "Aparato estis elŝtopita"
