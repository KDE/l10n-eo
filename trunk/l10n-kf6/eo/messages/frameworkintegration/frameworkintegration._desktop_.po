msgctxt "Comment"
msgid "A question is being asked"
msgstr "Demando estas farita"

#: plasma_workspace.notifyrc:1889
msgctxt "Name"
msgid "Beep"
msgstr "Pep'"

#: plasma_workspace.notifyrc:1942
msgctxt "Comment"
