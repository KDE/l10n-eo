#: plasma_workspace.notifyrc:29
msgctxt "Name"
msgid "Trash: Emptied"
msgstr "Rubujo: Malplenigita"

#: plasma_workspace.notifyrc:82
msgctxt "Comment"
msgid "The trash has been emptied"
msgstr "La rubujo estas malplenigita"

#: plasma_workspace.notifyrc:139
msgctxt "Name"
msgid "Textcompletion: Rotation"
