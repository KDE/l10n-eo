#: kcm_sddm.actions:2
msgctxt "Name"
msgid "SDDM"
msgstr "SDDM"

#: kcm_sddm.actions:57
msgctxt "Name"
msgid "Save Settings"
msgstr "Konservi agordojn"

#: kcm_sddm.actions:107
msgctxt "Description"
msgid "Save Settings in SDDM"
msgstr "Konservi agordojn en SDDM"

#: kcm_sddm.actions:160
msgctxt "Name"
msgid "Install an SDDM theme"
msgstr "Instali SDDM-etoson"

#: kcm_sddm.actions:208
msgctxt "Description"
msgid "Extracts a zip file containing an SDDM theme to the SDDM theme location"
msgstr "Malpakas zip-dosieron enhavanta SDDM-etoson al la SDDM-etosa loko"

#: kcm_sddm.actions:257
msgctxt "Name"
msgid "Uninstall an SDDM theme"
msgstr "Malinstali SDDM-etoson"

#: kcm_sddm.actions:305
msgctxt "Description"
msgid "Removes a previously installed SDDM theme"
msgstr "Forigas antaŭe instalitan SDDM-etoson"

#: kcm_sddm.actions:357
msgctxt "Name"
msgid "Synchronize Settings"
msgstr "Sinkronigi agordojn"

#: kcm_sddm.actions:401
msgctxt "Description"
msgid "Synchronizes user settings with SDDM settings"
msgstr "Sinkronigas agordojn de uzanto kun SDDM-agordoj"

#: kcm_sddm.actions:449
msgctxt "Name"
msgid "Reset Settings"
msgstr "Restarigi agordojn"

#: kcm_sddm.actions:493
msgctxt "Description"
msgid "Resets SDDM settings to factory default state"
msgstr "Restarigas SDDM-agordojn al fabrikaj defaŭltoj"

#: sddmtheme.knsrc:4
msgctxt "Name"
msgid "Login Screen"
msgstr "Ensaluta ekrano"
