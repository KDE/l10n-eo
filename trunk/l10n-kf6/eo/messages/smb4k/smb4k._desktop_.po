#: core/smb4k.notifyrc:3 smb4k/org.kde.smb4k.desktop:3
msgctxt "Name"
msgid "Smb4K"
msgstr "Smb4K"

#: core/smb4k.notifyrc:44 smb4k/org.kde.smb4k.desktop:80
msgctxt "Comment"
msgid "Advanced Network Neighborhood Browser"
msgstr "Altnivela Reta Najbara Retumilo"

#: core/smb4k.notifyrc:87
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: core/smb4k.notifyrc:129
msgctxt "Comment"
msgid "The user is notified about an action"
msgstr "La uzanto estas sciigita pri ago"

#: core/smb4k.notifyrc:170
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: core/smb4k.notifyrc:212
msgctxt "Comment"
msgid "A warning is shown to the user"
msgstr "Averto montriĝas al la uzanto"

#: core/smb4k.notifyrc:254
msgctxt "Name"
msgid "Error"
msgstr "Eraro"

#: core/smb4k.notifyrc:296
msgctxt "Comment"
msgid "An error message is shown to the user"
msgstr "Erarmesaĝo estas montrita al la uzanto"

#: core/smb4k.notifyrc:336
msgctxt "Name"
msgid "Share mounted"
msgstr "Kunhavaĵo muntita"

#: core/smb4k.notifyrc:374
msgctxt "Comment"
msgid "A share has been mounted"
msgstr "Kunhavaĵo estis muntita"

#: core/smb4k.notifyrc:416
msgctxt "Name"
msgid "Share unmounted"
msgstr "Kunhavaĵo malmuntita"

#: core/smb4k.notifyrc:454
msgctxt "Comment"
msgid "A share has been unmounted"
msgstr "Kunhavaĵo estis malmuntita"

#: core/smb4k.notifyrc:496
msgctxt "Name"
msgid "Shares mounted"
msgstr "Kunhavaĵoj muntitaj"

#: core/smb4k.notifyrc:534
msgctxt "Comment"
msgid "Multiple shares have been mounted"
msgstr "Multoblaj kunhavaĵoj estis muntitaj"

#: core/smb4k.notifyrc:576
msgctxt "Name"
msgid "Shares unmounted"
msgstr "Kunhavaĵoj malmuntitaj"

#: core/smb4k.notifyrc:614
msgctxt "Comment"
msgid "Multiple shares have been unmounted"
msgstr "Multoblaj kunhavaĵoj estis malmuntitaj"

#: core/smb4k.notifyrc:656
msgctxt "Name"
msgid "Migrating login credentials"
msgstr "Transigante ensalutajn akreditilojn"

#: core/smb4k.notifyrc:686
msgctxt "Comment"
msgid ""
"The login credentials are migrated to the new format and the active password "
"manager"
msgstr ""
"La ensalutaj akreditiloj estas transigataj al la nova formato kaj la akiva "
"pasvort-administrilo"

#: core/smb4k.notifyrc:719
msgctxt "Name"
msgid "Mimetype not supported"
msgstr "Mimetipo ne subtenata"

#: core/smb4k.notifyrc:757
msgctxt "Comment"
msgid "The mimetype of the file that is to be printed is not supported"
msgstr "La mimetipo de la presita dosiero ne estas subtenata"

#: core/smb4k.notifyrc:799
msgctxt "Name"
msgid "Bookmark exists"
msgstr "Legomarko ekzistas"

#: core/smb4k.notifyrc:837
msgctxt "Comment"
msgid "The bookmark exists"
msgstr "La legosigno ekzistas"

#: core/smb4k.notifyrc:880
msgctxt "Name"
msgid "Bookmark label in use"
msgstr "Legomarka etikedo en uzo"

#: core/smb4k.notifyrc:918
msgctxt "Comment"
msgid "The label for the bookmark already exists"
msgstr "La etikedo por la legosigno jam ekzistas"

#: core/smb4k.notifyrc:961
msgctxt "Name"
msgid "Mounting failed"
msgstr "Muntado malsukcesis"

#: core/smb4k.notifyrc:1000
msgctxt "Comment"
msgid "Mounting a share failed"
msgstr "Muntado de kunhavaĵo malsukcesis"

#: core/smb4k.notifyrc:1043
msgctxt "Name"
msgid "Unmounting failed"
msgstr "Malmuntado malsukcesis"

#: core/smb4k.notifyrc:1082
msgctxt "Comment"
msgid "Unmounting a share failed"
msgstr "Malmuntado de kunhavaĵo malsukcesis"

#: core/smb4k.notifyrc:1125
msgctxt "Name"
msgid "Unmounting not allowed"
msgstr "Malmuntado ne permesita"

#: core/smb4k.notifyrc:1163
msgctxt "Comment"
msgid "The unmounting of a certain share is not allowed"
msgstr "La malmuntado de certa parto ne estas permesita"

#: core/smb4k.notifyrc:1206
msgctxt "Name"
msgid "Synchronization failed"
msgstr "Sinkronigo malsukcesis"

#: core/smb4k.notifyrc:1245
msgctxt "Comment"
msgid "The synchronization of a share and a local copy failed"
msgstr "La sinkronigo de parto kaj loka kopio malsukcesis"

#: core/smb4k.notifyrc:1287
msgctxt "Name"
msgid "Command not found"
msgstr "Ordono ne trovita"

#: core/smb4k.notifyrc:1328
msgctxt "Comment"
msgid "A required command could not be found"
msgstr "Bezonata komando ne estis trovita"

#: core/smb4k.notifyrc:1371
msgctxt "Name"
msgid "Cannot bookmark printer"
msgstr "Ne povas marki la presilon"

#: core/smb4k.notifyrc:1409
msgctxt "Comment"
msgid "A printer cannot be bookmarked"
msgstr "Presilo ne povas esti legomarkita"

#: core/smb4k.notifyrc:1452
msgctxt "Name"
msgid "File not found"
msgstr "Dosiero ne trovita"

#: core/smb4k.notifyrc:1494
msgctxt "Comment"
msgid "A file could not be found"
msgstr "Dosiero ne troviĝis"

#: core/smb4k.notifyrc:1537
msgctxt "Name"
msgid "Opening file failed"
msgstr "Malfermo de dosiero malsukcesis"

#: core/smb4k.notifyrc:1575
msgctxt "Comment"
msgid "A file could not be opened"
msgstr "Dosiero ne povis esti malfermita"

#: core/smb4k.notifyrc:1618
msgctxt "Name"
msgid "Reading file failed"
msgstr "Legado de dosiero malsukcesis"

#: core/smb4k.notifyrc:1656
msgctxt "Comment"
msgid "A file could not be read"
msgstr "Ne eblis legi dosieron"

#: core/smb4k.notifyrc:1699
msgctxt "Name"
msgid "mkdir failed"
msgstr "mkdir malsukcesis"

#: core/smb4k.notifyrc:1738
msgctxt "Comment"
msgid "A directory could not be created"
msgstr "Dosierujo ne povis esti kreita"

#: core/smb4k.notifyrc:1781
msgctxt "Name"
msgid "Process error"
msgstr "Proceza eraro"

#: core/smb4k.notifyrc:1822
msgctxt "Comment"
msgid "A process error occurred"
msgstr "Proceza eraro okazis"

#: core/smb4k.notifyrc:1865
msgctxt "Name"
msgid "Action failed"
msgstr "Ago malsukcesis"

#: core/smb4k.notifyrc:1905
msgctxt "Comment"
msgid "A KAuth action failed"
msgstr "Ago KAuth malsukcesis"

#: core/smb4k.notifyrc:1947
msgctxt "Name"
msgid "Invalid URL"
msgstr "Nevalida URL"

#: core/smb4k.notifyrc:1988
msgctxt "Comment"
msgid "An invalid URL was passed"
msgstr "Nevalida URL estis pasigita"

#: core/smb4k.notifyrc:2030
msgctxt "Name"
msgid "Network communication failed"
msgstr "Reta komunikado malsukcesis"

#: core/smb4k.notifyrc:2065
msgctxt "Comment"
msgid "A network related action could not be performed or failed"
msgstr "Retorilata ago ne povis esti efektivigita aŭ malsukcesis"

#: core/smb4k.notifyrc:2105
msgctxt "Name"
msgid "Zeroconf error"
msgstr "Zeroconf eraro"

#: core/smb4k.notifyrc:2139
msgctxt "Comment"
msgid "An error with the Zeroconf daemon occurred"
msgstr "Okazis eraro kun la demono Zeroconf"

#: core/smb4k.notifyrc:2177
msgctxt "Name"
msgid "Keychain error"
msgstr "Ŝlosilĉena eraro"

#: core/smb4k.notifyrc:2207
msgctxt "Comment"
msgid ""
"An error occurred while reading the login credentials from the secure storage"
msgstr ""
"Okazis eraro dum legado de la ensalutaj akreditaĵoj el la sekura konservejo"

#: helpers/smb4kmounthelper.actions:2
msgctxt "Name"
msgid "Mount action"
msgstr "Munta ago"

#: helpers/smb4kmounthelper.actions:39
msgctxt "Description"
msgid "Mounts a share"
msgstr "Muntas kunhavaĵon"

#: helpers/smb4kmounthelper.actions:80
msgctxt "Name"
msgid "Unmount action"
msgstr "Malmunta ago"

#: helpers/smb4kmounthelper.actions:117
msgctxt "Description"
msgid "Unmounts a share"
msgstr "Malmuntas kunhavaĵon"

#: smb4k/org.kde.smb4k.desktop:44
msgctxt "GenericName"
msgid "Advanced Network Browser for SAMBA"
msgstr "Altnivela Retumilo por SAMBA"
