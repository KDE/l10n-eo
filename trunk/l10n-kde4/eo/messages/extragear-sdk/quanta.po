#. i18n: file: scripts/listwizard.kmdr:18
#: rc.cpp:1672
msgid "Docbook List Wizard"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:87
#: rc.cpp:1676
msgid ""
"Press this button to cancel the creation of the list or procedure. No action "
"will be performed."
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:123
#: rc.cpp:1680
msgid "Press this button to create the selected list or procedure."
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:133
#: rc.cpp:1682
msgid "List Options"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:183
#. i18n: file: scripts/listwizard.kmdr:194
#. i18n: file: scripts/listwizard.kmdr:183
#. i18n: file: scripts/listwizard.kmdr:194
#: rc.cpp:1684 rc.cpp:1688
msgid ""
"Select or enter in this spin box the number of list entries or steps that "
"should be created by the wizard. After using the wizard, you can add (or "
"remove) more entries or steps manually."
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:191
#: rc.cpp:1686
msgid "Number of list items or steps:"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:218
#: rc.cpp:1690
msgid ""
"<qt>\n"
"Select the list type:\n"
"<ul>\n"
"<li><b>variablelist:</b> a list with two sections for each item: the term "
"and the definition.</li>\n"
"<li><b>itemizedlist:</b> a list  used when the order of the items is not "
"important.</li>\n"
"<li><b>orderedlist:</b> a list  used when the order of the items is "
"important (for instance, a list of things in order of preference). Do not "
"use orderedlist to describe the steps required to perform an action.</li>\n"
"<li><b>procedure:</b> list of an sequence of ordered steps, describing to "
"the reader how to perform a task. You can add substeps later.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:229
#: rc.cpp:1700
msgid "List Type"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:249
#: rc.cpp:1702
msgid "&procedure"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:285
#: rc.cpp:1704
msgid ""
"Select this option to create a procedure. A procedure is a sequence of "
"ordered steps, describing to the reader how to perform a task. You can add "
"nested substeps.\n"
"\n"
"Here is one example of a procedure:\n"
"\n"
"<procedure>\n"
"\n"
"<step><para>First step.</para></step>\n"
"\n"
"<step><para>Second step.</para>\n"
"<substeps>\n"
"<step><para>First substep of the second step.</para></step>\n"
"</substeps>\n"
"</step>\n"
"\n"
"</procedure>"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:293
#: rc.cpp:1720
msgid "itemi&zedlist"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:326
#: rc.cpp:1722
msgid ""
"Select this option to create a itemizedlist. A itemizedlist is a list used "
"when the order of the items is not important.\n"
"\n"
"Here is one example of a itemizedlist:\n"
"\n"
"<itemizedlist>\n"
"\n"
"<listitem><para>\n"
"First item.\n"
"</para></listitem>\n"
"\n"
"<listitem><para>\n"
"Second item.\n"
"</para></listitem>\n"
"\n"
"</itemizedlist>"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:340
#: rc.cpp:1738
msgid "or&deredlist"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:376
#: rc.cpp:1740
msgid ""
"Select this option to create a orderedlist. A orderedlist is a list  used "
"when the order of the items is important. A number will be associated with "
"each entry, in order, starting from one.\n"
"\n"
"Here is one example of a orderedlist:\n"
"\n"
"<orderedlist>\n"
"\n"
"<listitem><para>\n"
"First item.\n"
"</para></listitem>\n"
"\n"
"<listitem><para>\n"
"Second item.\n"
"</para></listitem>\n"
"\n"
"</orderedlist>"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:387
#: rc.cpp:1756
msgid "&variablelist"
msgstr ""

#. i18n: file: scripts/listwizard.kmdr:426
#: rc.cpp:1758
msgid ""
"Select this option to create a variablelist. A variablelist is a list with "
"two sections for each item: the term (the tag used is <term>) and the "
"definition (the tag used is <listitem>). To mark each entry of the list, the "
"<varlistentry> tag is used.\n"
"\n"
"Here is one example of a variablelist:\n"
"\n"
"<variablelist>\n"
"\n"
"<varlistentry>\n"
"<term>Term text</term>\n"
"<listitem><para>Definition text.</para></listitem>\n"
"</varlistentry>\n"
"\n"
"</variablelist>"
msgstr ""

#. i18n: file: scripts/picturewizard.kmdr:18
#: rc.cpp:1771
msgid "Docbook Image Wizard"
msgstr ""

#. i18n: file: scripts/picturewizard.kmdr:87
#: rc.cpp:1775
msgid ""
"Press this button to cancel the creation of the image markup. No action will "
"be performed."
msgstr ""

