#. i18n: file: lib/quanta.kcfg:94
#. i18n: ectx: label, entry, group (Autocompletion)
#: rc.cpp:2609
msgid "Enable auto-completion"
msgstr ""

#. i18n: file: lib/quanta.kcfg:95
#. i18n: ectx: whatsthis, entry, group (Autocompletion)
#: rc.cpp:2612
msgid ""
"If true, the completion hints are shown automatically as the user types. If "
"false, the completion hints can still be invoked manually."
msgstr ""

#. i18n: file: lib/quanta.kcfg:100
#. i18n: ectx: label, entry, group (Autocompletion)
#: rc.cpp:2615
msgid "Auto-close non single and non optional tags"
msgstr ""

#. i18n: file: lib/quanta.kcfg:101
#. i18n: ectx: whatsthis, entry, group (Autocompletion)
#: rc.cpp:2618
msgid ""
"If true, when the closing char for a non single and non optional tag is "
"entered, the corresponding closing tag is automatically inserted."
msgstr ""

#. i18n: file: lib/quanta.kcfg:107
#. i18n: ectx: whatsthis, entry, group (Autocompletion)
#: rc.cpp:2624
msgid ""
"If true, when the closing char for a tag is entered, and the closing tag for "
"this tag is optional, the corresponding closing tag is automatically "
"inserted."
msgstr ""

#. i18n: file: lib/quanta.kcfg:112
#. i18n: ectx: label, entry, group (Autocompletion)
#: rc.cpp:2627
msgid "Update opening/closing tags automatically"
msgstr ""

#. i18n: file: lib/quanta.kcfg:113
#. i18n: ectx: whatsthis, entry, group (Autocompletion)
#: rc.cpp:2630
msgid ""
"When this option is true the closing pair of a tag is automatically updated "
"when the opening tag is changed and vice-versa."
msgstr ""

#. i18n: file: lib/quanta.kcfg:119
#. i18n: ectx: whatsthis, entry, group (Autocompletion)
#: rc.cpp:2636
msgid ""
"If activated, the accented characters will be automatically replaced on "
"typing with their corresponding XML enitities."
msgstr ""

