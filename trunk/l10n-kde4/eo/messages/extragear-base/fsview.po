#: fsview_part.cpp:112
msgid ""
"<p>This is the FSView plugin, a graphical browsing mode showing filesystem "
"utilization by using a tree map visualization.</p>"
"<p>Note that in this mode, automatic updating when filesystem changes are "
"made is intentionally <b>not</b> done.</p>"
"<p>For details on usage and options available, see the online help under "
"menu 'Help/FSView Manual'.</p>"
msgstr ""

