#: view.cpp:32
msgid ""
"<h3>Rules of Game</h3>"
"<p>Your goal is to assemble lines of at least three similar diamonds. Click "
"on two adjacent diamonds to swap them.</p>"
"<p>Earn extra points by building cascades, and extra seconds by assembling "
"big lines or multiple lines at one time.</p>"
msgstr ""
