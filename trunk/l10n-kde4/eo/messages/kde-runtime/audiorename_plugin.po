#: audiopreview.cpp:51
msgid ""
"This audio file is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Ĉi tiu sondosiero ne estas konservita\n"
"ĉe la loka gastiganto.\n"
"Alklaku sur ĉi tiu etikedo por ŝargi ĝin.\n"

