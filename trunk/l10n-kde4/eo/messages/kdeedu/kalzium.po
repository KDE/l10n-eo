#. i18n: tag name
#. i18n: file data/knowledge.xml line 4
#: rc.cpp:795
msgid "State of matter"
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 5
#: rc.cpp:798
msgid ""
"Form of a substance; dependant on form stability and whether it takes up a "
"definite volume: solid, liquid or gaseous."
msgstr ""

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 7
#: rc.cpp:801
msgid "Boiling point"
msgstr "Bolpunkto"

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 8
#: rc.cpp:804
msgid "Melting point"
msgstr "Fandpunkto"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 12
#: rc.cpp:807
msgid "Chemical Symbol"
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 13
#: rc.cpp:810
msgid ""
"One, two, or three letter abbreviation; set through international convention."
msgstr "Unu-, du- aŭ trilitera mallongigo; elekta per internacia konvencio."

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 15
#. i18n: tag name
#. i18n: file data/knowledge.xml line 27
#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 117
#: rc.cpp:813 rc.cpp:828 rc.cpp:963
msgid "Element"
msgstr "Elemento"

#. i18n: tag name
#. i18n: file data/knowledge.xml line 19
#: rc.cpp:816
msgid "Chromatography"
msgstr "Kromatografio"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 20
#: rc.cpp:819
msgid ""
"Matter separation in a moving medium (mobile phase) through differentiated "
"absorption on a static medium (stationary phase)."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 23
#: rc.cpp:822
msgid "Distillation"
msgstr "Distilado"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 24
#: rc.cpp:825
msgid ""
"Separation of a liquid solution (homogeneous mix) into its components "
"through evaporation and condensation. In a fractionary distillation the "
"process is repeated several times in a column."
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 28
#: rc.cpp:831
msgid ""
"Matter that cannot be broken down into simpler matter. Chemical elements are "
"cornerstones of Materials. Elements consist of atoms that consist of a "
"nucleus of positive protons, neutral neutrons, and a shell of electrons."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 31
#: rc.cpp:834
msgid "Emulsion"
msgstr "Emulsio"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 32
#: rc.cpp:837
msgid "Heterogeneous mix of two liquids."
msgstr "Heterogena miksaĵo de du likvoj."

#. i18n: tag name
#. i18n: file data/knowledge.xml line 35
#: rc.cpp:840
msgid "Extraction"
msgstr "Ekstraktado"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 36
#: rc.cpp:843
msgid "Processing a homogeneous or heterogeneous mix to get pure matter."
msgstr ""

#. i18n: tag refitem
#. i18n: file data/knowledge.xml line 38
#. i18n: tag name
#. i18n: file data/knowledge.xml line 46
#: rc.cpp:846 rc.cpp:855
msgid "Mix"
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 42
#: rc.cpp:849
msgid "Filtering"
msgstr "Filtrado"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 43
#: rc.cpp:852
msgid ""
"Separation of a solid matter from a liquid matter or gaseous matter with a "
"filter (porous separation wall)."
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 47
#: rc.cpp:858
msgid ""
"Matter consisting of differentiated matter, combined in non-set ratios. [i]"
"Homogeneous mixes[/i] have a coherent look, [i]heterogeneous mixes[/i] "
"consist of multiple phases."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 50
#: rc.cpp:861
msgid "Accuracy"
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 51
#: rc.cpp:864
msgid "Consisting of accidental and systematic errors."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 54
#: rc.cpp:867
msgid "Law of Conservation of Mass"
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 55
#: rc.cpp:870
msgid ""
"During a chemical reaction mass is neither lost nor gained. The sum mass of "
"the material going into the reaction equals the sum of the mass of the "
"products of the reaction."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 58
#: rc.cpp:873
msgid "Law of multiple proportions"
msgstr ""

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 59
#: rc.cpp:876
msgid ""
"An alloy always contains the same elements in the same mass ratio. Should "
"two or more elements bind together then the mass ratio is constant."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 62
#: rc.cpp:879
msgid "Crystallization"
msgstr "Kristaliĝo"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 63
#: rc.cpp:882
msgid ""
"Separation of solid, crystalline matter from a solution, or the liquid or "
"gaseous phases."
msgstr ""

#. i18n: tag name
#. i18n: file data/knowledge.xml line 66
#: rc.cpp:885
msgid "Solution"
msgstr "Solvaĵo"

#. i18n: tag desc
#. i18n: file data/knowledge.xml line 67
#: rc.cpp:888
