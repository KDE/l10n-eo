msgid ""
"An IP address is an unique identifier of a networking device in an TCP/IP "
"network"
msgstr ""

#. i18n: tag string
#. i18n: file kadddevicedlg.ui line 177
#: rc.cpp:29
msgid "IP address for the network device"
