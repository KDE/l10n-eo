#: setupwizard.cpp:373
#, fuzzy
#| msgid ""
#| "<br>Your LAN browsing has been successfully set up.<br><br>Make sure that "
#| "the LISa server is started during the boot process. How this is done "
#| "depends on your distribution and OS. Usually you have to insert it "
#| "somewhere in a boot script under <code>/etc</code>.<br>Start the LISa "
