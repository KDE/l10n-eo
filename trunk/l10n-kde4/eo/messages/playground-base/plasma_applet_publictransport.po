#: journeysearchparser.cpp:82
#, fuzzy, kde-format
#| msgid " minutes"
msgctxt ""
"The automatically added relative time string, when the journey search line "
"ends with the keyword 'in'. This should be match by the regular expression "
"for a relative time, like '(in) 5 minutes'. That regexp and the keyword "
"('in') are also localizable. Don't include the 'in' here."
msgid "%1 minutes"
msgstr "minutoj"

#: journeysearchparser.cpp:95
msgctxt ""
"This is a regular expression used to match a string after the 'in' keyword "
"in the journey search line. The english version matches 'strings like '5 "
"mins.', '1 minute', ... '\\d+' stands for at least 'one digit, '\\.' is just "
"a point, a '?' after a character means that it's optional (eg. the 's' in "
"'mins?' is optional to match singular and plural forms). Normally you will "
"only have to translate 'mins?' and 'minutes?'. The regexp must include one "
"pair of matching 'parantheses, that match an int (the number of minutes from "
"now). Note: '(?:...)' are non-matching parantheses."
msgid "(\\d+)\\s+(?:mins?\\.?|minutes?)"
msgstr ""

