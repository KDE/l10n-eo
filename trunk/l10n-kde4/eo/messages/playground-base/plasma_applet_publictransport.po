#: journeysearchparser.cpp:35
msgctxt ""
"A comma seperated list of keywords for the journey search to indicate that "
"given times are meant as arrivals. The order is used for autocompletion.\n"
"Note: Keywords should be unique for each meaning."
msgid "arriving,arrive,arrival,arr"
msgstr ""

#: journeysearchparser.cpp:42
msgctxt ""
"A comma seperated list of keywords for the journey search to indicate that "
"given times are meant as departures (default). The order is used for "
"autocompletion.\n"
"Note: Keywords should be unique for each meaning."
msgid "departing,depart,departure,dep"
msgstr ""

#: journeysearchparser.cpp:48
msgctxt ""
"A comma seperated list of keywords for the journey search, indicating that a "
"journey FROM the given stop should be searched. This keyword needs to be "
"placed at the beginning of the field."
msgid "from"
msgstr ""

#: journeysearchparser.cpp:55
