#: kateconsole.cpp:55
msgid "Konsole"
msgstr "Konzolo"

#: kateconsole.cpp:55
msgid "Embedded Konsole"
msgstr "Enkorpigita konzolo"

#: kateconsole.cpp:63
msgid "You do not have enough karma to access a shell or terminal emulation"
msgstr "S&ynchronize Terminal with Current Document"

#: kateconsole.cpp:89 kateconsole.cpp:114
msgid "Terminal"
msgstr "Terminalo"

#: kateconsole.cpp:95
msgid "Terminal Settings"
msgstr "Agordoj de terminalo"

#: kateconsole.cpp:146
msgctxt "@action"
msgid "&Pipe to Terminal"
msgstr "Transmeti al &terminalo"

#: kateconsole.cpp:150
msgctxt "@action"
msgid "S&ynchronize Terminal with Current Document"
msgstr "S&inkronigi terminalon per aktuala dokumento"

#: kateconsole.cpp:155
msgctxt "@action"
msgid "&Focus Terminal"
msgstr "En&fokusigi terminalon"

#: kateconsole.cpp:239
msgid ""
"Do you really want to pipe the text to the console? This will execute any "
"contained commands with your user rights."
msgstr ""
"Ĉu vi vere volas transmeti la tekston al konzolo? Tio rulos ĉiujn enhavitajn"
"komandojn laŭ viaj uzantrajtoj."

#: kateconsole.cpp:240
msgid "Pipe to Terminal?"
msgstr "Ĉu transmeti al terminalo?"

#: kateconsole.cpp:241
msgid "Pipe to Terminal"
msgstr "Transmeti al terminalo"

#: kateconsole.cpp:262
#, kde-format
msgid "Sorry, can not cd into '%1'"
msgstr "Pardonu, ne povas cd en '%1'"

#: kateconsole.cpp:278 kateconsole.cpp:294
msgid "Defocus Terminal"
msgstr "Malfokusigi terminalon"

#: kateconsole.cpp:287
msgid "Focus Terminal"
msgstr "Enfokusigi terminalon"

#: kateconsole.cpp:318
msgid ""
"&Automatically synchronize the terminal with the current document when "
"possible"
msgstr "&Aŭtomate sinkronigi la terminalon kun la aktuala dokumento kiam eble"

#: kateconsole.cpp:320
msgid "Set &EDITOR environment variable to 'kate -b'"
msgstr "Agordi ĉirkaŭaĵvariablon &EDITOR al 'kate -b'"

#: kateconsole.cpp:323
msgid ""
"Important: The document has to be closed to make the console application "
"continue"
msgstr "Grava: la dokumento devas esti fermita por daŭrigi la konzolon"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
