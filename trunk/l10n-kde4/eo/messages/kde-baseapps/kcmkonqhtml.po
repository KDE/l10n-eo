#: jspolicies.cpp:163
msgid "Accept all popup window requests."
msgstr "Akcepti ĉiujn petojn de ŝprucfenestroj."

#: jspolicies.cpp:168
msgid "Ask"
msgstr "Demandi"

#: jspolicies.cpp:169
msgid "Prompt every time a popup window is requested."
