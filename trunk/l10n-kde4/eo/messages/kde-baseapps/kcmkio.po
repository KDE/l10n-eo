msgstr "Surdiska &kaŝmemora grando:"

#. i18n: ectx: property (suffix), widget (KIntNumInput, sbMaxCacheSize)
#: cache.ui:101
msgid " KiB"
msgstr " KiB"

#. i18n: ectx: property (text), widget (QPushButton, clearCacheButton)
#: cache.ui:111
