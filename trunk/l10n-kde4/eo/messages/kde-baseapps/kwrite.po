#: kwriteapp.cpp:37 kwritemain.cpp:474
msgid ""
"A KDE text-editor component could not be found.\n"
"Please check your KDE installation."
msgstr ""
"Ne povis trovi KDE-tekstredaktilo-parton;\n"
"bonvolu kontroli vian KDE-instalon."

#: kwriteapp.cpp:145
#, kde-format
msgid ""
"The file '%1' could not be opened: it is not a normal file, it is a folder."
msgstr "Ne povis malfermi '%1': ne estas dosiero, estas dosierujo."

#: kwritemain.cpp:138
msgid "Use this command to close the current document"
msgstr "Per ĉi tio vi povas fermi la nunan dokumenton"

#: kwritemain.cpp:142
msgid "Use this command to create a new document"
msgstr "Per ĉi tiu komando vi povas krei novan dokumenton"

#: kwritemain.cpp:144
msgid "Use this command to open an existing document for editing"
msgstr ""
"Per ĉi tiu komando vi povas malfermi ekzistantan dokumenton por redaktado"

#: kwritemain.cpp:148
msgid ""
"This lists files which you have opened recently, and allows you to easily "
"open them again."
msgstr ""
"Ĉi tio listigas dosierojn kiujn vi malfermis antaŭ nelonge, kaj permesas la "
"rapidan malfermon de ili denove."

#: kwritemain.cpp:152
msgid "&New Window"
msgstr "&Nova fenestro"

#: kwritemain.cpp:154
msgid "Create another view containing the current document"
msgstr "Krei alian rigardon kiu enhavas la nunan dokumenton"

#: kwritemain.cpp:157
msgid "Close the current document view"
msgstr "Fermi la nunan dokumentan rigardon"

#: kwritemain.cpp:164
msgid "Use this command to show or hide the view's statusbar"
msgstr ""
"Per ĉi tiu komando vi povas montri aŭ kaŝi la statobreton de la rigardo"

#: kwritemain.cpp:166
msgid "Sho&w Path"
msgstr "Videbligi &vojon"

#: kwritemain.cpp:169
msgid "Show the complete document path in the window caption"
msgstr "Videbligi la tutan dokumentvojon en la titoleto de la fenestro"

#: kwritemain.cpp:172
msgid "Configure the application's keyboard shortcut assignments."
msgstr "Agordi la klavkombinojn por la aplikaĵo."

#: kwritemain.cpp:176
msgid "Configure which items should appear in the toolbar(s)."
msgstr "Agordi la erojn en la ilobreto(j)."

#: kwritemain.cpp:179
msgid "&About Editor Component"
msgstr "&Pri la redaktilo-parto"

#: kwritemain.cpp:188 kwritemain.cpp:539
#, kde-format
msgctxt "@info:status Statusbar label for cursor line and column position"
msgid " Line: %1 Col: %2 "
