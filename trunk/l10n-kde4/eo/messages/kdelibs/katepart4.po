msgid "&Indent"
msgstr "&Deŝovo"

#: view/kateview.cpp:304
msgid ""
"Use this to indent a selected block of text.<br /><br />You can configure "
"whether tabs should be honored and used or replaced with spaces, in the "
"configuration dialog."
msgstr ""

