"Igas legosignojn en linioj, kiuj kongruas al ŝablono, kiam dokumentoj estas "
"ŝargataj"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Enmeti dosieron"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:93
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Enmeti iun legeblan dosieron je ĉi tiu kursora pozicio"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data Tools"
msgstr "Datumiloj"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:82
msgctxt "Comment"
