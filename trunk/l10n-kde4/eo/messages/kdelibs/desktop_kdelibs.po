#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Interna tekstredaktilo"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:5
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"La tekstredaktila servo donas vin aplikaĵojn kun tekstrigardilo kaj "
"redaktilo. KDE aplikaĵoj kiuj volas uzi tekstredakton uzu tiun ĉi servon."

#: interfaces/ktexteditor/ktexteditor.desktop:6
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Interna redaktilo (kun apartigo de dokumento kaj rigardo)"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:6
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "Tekstredaktilo kromaĵo"

#: kate/data/katepart.desktop:3
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Interna tekstredaktilo"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:3
msgctxt "Name"
msgid "KTextEditor Autobookmarker"
msgstr "KTextEditor Aŭtomata legosignigilo"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:7
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Igas legosignojn en linioj, kiuj konvenas ŝablonon, kiam dokumentoj estas "
"ŝarĝataj"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:3
msgctxt "Name"
msgid "KTextEditor Insert File Plugin"
msgstr "KTextEditor Enmetu-Dosieron-kromaĵo"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:7
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Enmetu iun legeblan dosieron je ĉi tiu posicio"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:3
msgctxt "Name"
msgid "KTextEditor KDataTool Plugin"
msgstr "KTextEditor KDataTool Kromaĵo"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:7
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr "Enŝaltu datumiloj kiel \"thesaurus\" kaj literumado (se instalita)"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:3
msgctxt "Name"
msgid "KTextEditor Word Completion Plugin"
msgstr "KTextEditor Vortotutiga kromaĵo"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:7
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
msgstr "Regula aŭ ekfenestra tutigo de vortoj en la dokumento"

