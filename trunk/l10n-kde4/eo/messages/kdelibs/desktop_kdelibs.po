#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Interna tekstredaktilo"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:66
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"La tekstredaktila servo donas vin aplikaĵojn kun tekstrigardilo kaj "
"redaktilo. KDE aplikaĵoj kiuj volas uzi tekstredakton uzu tiun ĉi servon."

