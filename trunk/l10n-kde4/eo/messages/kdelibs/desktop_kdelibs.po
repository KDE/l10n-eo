msgstr "Enkorpigita altnivela tekstredaktilo"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Aŭtomata legosignigilo"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:77
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
