"Igas legosignojn en linioj, kiuj konvenas ŝablonon, kiam dokumentoj estas "
"ŝarĝataj"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:18
msgctxt "Name"
msgid "Insert File"
msgstr "Enmeti Dosieron"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:54
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Enmetu iun legeblan dosieron je ĉi tiu posicio"

