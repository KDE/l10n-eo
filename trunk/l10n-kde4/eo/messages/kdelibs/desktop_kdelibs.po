#: kate/plugins/timedate/ktexteditor_timedate.desktop:8
#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:8
msgctxt "X-KDE-PluginInfo-Category"
msgid "Editor"
msgstr "Redaktilo"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:38
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Aŭtomata legosignigilo"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:90
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Igas legosignojn en linioj, kiuj kongruas al ŝablono, kiam dokumentoj estas "
"ŝargataj"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:39
msgctxt "Name"
msgid "Insert File"
msgstr "Enmeti dosieron"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:95
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Enmeti iun legeblan dosieron je ĉi tiu kursora pozicio"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:39
msgctxt "Name"
msgid "Data tools"
msgstr "Datumilo"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:95
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr "Enŝalti datumilojn kiel \"thesaurus\" kaj literumilo (se instalita)"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:38
msgctxt "Name"
msgid "Time & Date"
msgstr "Tempo kaj dato"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:88
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Enmeti nunan tempon kaj daton"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:9
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Aranĝo de la tempa kaj data enmeto"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:39
msgctxt "Name"
msgid "Word Completion"
msgstr "Vortkompletigo"

#: kate/plugins/wordcompletion/ktexteditor_docwordcompletion.desktop:95
msgctxt "Comment"
msgid "Directional or popup-based completion from words in the document"
