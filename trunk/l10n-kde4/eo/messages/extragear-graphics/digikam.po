#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:170
msgid "Brighten:"
msgstr ""

#: imageplugins/lenscorrection/distortion/lensdistortiontool.cpp:176
msgid "This value adjusts the brightness in image corners."
msgstr ""

