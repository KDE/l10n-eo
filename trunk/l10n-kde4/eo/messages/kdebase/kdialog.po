msgstr "\"Pardonpeto\" dialogujo"

#: kdialog.cpp:646
msgid "'Error' message box"
msgstr "\"Eraro\" dialogujo"

#: kdialog.cpp:647
msgid "Message Box dialog"
msgstr "Informa dialogujo"

#: kdialog.cpp:648
msgid "Input Box dialog"
msgstr "Enmeta dialogujo"

#: kdialog.cpp:649
msgid "Password dialog"
msgstr "Pasvorta dialogujo"

#: kdialog.cpp:650
msgid "Text Box dialog"
msgstr "Dosiermontra dialogujo"

#: kdialog.cpp:651
msgid "Text Input Box dialog"
msgstr "Enmeta dialogujo kun teksto"

#: kdialog.cpp:652
msgid "ComboBox dialog"
msgstr "Redaktebla falmenua dialogujo"

#: kdialog.cpp:653
msgid "Menu dialog"
msgstr "Menua dialogujo"

#: kdialog.cpp:654
msgid "Check List dialog"
msgstr "Markolista dialogujo"

#: kdialog.cpp:655
msgid "Radio List dialog"
msgstr "Radiolista dialogujo"

#: kdialog.cpp:656
msgid "Passive Popup"
msgstr "Senfokusa ŝpruc-dialogujo"

#: kdialog.cpp:657
msgid "File dialog to open an existing file"
msgstr "Dosiera dialogujo kiu malfermos dosieron"

#: kdialog.cpp:658
msgid "File dialog to save a file"
msgstr "Dosiera dialogujo kiu konservos novan dosieron"

#: kdialog.cpp:659
msgid "File dialog to select an existing directory"
msgstr "Dosiera dialogujo kiu elektos ekzistantan dosierujon"

#: kdialog.cpp:660
msgid "File dialog to open an existing URL"
msgstr "Dosiera dialogujo kiu malfermos ekzistantan retadreson"

#: kdialog.cpp:661
msgid "File dialog to save a URL"
msgstr "Dosiera dialogujo kiu konservos retadreson"

#: kdialog.cpp:662
msgid "Icon chooser dialog"
msgstr "Dialogujo por elekti piktogramon"

#: kdialog.cpp:663
msgid "Progress bar dialog, returns a D-Bus reference for communication"
msgstr ""
"Plenumindikila dialogujo, kiu liveras referencon uzante DCOP-on por montri "
"ŝanĝojn en la indikilo"

#: kdialog.cpp:665
msgid "Dialog title"
msgstr "Dialoga titolo"

#: kdialog.cpp:666
msgid "Default entry to use for combobox and menu"
msgstr "Defaŭlta teksto por redaktebla falmenuo kaj menuo"

#: kdialog.cpp:667
msgid ""
"Allows the --getopenurl and --getopenfilename options to return multiple "
"files"
msgstr ""
"Permesas ke la --getopenurl kaj --getopenfilename parametroj liveras plurajn "
"dosierojn"

#: kdialog.cpp:668
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr ""
"Liveras listajn erojn sur apartaj linioj (por markolistaj elektoj kaj la "
"malfermi dosieron kun la parametro --multiple)"

#: kdialog.cpp:669
msgid "Outputs the winId of each dialog"
msgstr "Liveras la fenestran identigilon (winId) por ĉiu dialogo"

#: kdialog.cpp:670
msgid "Makes the dialog transient for an X app specified by winid"
msgstr ""
"Igas la dialogujon pasema por X-aplikaĵo kiu estas difinita per winid "
"(fenestra identigilo)"

#: kdialog.cpp:671
msgid ""
"Config file and option name for saving the \"don't-show/ask-again\" state"
msgstr ""
"Agorda dosiero kaj parametra nomo por la konservo de la \"ne montri/demandi "
"ree\" stato"

#: kdialog.cpp:672
msgid "Arguments - depending on main option"
msgstr "Argumentoj - dependas de ĉefa opcio"

