#: fileprops.cpp:230
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
#, fuzzy
#| msgid "A commandline tool to read and modify metadata of files."
msgid "A command-line tool to read and modify metadata of files."
msgstr "Komandlinia ilo por legi kaj redakti la metadatumon de dosierojn."

#: fileprops.cpp:232
msgid "(c) 2002, Carsten Pfeiffer"
msgstr "(c) 2002, Carsten Pfeiffer"

#: fileprops.cpp:236
msgid "Carsten Pfeiffer"
msgstr "Carsten Pfeiffer"

#: fileprops.cpp:245
msgid "Do not print the mimetype of the given file(s)"
msgstr "Ne printi la mime tipon de la donita(j)n dosiero(j)n"

#: fileprops.cpp:247
msgid "List all supported metadata keys."
msgstr "Listigi ĉiujn subtenatajn metadatumajn ĉenojn."

#: fileprops.cpp:249
msgid "List all metadata keys which have a value in the given file(s)."
msgstr ""
"Listigi ĉiujn metadatumajn ĉenojn kiuj havas valoron en la donita(j) "
"dosiero(j)."

#: fileprops.cpp:252
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"Ne printi averton kiam pli ol unu dosiero estas kaj ili ne havas la saman "
"mime tipon."

#: fileprops.cpp:255
msgid "Prints all metadata values, available in the given file(s)."
msgstr ""
"Printas ĉiujn metadatumajn valorojn, legeblaj en la donita(j) dosiero(j)."

#: fileprops.cpp:257
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Malfermas KDE ecofenestron por ebligi vidi kaj redakti la metadatumon de la "
"donita(j) dosiero(j)"

#: fileprops.cpp:259
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Printas la valoron de 'ĉeno' de la donita(j) dosiero(j). 'ĉeno' ankaŭ povas "
"esti komapartita ĉena listo"

#: fileprops.cpp:261
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""
"Provas meti la valoron 'valoro' por la metadatuma ĉeno 'ĉeno' por la "
"donita(j) dosiero(j)"

#: fileprops.cpp:263
msgid "The file (or a number of files) to operate on."
msgstr "La dosiero(j) taskota(j)."

#: fileprops.cpp:277
msgid "No files specified"
msgstr "Neniu dosiero specifita"

#: fileprops.cpp:297
msgid "Cannot determine metadata"
msgstr "Ne eblas determini la metadatumon"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Pierre-Marie Pédrot"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
