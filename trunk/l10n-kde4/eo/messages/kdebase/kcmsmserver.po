#: kcmsmserver.cpp:48
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed, whether the session should be restored again when logging in and "
"whether the computer should be automatically shut down after session exit by "
"default."
msgstr ""
"<h1>Seancadministrilo</h1> Vi povas agordi la seancoadministrilon tie ĉi. "
"Tio estas ekzemple, ĉu adiaŭo okazos nur post konfirmo, ĉu la seanco "
"konserviĝu kaj ĉu normale la komputilo aŭtomate malŝaltiĝu post fino de la "
"seanco."

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 13
#: rc.cpp:3
msgid "Session Manager"
msgstr "Seancoadministrilo"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 34
#: rc.cpp:6
msgid "General"
msgstr "Ĝenerale"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 40
#: rc.cpp:9
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""
"Enŝaltu, se la seancoadministrilo montru adiaŭokonfirman dialogfenestron."

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 43
#: rc.cpp:12
msgid "Conf&irm logout"
msgstr "Konf&irmi adiaŭon"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 50
#: rc.cpp:15
msgid "O&ffer shutdown options"
msgstr "O&ferti sistemfermajn opciojn"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 64
#: rc.cpp:18
msgid ""
"<ul>\n"
"<li><b>Restore previous session:</b> Will save all applications running on "
"exit and restore them when they next start up</li>\n"
"<li><b>Restore manually saved session: </b> Allows the session to be saved "
"at any time via \"Save Session\" in the K-Menu. This means the currently "
"started applications will reappear when they next start up.</li>\n"
"<li><b>Start with an empty session:</b> Do not save anything. Will come up "
"with an empty desktop on next start.</li>\n"
"</ul>"
msgstr ""

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 67
#: rc.cpp:25
msgid "On Login"
msgstr "Ĉe saluto"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 73
#: rc.cpp:28
msgid "Restore &previous session"
msgstr "&Restarigi antaŭan seancon"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 80
#: rc.cpp:31
msgid "Restore &manually saved session"
msgstr "Restarigi &mane konservitan seancon"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 87
#: rc.cpp:34
msgid "Start with an empty &session"
msgstr "Komenci kun malplena &seanco"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 97
#: rc.cpp:37
msgid ""
"Here you can choose what should happen by default when you log out. This "
"only has meaning, if you logged in through KDM."
msgstr ""
"Tie ĉi vi povas elekti, kio okazu normale ĉe seancofino. Tio havas signifon "
"nur se vi lanĉis KDE per la grafika salutilo \"KDM\"."

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 100
#: rc.cpp:40
msgid "Default Shutdown Option"
msgstr "Apriora sistemfermo-opcio"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 106
#: rc.cpp:43
msgid "&End current session"
msgstr "Fini aktualan s&eancon"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 113
#: rc.cpp:46
msgid "&Turn off computer"
msgstr "Malŝal&ti komputilon"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 120
#: rc.cpp:49
msgid "&Restart computer"
msgstr "&Relanĉi komputilon"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 130
#: rc.cpp:52
msgid "Advanced"
msgstr "Pluaj"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 136
#: rc.cpp:55
msgid "Applications to be e&xcluded from sessions:"
msgstr "Aplikaĵoj e&kskludendaj de seancoj:"

#. i18n: tag string
#. i18n: file smserverconfigdlg.ui line 149
#: rc.cpp:58
msgid ""
"Here you can enter a comma-separated list of applications that should not be "
"saved in sessions, and therefore will not be started when restoring a "
"session. For example 'xterm,xconsole'."
msgstr ""
