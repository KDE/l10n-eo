msgstr "Lokigostrategio:"

#: windows.cpp:923
msgid "Smart"
msgstr "Inteligenta"

#: windows.cpp:924
#, fuzzy
msgid "Maximizing"
msgstr "Maksimumigo"

#: windows.cpp:925
