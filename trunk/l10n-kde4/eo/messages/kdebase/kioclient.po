"  kioclient exec file:/root/Desktop/cdrom.desktop\n"
"             // Malfermas la surmetitan dosierujon de la KD\n"
"\n"

#: kioclient.cpp:102
msgid ""
"  kioclient exec .\n"
"             // Opens the current directory. Very convenient.\n"
"\n"
msgstr ""
"  kioclient exec .\n"
"             // Malfermas la nunan dosierujon. Estas utile.\n"
"\n"

