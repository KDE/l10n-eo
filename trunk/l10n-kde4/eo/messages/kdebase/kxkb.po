#. i18n: tag string
#. i18n: file kcmlayoutwidget.ui line 392
#: rc.cpp:101
msgid ""
"This is a shortcut for switching layouts which is handled by X.org. It "
"allows modifier-only shortcuts."
msgstr ""
"Ĉi tiu fulmoklavo por ŝanĝo de klavararanĝoj estas traktita de X.org. Ĝi "
"permesas la uzon de nur modifaj klavoj kiel fulmoklavoj."

#. i18n: tag string
