#: random.cpp:44
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Uzo: %1 [-setup] [args]\n"
"Lanĉas hazardan ekrankurtenon.\n"
"Ĉiuj argumentoj (krom -setup) trairas al la ekrankurteno."

#: random.cpp:51
msgid "Start a random KDE screen saver"
msgstr "Lanĉi hazardan ekrankurtenon"

#: random.cpp:59
msgid "Random screen saver"
msgstr "Hazarda ekrankurteno"

#: random.cpp:64
msgid "Setup screen saver"
msgstr "Agordi ekrankurtenon"

#: random.cpp:66
msgid "Run in the specified XWindow"
msgstr "Lanĉi en la donita XFenestro."

#: random.cpp:68
msgid "Run in the root XWindow"
msgstr "Lanĉi en la radika XFenestro."

#: random.cpp:214
msgid "Setup Random Screen Saver"
msgstr "Agordi hazardan ekrankurtenon"

#: random.cpp:223
msgid "Use OpenGL screen savers"
msgstr "Uzi ekrankurtenon por OpenGL"

#: random.cpp:226
msgid "Use screen savers that manipulate the screen"
msgstr "Uzi ekrankurtenojn, kiuj manipulas la ekranon"

