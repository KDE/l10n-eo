#: ProcessModel.cc:831
msgid ""
"<b>Init</b> is the parent of all other processes and cannot be killed.<br/>"
msgstr ""
"<b>Init</b> estas la patro de ĉiuj aliaj procezoj, ne povas esti mortigita."
"<br/>"

#: ProcessModel.cc:833
msgid ""
"<b>KThreadd</b> manages kernel threads. The children processes run in the "
"kernel, controlling hard disk access etc.<br/>"
msgstr ""
"<b>KThreadd</b> direktas kernajn fadenojn. La idaj procezoj ruliĝas en la "
"kerno, kaj direktas diskan aliron, ktp.<br/>"

