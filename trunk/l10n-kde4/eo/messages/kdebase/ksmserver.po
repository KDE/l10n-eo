#: main.cpp:51
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"La fidinda KDE-seancadministrilo kiu parolas la norman X11R6-seancadministran "
"protokolon XSMP."

#: main.cpp:197
msgid "The KDE Session Manager"
msgstr "La KDE-seanco-administrilo"

#: main.cpp:199
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, The KDE Developers"

#: main.cpp:200
msgid "Matthias Ettrich"
msgstr "Matthias Ettrich"

#: main.cpp:201
msgid "Luboš Luňák"
msgstr "Luboš Luňák"

#: main.cpp:201
msgid "Maintainer"
msgstr "Prizorganto"

#: main.cpp:207
msgid "Restores the saved user session if available"
msgstr "Restarigas la antaŭan uzantoseancon, se ekzistas"

#: main.cpp:209
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Lanĉas 'wm', se neniu alia fenstroadministrilo partoprensas\n"
"en la seanco. La defaŭlta estas 'kwin'"

#: main.cpp:210
msgid "Also allow remote connections"
msgstr "Permesi ankaŭ forajn konektojn"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Wolfram Diestel,Steffen Pietsch"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "wolfram@steloj.de,Steffen.Pietsch@BerlinOnline.de"

#: shutdown.cpp:355
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "'%1' nuligis la elsaluton"

#: shutdowndlg.cpp:364
#, kde-format
msgid "End Session for %1"
msgstr "Fini seancon por %1"

#: shutdowndlg.cpp:366
#, kde-format
msgid "End Session for %1 (%2)"
msgstr "Fini seancon por %1 (%2)"

#: shutdowndlg.cpp:383
msgid "Logout"
msgstr "Elsaluto"

#: shutdowndlg.cpp:391
msgid "Turn Off Computer"
msgstr "Malŝalti la komputilon"

#: shutdowndlg.cpp:404
msgid "Standby"
msgstr "Suspendi"

#: shutdowndlg.cpp:408
msgid "Suspend to RAM"
msgstr "Suspendi al RAM"

#: shutdowndlg.cpp:412
msgid "Suspend to Disk"
msgstr "Suspendi al disko"

#: shutdowndlg.cpp:418
msgid "Restart Computer"
msgstr "Relanĉi la komputilon"

