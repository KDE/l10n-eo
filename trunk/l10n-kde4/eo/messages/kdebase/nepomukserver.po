#: nepomukserverkcm.cpp:110
msgid ""
"The Nepomuk Server KDED module is not running. The settings have been saved "
"and will be used the next time the server is started."
msgstr ""
"La KDED-modulo de Nepomuk-servilo ne ruliĝas. La agordo estas konservita kaj "
"estos uzita kiam la servilo lanĉiĝas."

#. i18n: tag string
