#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Ne povas emfazi menueron '%1'."

#: kde-menu.cpp:106
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""
"KDE-menua informpetilo.\n"
"Ĉi tiun ilon vi povas uzi por trovi la menuon en kiu serĉata aplikaĵo "
"montriĝas.\n"
"La --highlight-opcion vi povas uzi por krei videblan indikilon de kie\n"
" en la menuo la aplikaĵo troviĝas."

#: kde-menu.cpp:111
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:113
msgid "(c) 2003 Waldo Bastian"
msgstr "(c) 2003 Waldo Bastian"

#: kde-menu.cpp:114
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:114
msgid "Author"
msgstr "Aŭtoro"

#: kde-menu.cpp:119
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Montri la datumojn en UTF-8 anstataŭ la loka kodoprezento"

#: kde-menu.cpp:120
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Montri menu-identigilon de la menuo kiu enhavas\n"
"la aplikaĵon"

#: kde-menu.cpp:121
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Montri nomon (apudskribon) de la menuo kiu\n"
"enhavas la aplikaĵon"

#: kde-menu.cpp:122
msgid "Highlight the entry in the menu"
msgstr "Emfazi la menueron"

#: kde-menu.cpp:123
msgid "Do not check if sycoca database is up to date"
msgstr "Ne kontrolu ĉu sycoca-datumbazo estas ĝisdatigita"

#: kde-menu.cpp:124
msgid "The id of the menu entry to locate"
msgstr "La identigilo de la serĉata menuero"

#: kde-menu.cpp:133
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Vi devas difini aplikaĵan identigilon kiel 'kde4-konsole.desktop'"

#: kde-menu.cpp:142
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Vi devas difini almenaŭ unu el --print-menu-id, --print-menu-name aŭ --"
"highlight (montri menu-identigilon, montri menunomon, aŭ emfazi)"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "neniu menuero '%1'."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "Menuero '%1' ne estas trovita en menuo."

