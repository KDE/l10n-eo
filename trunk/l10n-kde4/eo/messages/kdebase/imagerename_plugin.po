#: image_plugin.cpp:71
msgid "You want to overwrite the left picture with the one on the right."
msgstr "Vi volas anstataŭigi la maldekstran bildon per la unu dekstre."

#: imagevisualizer.cpp:46
msgid ""
"This picture is not stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"Ĉi tiu bildo ne staras\n"
"ĉe loka gastiganto.\n"
"Klaku sur ĉi tiu etikedo por ŝargi ĝin.\n"

#: imagevisualizer.cpp:54
msgid "Unable to load image"
msgstr "Ne eblas ŝargi la bildon"

