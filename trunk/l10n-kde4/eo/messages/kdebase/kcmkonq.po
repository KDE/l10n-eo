#~ msgstr "&Permesi programojn en la labortabla ekrano"

#~ msgid "Show &tooltips"
#~ msgstr "&Montri dosierinformeton"

#~ msgid "Menu Bar at top of Screen"
#~ msgstr "Menubreto supre de la ekrano"

#~ msgid ""
