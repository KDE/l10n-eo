#: clock.cpp:124
msgctxt "@title:window"
msgid "Configure Clock"
msgstr "Agordi la horloĝon"

#. i18n: tag string
#. i18n: file clockConfig.ui line 64
#: rc.cpp:3
msgid "Area"
msgstr "Zono"

#. i18n: tag string
#. i18n: file clockConfig.ui line 69
#: rc.cpp:6
msgid "Region"
msgstr "Regiono"

#. i18n: tag string
#. i18n: file clockConfig.ui line 74
#: rc.cpp:9
msgid "Comment"
msgstr "Komento"

#. i18n: tag string
#. i18n: file clockConfig.ui line 82
#: rc.cpp:12
msgid "Display the second hand"
msgstr "Montri la duan nadlon"

#. i18n: tag string
#. i18n: file clockConfig.ui line 85
#: rc.cpp:15
msgid ""
"Check this if you want to display the second hand in order to see the "
"seconds."
msgstr "Ŝaltu tion se vi volas montrigi la duan nadlon por vidi la sekundojn."

#. i18n: tag string
#. i18n: file clockConfig.ui line 88
#: rc.cpp:18
msgid "Display seconds"
msgstr "Montri sekundojn"

#. i18n: tag string
#. i18n: file clockConfig.ui line 95
#: rc.cpp:21
msgid "Display the time as a string"
msgstr "Montras la tempon kiel ĉeno"

#. i18n: tag string
#. i18n: file clockConfig.ui line 98
#: rc.cpp:24
msgid ""
"Check this if you want to display the time as a string within the clock."
msgstr "Ŝaltu tion se vi volas montri la tempon kiel ĉeno en la horloĝo."

#. i18n: tag string
#. i18n: file clockConfig.ui line 101
#: rc.cpp:27
msgid "Also display the time in text"
msgstr "Ankaŭ montri la tempon kiel teksto"

#. i18n: tag string
#. i18n: file clockConfig.ui line 125
#: rc.cpp:30
msgid "Size of the clock:"
msgstr "Grando de la horloĝo:"

#. i18n: tag string
#. i18n: file clockConfig.ui line 132
#: rc.cpp:33
msgid "Change clock size"
msgstr "Ŝanĝi la horloĝan grandon"

#. i18n: tag string
#. i18n: file clockConfig.ui line 135
#: rc.cpp:36
msgid ""
"Set a new size for the clock between 0 and 500. The size is the square side "
"that contains the clock."
msgstr ""
"Agordi novan grandon por la horloĝo inter 0 kaj 500. La grando estas la "
"kvadrata flanko kiu enhavas la horloĝon."
