#: kde2/config/config.cpp:55
msgid "Draw titlebar &stipple effect"
msgstr "&Punktita efekto en la titolobreto"

#: kde2/config/config.cpp:57
msgid ""
"When selected, active titlebars are drawn with a stipple (dotted) effect; "
"otherwise, they are drawn without the stipple."
msgstr ""
"Kiam ebligita, aktivaj titolobretoj havas la efekton de pluraj punktoj, alie "
"ili ne havas punktojn."

#: kde2/config/config.cpp:61
msgid "Draw g&rab bar below windows"
msgstr "&Kapta stango sub fenestroj"

#: kde2/config/config.cpp:63
msgid ""
"When selected, decorations are drawn with a \"grab bar\" below windows; "
"otherwise, no grab bar is drawn."
msgstr ""
"Kiam ebligita, ornamaĵoj havas \"kaptan stangon\" sube de la fenestroj, se "
"ne ebligita, neniu kapta stango aperas."

#: kde2/config/config.cpp:69
msgid "Draw &gradients"
msgstr "&Kolortransiroj"

#: kde2/config/config.cpp:71
msgid ""
"When selected, decorations are drawn with gradients for high-color displays; "
"otherwise, no gradients are drawn."
msgstr ""
"Kiam ebligita, ornamaĵoj havas kolortransirojn (por alt-koloraj ekranoj), se "
"ne ebligita la ornamaĵoj ne uzas kolortransirojn."

