#: kio_sftp.cpp:179 kio_sftp.cpp:183 kio_sftp.cpp:446 kio_sftp.cpp:619
msgid "SFTP Login"
msgstr "SFTP ensaluto"

#: kio_sftp.cpp:194
msgid "Use the username input field to answer this question!"
msgstr ""

#: kio_sftp.cpp:430
#, fuzzy, kde-format
#| msgid "Opening SFTP connection to host <b>%1:%2</b>"
msgid "Opening SFTP connection to host %1:%2"
msgstr "Malfermante SFTP konekton al la gastiganto <b>%1:%2</b>"

#: kio_sftp.cpp:434
msgid "No hostname specified"
msgstr "Neniu gastiga nomo specifita"

#: kio_sftp.cpp:448
msgid "site:"
msgstr "retejo:"

#: kio_sftp.cpp:542
#, kde-format
msgid ""
"The host key for this server was not found but an other type of key exists.\n"
"An attacker might change the default server key to confuse your client into "
"thinking the key does not exist\n"
"Please contact your system administrator.\n"
"%1"
msgstr ""

#: kio_sftp.cpp:553
#, kde-format
msgid ""
"The host key for the server %1 has changed.\n"
"This could either mean that DNS SPOOFING is happening or the IP address for "
"the host and its host key have changed at the same time.\n"
"The fingerprint for the key sent by the remote host is:\n"
" %2\n"
"Please contact your system administrator.\n"
"%3"
msgstr ""

#: kio_sftp.cpp:565
msgid "Warning: Cannot verify host's identity."
msgstr "Averto: Ne eblas kontroli la gastigantan identecon."

#: kio_sftp.cpp:566
#, kde-format
msgid ""
"The authenticity of host %1 can't be established.\n"
"The key fingerprint is: %2\n"
"Are you sure you want to continue connecting?"
msgstr ""

#: kio_sftp.cpp:597 kio_sftp.cpp:612 kio_sftp.cpp:651 kio_sftp.cpp:665
msgid "Authentication failed."
msgstr "La aŭtentigo fiaskis."

#: kio_sftp.cpp:620
msgid "Please enter your username and password."
msgstr "Bonvolu tajpi vian salutnomon kaj pasvorton."

#: kio_sftp.cpp:625
msgid "Incorrect username or password"
msgstr "Nevalida salutnomo aŭ pasvorto"

#: kio_sftp.cpp:678
msgid ""
"Unable to request the SFTP subsystem. Make sure SFTP is enabled on the server"
msgstr ""

#: kio_sftp.cpp:686
msgid "Could not initialize the SFTP session."
msgstr ""

