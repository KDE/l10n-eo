#: kio_sftp.cpp:424
msgid "An internal error occurred. Please retry the request again."
msgstr "Interna eraro okazis. Bonvolu reprovi la peton denove."

#: kio_sftp.cpp:507
#, fuzzy, kde-format
#| msgid "Opening SFTP connection to host <b>%1:%2</b>"
msgid "Opening SFTP connection to host %1:%2"
msgstr "Malfermante SFTP konekton al la gastiganto <b>%1:%2</b>"

#: kio_sftp.cpp:511
msgid "No hostname specified"
msgstr "Neniu gastiga nomo specifita"

#: kio_sftp.cpp:523
msgid "SFTP Login"
msgstr "SFTP ensaluto"

#: kio_sftp.cpp:525
msgid "site:"
msgstr "retejo:"

#: kio_sftp.cpp:629
msgid "Please enter your username and key passphrase."
msgstr "Bonvolu tajpi vian salutnomon kaj ŝlosilan pasfrazon."

#: kio_sftp.cpp:631
msgid "Please enter your username and password."
msgstr "Bonvolu tajpi vian salutnomon kaj pasvorton."

#: kio_sftp.cpp:639
msgid "Incorrect username or password"
msgstr "Nevalida salutnomo aŭ pasvorto"

#: kio_sftp.cpp:644
msgid "Please enter a username and password"
msgstr "Bonvolu tajpi salutnomon kaj pasvorton"

#: kio_sftp.cpp:705
msgid "Warning: Cannot verify host's identity."
msgstr "Averto: Ne eblas kontroli la gastigantan identecon."

#: kio_sftp.cpp:716
msgid "Warning: Host's identity changed."
msgstr "Averto: La gastiganta identeco ŝanĝiĝis!"

#: kio_sftp.cpp:727 kio_sftp.cpp:728
msgid "Authentication failed."
msgstr "La aŭtentigo fiaskis."

#: kio_sftp.cpp:742 kio_sftp.cpp:757
msgid "Connection failed."
msgstr "La konekto fiaskis."

#: kio_sftp.cpp:743 ksshprocess.cpp:817 ksshprocess.cpp:964
msgid "Connection closed by remote host."
msgstr "La konekto malfermitis de la defora gastiganto."

#: kio_sftp.cpp:758
#, kde-format
msgid "Unexpected SFTP error: %1"
msgstr "Neatendita SFTP eraro: %1"

#: kio_sftp.cpp:802
#, kde-format
msgid "SFTP version %1"
msgstr "SFTP versio %1"

#: kio_sftp.cpp:808
msgid "Protocol error."
msgstr "Protokola eraro:"

#: kio_sftp.cpp:814
#, kde-format
msgid "Successfully connected to %1"
msgstr "Sukcesis konekti al %1"

#: kio_sftp.cpp:1174
msgid "An internal error occurred. Please try again."
msgstr "Interna eraro okazis. Bonvolu reprovi."

#: kio_sftp.cpp:1195
#, kde-format
msgid ""
"Unknown error was encountered while copying the file to '%1'. Please try "
"again."
msgstr "Nekonata eraro okazis kopiante la dosieron al '%1'. Bonvolu reprovi."

#: kio_sftp.cpp:1432
msgid "The remote host does not support renaming files."
msgstr "La fora gastiganto ne permesas alinomi dosierojn."

#: kio_sftp.cpp:1481
msgid "The remote host does not support creating symbolic links."
msgstr "La fora gastiganto ne permesas krei simbolajn ligojn."

#: kio_sftp.cpp:1606
msgid "Connection closed"
msgstr "Konekto fermiĝis"

#: kio_sftp.cpp:1608
msgid "Could not read SFTP packet"
msgstr "Ne eblis legi la SFTP paketon"

#: kio_sftp.cpp:1717
msgid "End of file."
msgstr ""

#: kio_sftp.cpp:1720
msgid "File does not exist."
msgstr ""

#: kio_sftp.cpp:1724
msgid "Access is denied."
msgstr ""

#: kio_sftp.cpp:1728
msgid "SFTP command failed for an unknown reason."
msgstr "La SFTP komando fiaskis pro nekonata kaŭzo."

#: kio_sftp.cpp:1732
msgid "The SFTP server received a bad message."
msgstr "La SFTP servilo ricevis malbonan mesaĝon."

#: kio_sftp.cpp:1736
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "Vi elprovis operacion kiun ne permesas la SFTP servilo."

#: kio_sftp.cpp:1740
#, kde-format
msgid "Error code: %1"
msgstr "Erara kodo: %1"

#: ksshprocess.cpp:413
msgid "Cannot specify a subsystem and command at the same time."
msgstr "Ne eblas specifi subsistemon kaj komandon samtempe."

#: ksshprocess.cpp:750
msgid "No options provided for ssh execution."
msgstr "Neniu opcio donita por la ssh rulado."

#: ksshprocess.cpp:758
msgid "Failed to execute ssh process."
msgstr "La rulado de la ssh procezo fiaskis."

#: ksshprocess.cpp:783 ksshprocess.cpp:812 ksshprocess.cpp:931
#: ksshprocess.cpp:1003
msgid "Error encountered while talking to ssh."
msgstr "Eraro okazis parolante al ssh."

#: ksshprocess.cpp:863
msgid "Please supply a password."
msgstr "Bonvolu doni pasvorton"

#: ksshprocess.cpp:902
msgid "Please supply the passphrase for your SSH private key."
msgstr "Bonvolu doni la pasfrazon de via SSH privata ŝlosilo."

#: ksshprocess.cpp:916
#, kde-format
msgid "Authentication to %1 failed"
msgstr "Aŭtentigo al %1 fiaskis"

#: ksshprocess.cpp:939
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""
"La identeco de la defora gastiganto '%1' ne kontroleblis pro la gastiganta "
"ŝlosilo ne estas en la \"konataj gastigantoj\" dosiero."

#: ksshprocess.cpp:945
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr ""
" Mane aldonu la gastigantan ŝlosilon al la \"konataj gastigantoj\" dosiero "
"aŭ kontakti vian sistemestron."

#: ksshprocess.cpp:951
#, kde-format
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr ""
" Mane aldonu la gastigantan ŝlosilon al %1 aŭ kontakti vian sistemestron."

#: ksshprocess.cpp:983
#, kde-format
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""
"La identeco de la defora gastiganto '%1' ne kontroleblis. La ŝlosila "
"fingropremo estas:\n"
"%2\n"
"Vi devus kontroli la gastigantan ŝlosilan fingropremon kun la gastiganta "
"sistemestro antaŭ ol konektiĝi.\n"
"\n"
"Ĉu vi volas akcepti la gastigantan ŝlosilon kaj konektiĝi malgraŭe?"

#: ksshprocess.cpp:1011
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""
"Averto: La identeco de la defora gastiganto '%1' ŝanĝiĝis!\n"
"\n"
"Iu eble aŭskultas sur via konekto, aŭ simple la sistemestro ŝanĝis la "
"gastigantan ŝlosilon. Dumaniere, vi devus kontroli la gastigantan ŝlosilan "
"fingropremon kun la gastiganta sistemestro. La ŝlosila fingropremo estas:\n"
"%2\n"
"\n"
"Aldonu la korektan gastigantan ŝlosilon al \"%3\" por forigi tiun mesaĝon."

#: ksshprocess.cpp:1046
#, kde-format
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""
"Averto: La identeco de la defora gastiganto '%1' ŝanĝiĝis!\n"
"\n"
"Iu eble aŭskultas sur via konekto, aŭ simple la sistemestro ŝanĝis la "
"gastigantan ŝlosilon. Dumaniere, vi devus kontroli la gastigantan ŝlosilan "
"fingropremon kun la gastiganta sistemestro antaŭ ol konektiĝi. La ŝlosila "
"fingropremo estas:\n"
"%2\n"
"\n"
"Ĉu vi volas akcepti la novan gastigantan ŝlosilon kaj konektiĝi malgraŭe?"

#: ksshprocess.cpp:1070
msgid "Host key was rejected."
msgstr "La gastiganta ŝlosilo malakceptiĝis."
