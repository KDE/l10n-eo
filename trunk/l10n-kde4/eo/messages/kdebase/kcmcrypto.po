#~ msgstr ""
#~ "SSL v3 estas la tria eldono de la SSL-protokolo. Normale oni enŝaltas kaj "
#~ "v2 kaj v3."

#~ msgid ""
#~ "SSL ciphers cannot be configured because this module was not linked with "
