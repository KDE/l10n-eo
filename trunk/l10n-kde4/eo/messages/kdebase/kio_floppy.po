#: kio_floppy.cpp:199
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"disketingo %1.\n"
"La disketingo ankoraŭ estas okupita.\n"
"Atendu ĝis ĝi finis la laboron kaj reprovu tiam."

#: kio_floppy.cpp:203 kio_floppy.cpp:1123
#, fuzzy, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"Ne eblas skribi la dosieron %1.\n"
"La disko en la disketingo %1 ŝajne estas plena."

#: kio_floppy.cpp:213
#, fuzzy, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"Ne eblas atingi %1.\n"
"Ŝajne ne estas disketo en la disketingo %1"

#: kio_floppy.cpp:217
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"Ne eblas atingi %1.\n"
"Ŝajne ne estas disketo en la disketingo %2 aŭ vi ne rajtas skribi en tiu "
"disketingo."

#: kio_floppy.cpp:221
#, fuzzy, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"Ne eblas atingi %1.\n"
"La disketingo %1 ne estas subtenata."

#: kio_floppy.cpp:226
#, fuzzy, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"Ne eblas atingi %1.\n"
"Certigu, ke la disketo en la disketingo %1 estas DOS-formatigita disketo\n"
"kaj ke la permesoj de la aparata dosiero (ekz. /dev/fd0) estas ĝustaj(ekz. "
"rwxrwxrwx)."

#: kio_floppy.cpp:230
#, fuzzy, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"Ne eblas atingi %1.\n"
"La disko en la disketingo %1 ŝajne ne havas DOS-formaton."

#: kio_floppy.cpp:234
#, fuzzy, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"Atingo malpermesita.\n"
"La disko en la disketingo %1 ŝajne estas protektita kontraŭ skribado."

#: kio_floppy.cpp:243
#, fuzzy, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"Ne eblas legi la praŝarĝan sektoron\n"
"Ŝajne ne estas disketo en la disketingo %1"

#: kio_floppy.cpp:367
#, fuzzy, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"Ne eblas startigi\n"
"Certigu ke la pakaĵo \"mtools\" estas ĝuste instalita en via sistemo."

