msgstr "Forigas %1"

#: sweeper.cpp:158
#, fuzzy, qt-format
msgid "Clearing of %1 failed: %2"
msgstr "Forigo de %1 fiaskis"

#: sweeper.cpp:164
msgid "Clean up finished."
msgstr "Forigo finis."

