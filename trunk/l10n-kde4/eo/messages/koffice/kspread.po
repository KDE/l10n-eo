#. i18n: file functions/statistical.xml line 1768
#: xml_doc.cpp:6514
msgid "INVBINO(trials;failure;prob_of_failure)"
msgstr "INVBINO(provoj; malsukceso; malsukcesverŝajneco)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1769
#: xml_doc.cpp:6517
msgid "INVBINO(12;3;0.2) returns 0.236223201"
msgstr "INVBINO(12; 3; 0,2) estas 0,236223201"

