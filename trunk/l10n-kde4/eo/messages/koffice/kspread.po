#: xml_doc.cpp:7267
msgid "TANH(0) equals 0"
msgstr "TANH(0) estas 0"

#. i18n: tag Text
#. i18n: file functions/trig.xml line 176
#: xml_doc.cpp:7273
msgid ""
"The ACOSH() function calculates the inverse hyperbolic cosine of x. That is "
"the value whose hyperbolic cosine is x. If x is less than 1.0, acosh() "
"returns not-a-number (NaN) and errno is set."
msgstr ""
"La funkcio acosh(x), kalkulas la inversan hiperbolan kosinuson de x. Tio "
"estas la valoro, kies hiperbola kosinuso estas x. Se x estas pli malgranda "
"ol 1, acosh(x) redonas \"ne difinita\" (n.d., NaN) kaj eraronombro estos "
"donita."

#. i18n: tag Syntax
#. i18n: file functions/trig.xml line 177
#: xml_doc.cpp:7276
msgid "ACOSH(Float)"
msgstr "ACOSH(reelo)"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 178
#: xml_doc.cpp:7279
msgid "ACOSH(5) equals 2.29243167"
msgstr "ACOSH(5) estas 2,29243167"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 179
#: xml_doc.cpp:7282
msgid "ACOSH(0) equals NaN"
msgstr "ACOSH(0) estas ne difinita (NaN)"

#. i18n: tag Text
#. i18n: file functions/trig.xml line 192
#: xml_doc.cpp:7288
msgid ""
"The ASINH() function calculates the inverse hyperbolic sine of x; that is "
"the value whose hyperbolic sine is x."
msgstr ""
"La funkcio asinh() klakulas la inversan hiperbolan sinuson de x, t.e la "
"valoro, kies hiperbola sinuso estas x."

#. i18n: tag Syntax
#. i18n: file functions/trig.xml line 193
#: xml_doc.cpp:7291
