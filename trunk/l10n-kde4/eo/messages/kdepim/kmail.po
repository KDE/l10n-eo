#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 22
#: rc.cpp:761
msgid "Sending Certificates"
msgstr "Sendante atestilon"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 37
#: rc.cpp:764
msgid "&Do not send certificates"
msgstr "&Ne sendu atestilon"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 40
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 56
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 69
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 82
#: rc.cpp:767 rc.cpp:776 rc.cpp:785 rc.cpp:794
msgid "Selects which certificates to send"
msgstr "Elektu sendotan atestilon"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 43
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 59
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 72
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 85
#: rc.cpp:770 rc.cpp:779 rc.cpp:788 rc.cpp:797
msgid ""
"<qt> <h1>Sending Certificates</h1> Without your certificate, the receiver "
"will not be able to determine whether it was really you who sent the message "
"or whether the message was altered by a third party. <p> The receiver can "
"obtain your certificate from a central server, but you can also opt to "
"enclose your certificate with your message. You can select whether you do "
"not want to include a certificate at all, only your own certificate or the "
"whole chain of certificates that certify your own certificate, including or "
"excluding the root certificate. <p> It is recommended to always include at "
"least your own certificate with the message. <p> This setting is a default, "
"you can override it for each individual message. </qt>"
msgstr ""
"<qt> <h1>Sendi de atestiloj</h1> Sen via atestilo, la ricevanto ne eblos "
"determini, ĉu reale estas vi, kiu sendis la mesaĝon aŭ ĉu la mesaĝo estas "
"aliigita de tria grupo. <p>La ricevanto povas haviĝi vian atestilon de "
"centra servilo, sed vi ankaŭ povas decidi, ke vi enhavigas vian atestilon en "
"via mesaĝo. Vi povas elekti, ĉu vi ne volas enhavigi atestilon, nur vian "
"propran atestilon aŭ la tutan atestilĉenon, kiu atestas vian propran "
"atestilon, kun aŭ sen la radika atestilo. <p>Estas rekomendata enhavigi ĉiam "
"minimume vian propran atestilon en la mesaĝø. <p>Tio estas norma, vi povas "
"superigi ĝin por ĉiu mesaĝo.</qt> "

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 50
#: rc.cpp:773
msgid "Send &your own certificate"
msgstr "Sendu &vian propran atestilon"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 66
#: rc.cpp:782
msgid "Send certificate chain &without root"
msgstr "Sendu la atestilan ĉenon sen radiko"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 79
#: rc.cpp:791
msgid "Send certificate c&hain with root"
msgstr "Sendu la atestilan ĉenon kun radiko"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 111
#: rc.cpp:800
msgid "Signatures"
msgstr "Subskriboj"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 139
#: rc.cpp:803
msgid "Sign all message &parts"
msgstr "Subskribu ĉiujn mesaĝo&partojn"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 145
#: rc.cpp:806
msgid "Check to have all message parts signed by default"
msgstr "Marku por norme subskribi ĉiujn partojn"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 153
#: rc.cpp:809
msgid ""
"<qt>\n"
"<h1>Sign All Message Parts By Default</h1>\n"
"If this option is selected, all parts of a message (i.e. the main message "
"body and all attachments) are signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Subskribu norme ĉiuj mesaĝpartojn</h1>\n"
"Se la opcio estas elektita, ĉiuj partoj de mesaĝo (k.e. la ĉefa mesaĝteksto "
"kaj ĉiuj kunsendaĵoj) norme estas subskribataj.\n"
"<p>\n"
"Tio estas la norma agordo; tamen vi povas superigi ĝin por ĉiu sola mesaĝo.\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 160
#: rc.cpp:817
msgid "Ask &before signing each part"
msgstr "&Demandu antaŭ ĉifri ĉiun parton"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 163
#: rc.cpp:820
msgid "Check to be asked for each part whether to sign"
msgstr "Marku por esti demandata pri ĉiu subskribota parto"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 169
#: rc.cpp:823
msgid ""
"<qt>\n"
"<h1>Ask Before Signing Each Part</h1>\n"
"When this option is selected, you will be asked for each part of the message "
"(i.e. the main message body as well as all attachments) individually whether "
"you want the part to be signed.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Demandu antaŭ subskribo de ĉiu parto</h1>\n"
"Se la opcio estas elektita, vi estos demandata pri ĉiu mesaĝa parto (k.e. la "
"ĉefa mesaĝteksto kaj la kunsendaĵoj), ĉu vi volas subskribi la parton.\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 176
#: rc.cpp:829
msgid "Do no&t sign messages"
msgstr "Ne subs&kribu mesaĝojn"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 179
#: rc.cpp:832
msgid "Check for not signing a message by default"
msgstr "Marku por ne norme subskribi mesaĝon"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 187
#: rc.cpp:835
msgid ""
"<qt>\n"
"<h1>Do Not Sign Messages</h1>\n"
"If this option is selected, messages are not signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"setting.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Ne subskribu mesaĝojn</h1>\n"
"Se la opcio estas elektita, norme mesaĝoj ne estas subskribataj.\n"
"<p>\n"
"Tio estas la norma agordo; vi povas superigi ĝin por ĉiu sola mesaĝo.\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 194
#: rc.cpp:843
msgid ""
"The signature certificate is configured on the <em>Certificates</em> page."
msgstr ""
"La subskriba atestilo estas agordata per la paĝo de <em>Atestiloj</em>."

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 207
#: rc.cpp:846
msgid "Selects the signature algorithm"
msgstr "Elektas la subskribometodon"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 217
#: rc.cpp:849
msgid ""
"<qt>\n"
"<h1>Signature Algorithm</h1>\n"
"An algorithm is a description for the computer on how it should perform a "
"certain task. The signature algorithm describes how the computer applies "
"your signature key to your message so that the receiver can determine "
"whether the message really is from you.\n"
"<p>\n"
"The selection of a certain signature algorithm determines how easy or how "
"difficult it is to forge a message. However, all algorithms provided in the "
"SPHINX environment are considered to be very safe. Generally, the default "
"will work just fine here.\n"
"<p>\n"
"This setting is a default, you can override it for each individual message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Subskriba algoritmo</h1>\n"
"Algoritmo estas priskribo por la komputilo, kiel ĝi faru taskon. La "
"subskriba algoritmo priskribas, kiel la komputilo uzas vian subskriban "
"ŝlosilon je via mesaĝo, por ke la ricevanto povas sciiĝi, ĉu la mesaĝo fakte "
"estas de vi.\n"
"<p>\n"
"La elekto de sekura subskriba algoritmo difinas la facilecon aŭ malfacilecon "
"de mesaĝa falso. Ĉiuj alogoritmoj tenitaj pretas en la Sfinksaro estas tre "
"sekuraj. Ĝenerale la normo funkcios tre bone.\n"
"<p>\n"
"La agordo estas normo; vi popas superigi ĝin por ĉiu sola mesaĝo.\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 221
#: rc.cpp:859
msgid "RSA + SHA-1"
msgstr "RSA + SHA-1"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 229
#: rc.cpp:862
msgid "Signature &algorithm:"
msgstr "Subskribo&metodo:"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 245
#: rc.cpp:865
msgid "&Store messages with signatures"
msgstr "Kon&servu mesaĝojn kun subskriboj"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 251
#: rc.cpp:868
msgid "Check to store messages with their signatures"
msgstr "Marku por konservi mesaĝojn kun iliaj subskriboj"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 257
#: rc.cpp:871
msgid ""
"<qt>\n"
"<h1>Store Messages With Signatures</h1>\n"
"When this box is checked, sent messages are stored together with the "
"signatures applied to them. This is recommended, because it enables you to "
"check later whether you signed a message or a certain part of it.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Konservu mesaĝojn kun subskribo</h1>\n"
"Se la opcio estas markita, senditaj mesaĝoj estas konservitaj kun la siaj "
"subskriboj. Tio estas rekomendita, ĉar eblas por vi, ke vi povos kontroli "
"poste, ĉu vi subskribis mesaĝon aŭ difinan parton de ĝi.\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 279
#: rc.cpp:877
msgid "Compound mode:"
msgstr "Redakta agmaniero:"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 295
#: rc.cpp:880
msgid "Standa&rd MIME"
msgstr "Norma MIME"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 298
#: rc.cpp:883
msgid "A Multipart/Signed holding Signature and signed data."
msgstr "Multopartsubskribito enhavas sunskribon kaj subskribitajn datumojn."

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 304
#: rc.cpp:886
msgid ""
"<qt>\n"
"<h1>Multipart detached signature</h1>\n"
"When this option is selected, the signature and the signed data will be "
"separate parts of a Multipart/Signed message part. Signed message data will "
"be readable even by Mail User Agents not supporting the signaturing "
"algorithm and not supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Disparta subskribo</h1>\n"
"Se la opcio estas elektita, la subskribo kaj la subskribotaj datumoj estos "
"disaj partoj de multopartsubskribita mesagparto. Subskribitaj mesaĝdatumoj "
"anakŭ estos legeblajper poŝtiloj, kiuj ne subtenas la subskriban algoritmon "
"kaj la ASN.1-deĉifro.\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 317
#: rc.cpp:892
msgid "Opa&que (only recommended for SPHINX)"
msgstr "Opaka (nur rekomendata por Sfinkso)"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 320
#: rc.cpp:895
msgid "Signature and signed data encoded in one ASN.1 block."
msgstr "Subskribo kaj subskribitaj datumoj en unu ASN.1-bloko."

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 326
#: rc.cpp:898
msgid ""
"<qt>\n"
"<h1>Opaque signed messages</h1>\n"
"When this option is selected, both the signature and the signed data will be "
"encoded into one ASN.1 block. Messages will be readable only by Mail User "
"Agents supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>Opake subskribitaj mesaĝoj</h1>\n"
"Se la opcio estas elektita, la ambaŭ aĵoj, subskriboj kaj sunskribitaj "
"datumoj, estos ĉifrataj en unu ASN.1-bloko. Mesaĝoj estos legeblaj nur de "
"poŝtiloj, kiuj subtenas tion.\n"
"</qt>"

