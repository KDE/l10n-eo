msgstr ""
"Elektu la S/MIME-atestilon uzotan por subskribi viajn mesaĝojn kaj por ĉifri "
"mesaĝojn."

#: identitydialog.cpp:240
msgid ""
"<qt><p>The S/MIME (X.509) certificate you choose here will be used to "
