#. i18n: file signatureconfigurationdialog.ui line 496
#. i18n: tag string
#. i18n: file warningconfiguration.ui line 25
#: rc.cpp:964 rc.cpp:1203
msgid "Check to be warned when sending unsigned messages."
msgstr "Marko pro averto pri sendo de neĉifritaj mesaĝoj."

