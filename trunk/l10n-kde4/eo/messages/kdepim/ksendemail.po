#: mailerservice.cpp:211
msgid "Cannot connect to email service."
msgstr "Ne povas konekti al retpoŝtservo."

#: mailerservice.cpp:214
msgid "Unable to find or start email service."
msgstr "Neeblas trovi aŭ startigi repoŝtservon."

#: main.cpp:28
msgid "KDE Command Line Emailer."
msgstr "Komandlinia retpoŝtilo de KDE"

#: main.cpp:34
msgid "Set subject of message"
msgstr "Difini temon de la mesaĝo"

#: main.cpp:36
msgid "Send CC: to 'address'"
msgstr "Sendi kopion al 'adreso'"

#: main.cpp:38
msgid "Send BCC: to 'address'"
msgstr "Sendi kaŝitan kopion al 'adreso'"

#: main.cpp:40
msgid "Add 'header' to message"
msgstr "Aldoni 'kaplinion' al mesaĝo"

#: main.cpp:41
msgid "Read message body from 'file'"
msgstr "Legi tekston de mesaĝo el 'dosiero'"

#: main.cpp:42
msgid "Set body of message"
msgstr "Difini tekston de mesaĝo"

#: main.cpp:43
msgid "Add an attachment to the mail. This can be repeated"
msgstr "Aldoni alkroĉon al mesaĝo. Vi povas ripeti ĝin"

#: main.cpp:44
msgid "Only open composer window"
msgstr "Nur malfermi la verkilfenestron"

#: main.cpp:45
msgid "Address to send the message to"
msgstr "Adreso, al kiu sendi la mesaĝon"

