#: medianotifier.cpp:167
msgid ""
"An autorun file has been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr "Aŭtolanĉa dosiero troviĝas ĉe '%1'. Ĉu vi deziras malfermi '%2'?\nNotu : malfermi dosieron ĉe datumportilo povas kompromiti la sekurecon de via sistemo"

#: medianotifier.cpp:171
#, c-format
msgid "Autorun - %1"
msgstr "Aŭtolanĉo - %1"

#: medianotifier.cpp:241
msgid ""
"An autoopen file has been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr "Aŭtomalferma dosiero troviĝas ĉe '%1'. Ĉu vi deziras malfermi '%2'?\nNotu : malfermi dosieron ĉe datumportilo povas kompromiti la sekurecon de via sistemo"

#: medianotifier.cpp:245
#, c-format
msgid "Autoopen - %1"
msgstr "Aŭtomalfermo - %1"

