msgstr "Programaro Centro Plasma Serĉo proponas instali programojn"

#: content/announcements/plasma/5/5.10.0.md:51
msgid "Audio Volume Device Menu "
msgstr "Aŭdio-Laŭteca Aparat-Menuo"

#: content/announcements/plasma/5/5.10.0.md:51
#: content/announcements/plasma/5/5.9.95.md:49
msgid "Audio Volume Device Menu"
msgstr "Aŭdio-Laŭteca Aparat-Menuo"

