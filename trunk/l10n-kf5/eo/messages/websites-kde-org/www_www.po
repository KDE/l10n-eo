#: content/announcements/plasma/5/5.22.90.md:52
msgid "A huge number of bugs were fixed"
msgstr "Grandega nombro da cimoj estis riparita"

#: content/announcements/plasma/5/5.22.90.md:53
msgid "It has improved performance and accessibility"
msgstr "Ĝi plibonigis rendimenton kaj alireblecon"

