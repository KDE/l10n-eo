#. (itstool) path: component/name
#: org.kde.kgoldrunner.appdata.xml:6
msgid "KGoldrunner"
msgstr "KGoldrunner"

#. (itstool) path: component/summary
#: org.kde.kgoldrunner.appdata.xml:7
msgid "Hunt Gold, Dodge Enemies and Solve Puzzles"
msgstr "Ĉasu Oron, Evitu Malamikojn kaj Solvu Enigmojn"

#. (itstool) path: description/p
#: org.kde.kgoldrunner.appdata.xml:9
msgid "KGoldrunner is an action game where the hero runs through a maze, climbs stairs, dig holes and dodges enemies in order to collect all the gold nuggets and escape to the next level. Your enemies are also after the gold. Worse still, they are after you!."
msgstr ""
"KGoldrunner estas agoludo, kie la heroo kuras tra labirinto, grimpas "
"ŝtuparojn, fosas truojn kaj evitas malamikojn por kolekti ĉiujn ornugetojn "
"kaj eskapi al la sekva nivelo. Viaj malamikoj ankaŭ serĉas la oron. Pli "
"malbone, ili estas post vi!."

#. (itstool) path: description/p
#: org.kde.kgoldrunner.appdata.xml:14
