msgstr "Temebla"

#. (itstool) path: ul/li
#: org.kde.kgoldrunner.appdata.xml:17
msgid "Hundreds of levels"
msgstr "Centoj da niveloj"

#. (itstool) path: ul/li
#: org.kde.kgoldrunner.appdata.xml:18
msgid "Level-editor"
