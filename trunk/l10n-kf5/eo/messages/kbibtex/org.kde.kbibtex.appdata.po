#. (itstool) path: component/name
#: org.kde.kbibtex.appdata.xml:14
msgid "KBibTeX"
msgstr "KBibTeX"

#. (itstool) path: component/summary
#: org.kde.kbibtex.appdata.xml:15
msgid "BibTeX editor by KDE to edit bibliographies used with LaTeX"
msgstr "BibTeX-redaktilo de KDE por redakti bibliografiojn uzatajn kun LaTeX"

#. (itstool) path: description/p
#: org.kde.kbibtex.appdata.xml:17
msgid ""
"KBibTeX is a reference management application which can be used to collect "
"TeX/LaTeX bibliographies and export them in various formats."
msgstr ""
"KBibTeX estas referencadministra aplikaĵo, kiu povas esti uzata por kolekti "
"TeX/LaTeX-bibliografiojn kaj eksporti ilin en diversaj formatoj."

#. (itstool) path: description/p
#: org.kde.kbibtex.appdata.xml:20
msgid "KBibTeX can do the following things:"
msgstr "KBibTeX povas fari la jenajn aferojn:"

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:22
msgid ""
"Preview bibliography entries in various formats (Source (BibTeX), Source "
"(RIS), Wikipedia, standard (XML/XSLT), fancy (XML/XSLT), and abstract-only "
"(XML/XSLT)). Additional preview styles become available when bibtex2html is "
"installed."
msgstr ""
"Antaŭrigardu bibliografiajn enskribojn en diversaj formatoj (Fonto (BibTeX), "
"Fonto (RIS), Vikipedio, norma (XML/XSLT), fantazia (XML/XSLT), kaj nur "
"abstrakta (XML/XSLT)). Pliaj antaŭrigardstiloj iĝas disponeblaj kiam "
"bibtex2html estas instalita."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:23
msgid ""
"Import data in various bibliography file formats such as BibTeX, RIS and ISI "
"(requires bibutils) and export data to PDF (requires pdflatex), PostScript "
"(requires latex), RTF (requires latex2rtf), and HTML."
msgstr ""
"Importu datumojn en diversaj bibliografiaj dosierformatoj kiel BibTeX, RIS "
"kaj ISI (postulas bibutils) kaj eksportu datumojn al PDF (postulas "
"pdflatex), PostScript (postulas latekso), RTF (postulas latex2rtf), kaj HTML."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:24
msgid ""
"Search for the bibliography entries data in online databases (e.g. Google "
"Scholar, ACM, IEEE, arXiv, etc.)"
msgstr ""
"Serĉu la datumojn pri bibliografiaj eniroj en interretaj datumbazoj (ekz. "
"Google Scholar, ACM, IEEE, arXiv, ktp.)"

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:25
msgid ""
"Preview local or remote (online) resources, e.g. PDF files, linked in the "
"BibTEX entry."
msgstr ""
"Antaŭrigardu lokajn aŭ malproksimajn (retajn) rimedojn, ekz. PDF-dosieroj, "
"ligitaj en la enskribo BibTEX."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:26
msgid "Find and merge duplicate entries in bibliography."
msgstr "Trovi kaj kunfandi duobligitajn enskribojn en bibliografio."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:27
msgid "Integrate your bibliographies with LaTeX editors such as Kile and LyX."
msgstr "Integri viajn bibliografiojn kun LaTeX-redaktiloj kiel Kile kaj LyX."

#. (itstool) path: ul/li
#: org.kde.kbibtex.appdata.xml:28
msgid "Import your Zotero library."
msgstr "Importu vian Zotero-bibliotekon."

#. (itstool) path: screenshot/caption
#: org.kde.kbibtex.appdata.xml:36
msgid "KBibTeX main window"
msgstr "KBibTeX ĉefa fenestro"
