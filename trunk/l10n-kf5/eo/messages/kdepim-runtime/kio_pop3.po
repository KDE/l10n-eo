#: pop3.cpp:210
#, kde-format
msgid "The server said: \"%1\""
msgstr "La servo diris: \"%1\""

#: pop3.cpp:232
#, kde-format
msgid "The server terminated the connection."
msgstr "La servilo finis la kontakton."

#: pop3.cpp:234
#, kde-format
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"Nevalida respondo de la servilo:\n"
"\"%1\""

#: pop3.cpp:272
#, kde-format
msgid "Could not send to server.\n"
msgstr "Ne eblis sendi al servilo.\n"

#: pop3.cpp:325 pop3.cpp:380 pop3.cpp:557
#, kde-format
msgid "No authentication details supplied."
msgstr ""

#: pop3.cpp:360
#, kde-format
msgid ""
"Login via APOP failed. The server %1 may not support APOP, although it "
"claims to support it, or the password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Saluto per APOP malsukcesis. La servilo %1 eble ne subtenas APOP (kvamkam ĝi "
"asertas ke ĝi tion faras) aŭ la pasvorto povus esti malĝusta.\n"
"\n"
"%2"

#: pop3.cpp:417
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr ""

#: pop3.cpp:530
#, kde-format
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password "
"may be wrong.\n"
"\n"
"%3"
msgstr ""
"Saluto per SASL (%1) malsukcesis. La servo eble ne subtenas %2, aŭ la "
"pasvorto povus esti malĝusta.\n"
"\n"
"%3"

#: pop3.cpp:541
#, kde-format
msgid ""
"Your POP3 server (%1) does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"Via POP3-servilo (%1) ne subtenas SASL.\n"
"Elektu alian aŭtentigometodon."

#: pop3.cpp:574 pop3.cpp:637
#, kde-format
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"Ne eblis saluti al %1.\n"
"\n"

#: pop3.cpp:586
#, kde-format
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"Ne eblis saluti al %1. La pasvorto eble estas malĝusta.\n"
"\n"
"%2"

#: pop3.cpp:638
#, kde-format
msgid "The server terminated the connection immediately."
msgstr "La servilo finis la konekton subite."

#: pop3.cpp:639
#, kde-format
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"La servilo ne responda ĝuste:\n"
"%1\n"

#: pop3.cpp:667
#, kde-format
msgid ""
"Your POP3 server (%1) does not support APOP.\n"
"Choose a different authentication method."
msgstr "Via POP3-servilo (%1) ne subtenas APOP. Elektu alian aŭtentigometodon."

#: pop3.cpp:686
#, kde-format
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful.\n"
"You can disable TLS in the POP account settings dialog."
msgstr ""
"Via POP3-servilo asertas subteni TLS, sed la negocado malsukcesis. Vi povas "
"malaktivigi TLS en KDE per la agordmodulo Ĉifrado."

#: pop3.cpp:695
#, kde-format
msgid ""
"Your POP3 server (%1) does not support TLS. Disable TLS, if you want to "
"connect without encryption."
msgstr ""
"Via POP3-servilo (%1) ne subtenas TLS. Malaktivigu TLS, se vi volas kontakti "
"ĝin sen ĉifrado."

#: pop3.cpp:705
#, kde-format
msgid "Username and password for your POP3 account:"
msgstr "Uzantonomo kaj pasvorto de via POP3-konto:"

#: pop3.cpp:882 pop3.cpp:890 pop3.cpp:1035
#, kde-format
msgid "Unexpected response from POP3 server."
msgstr "Neatendita respondo de la POP3-servilo."

#: pop3.cpp:896
#, kde-format
msgid ""
"Error during communication with the POP3 server while trying to list mail: %1"
msgstr ""

#: pop3.cpp:999
#, kde-format
msgid ""
"Error during communication with the POP3 server while trying to download "
"mail: %1"
msgstr ""

#: pop3.cpp:1064
#, kde-format
msgid "The POP3 command 'STAT' failed"
msgstr ""

#: pop3.cpp:1069
#, kde-format
msgid "Invalid POP3 response, should have at least one space."
msgstr ""

#: pop3.cpp:1077
#, kde-format
msgid "Invalid POP3 STAT response."
msgstr ""

#~ msgid "PASS <your password>"
#~ msgstr "PASS <via pasvorto>"
