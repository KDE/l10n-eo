msgid "Single images vs Books or Projects"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:26
msgid "Expanded Front Page"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:27
msgid "Cloud Integration"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:28
msgid "A Mobile UI"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:29
msgid "Tracing over 3D Models"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:30
msgid "Flexible Comic Paneling"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:31
msgid "Vector Brushes"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:32
msgid "Layer Management Improvements"
msgstr ""

#: content/en/posts/2023/krita-in-2022-and-2023.md:33
msgid "Project Asset Management"
msgstr ""

