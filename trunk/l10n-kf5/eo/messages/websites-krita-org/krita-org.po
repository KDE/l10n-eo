#: i18n/en.yaml:0
msgid ""
"Great for new and experienced artists. Here are some of the features that "
"Krita offers:"
msgstr ""
"Bonega por novaj kaj spertaj artistoj. Jen kelkaj el la funkcioj kiujn Krita "
"ofertas:"

#: i18n/en.yaml:0
msgid "Multiple brush types for different art styles"
msgstr "Multoblaj penikotipoj por malsamaj artaj stiloj"

#: i18n/en.yaml:0
msgid "Layers, drawing assistants, stabilizers"
msgstr "Tavoloj, desegnaj helpantoj, stabiligiloj"

#: i18n/en.yaml:0
msgid "Animation tools to transform your artwork"
msgstr "Animaciaj iloj por transformi viajn artaĵojn"

#: i18n/en.yaml:0
msgid "Resources and Materials"
msgstr "Rimedoj kaj Materialoj"

#: i18n/en.yaml:0
msgid "Expand Krita’s capabilities with online tools and assets:"
msgstr "Pligrandigu la kapablojn de Krita per interretaj iloj kaj aktivaĵoj:"

#: i18n/en.yaml:0
msgid "Brushes, patterns, and vector libraries"
msgstr "Penikoj, ŝablonoj kaj vektoraj bibliotekoj"

#: i18n/en.yaml:0
msgid "Texture packs and page templates"
msgstr "Teksturaj pakoj kaj paĝaj ŝablonoj"

#: i18n/en.yaml:0
msgid "Plugins that add new functionality"
msgstr "Kromaĵoj kiuj aldonas novajn funkciojn"

#: i18n/en.yaml:0
msgid "See Resources"
