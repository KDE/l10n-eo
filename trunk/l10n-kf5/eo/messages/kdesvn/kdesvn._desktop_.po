#: src/kdesvnd/kdesvn_subversion.desktop:4
msgctxt "X-KDE-Submenu"
msgid "Subversion (kdesvn)"
msgstr "Subversion (kdesvn)"

#: src/kdesvnd/kdesvn_subversion.desktop:43
msgctxt "Name"
msgid "Subversion log (last 100)"
msgstr "Subversin-protokolo (lastaj 100)"

#: src/kdesvnd/kdesvn_subversion.desktop:79
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:44
msgctxt "Comment"
msgid "Displays the Subversion log"
msgstr "Montras la protokolon de Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:115
msgctxt "Name"
msgid "Detailed Subversion info"
msgstr "Detalaj informoj pri Subversion"

#: src/kdesvnd/kdesvn_subversion.desktop:153
msgctxt "Name"
msgid "Add to Repository"
msgstr "Aldoni al Deponejo"

#: src/kdesvnd/kdesvn_subversion.desktop:194
msgctxt "Name"
msgid "Check for unversioned items"
msgstr "Kontroli pri neversiitaj eroj"

#: src/kdesvnd/kdesvn_subversion.desktop:231
msgctxt "Name"
msgid "Delete From Repository"
msgstr "Forigi El Deponejo"

#: src/kdesvnd/kdesvn_subversion.desktop:269
msgctxt "Name"
msgid "Revert Local Changes"
msgstr "Reverti Lokajn Ŝanĝojn"

#: src/kdesvnd/kdesvn_subversion.desktop:305
msgctxt "Comment"
msgid "Remove any changes made locally. Warning - this cannot be undone."
msgstr ""
"Forigi ajnajn ŝanĝojn faritajn loke. Averto - ĉi tio ne povas esti malfarita."

#: src/kdesvnd/kdesvn_subversion.desktop:341
msgctxt "Name"
msgid "Rename..."
msgstr "Alinomi..."

#: src/kdesvnd/kdesvn_subversion.desktop:379
msgctxt "Comment"
msgid ""
"Rename a file locally and in the repository.  Use this rather than adding "
"and deleting to rename a file."
msgstr ""
"Alinomi dosieron loke kaj en la deponejo. Uzu ĉi tion anstataŭ aldoni kaj "
"forigi por renomi dosieron."

#: src/kdesvnd/kdesvn_subversion.desktop:415
msgctxt "Name"
msgid "Import Repository"
msgstr "Importi Deponejon"

#: src/kdesvnd/kdesvn_subversion.desktop:451
msgctxt "Comment"
msgid ""
"Put folder into an existing repository to put it under revision control."
msgstr ""
"Meti dosierujon en ekzistantan deponejon por meti ĝin sub reviziokontrolon."

#: src/kdesvnd/kdesvn_subversion.desktop:487
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:80
msgctxt "Name"
msgid "Checkout From Repository..."
msgstr "Elŝuti el Deponejo..."

#: src/kdesvnd/kdesvn_subversion.desktop:523
#: src/kdesvnd/kdesvn_subversion.desktop:1067
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:116
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:331
msgctxt "Comment"
msgid "Checkout out files from an existing repository into this folder."
msgstr "Elŝuti dosierojn el ekzistanta deponejo en ĉi tiun dosierujon."

#: src/kdesvnd/kdesvn_subversion.desktop:559
msgctxt "Name"
msgid "Switch..."
msgstr "Ŝalti..."

#: src/kdesvnd/kdesvn_subversion.desktop:595
msgctxt "Comment"
msgid "Switch given working copy to another branch"
msgstr "Ŝanĝi donitan funkciantan kopion al alia branĉo"

#: src/kdesvnd/kdesvn_subversion.desktop:632
msgctxt "Name"
msgid "Merge..."
msgstr "Kunfandi..."

#: src/kdesvnd/kdesvn_subversion.desktop:669
msgctxt "Comment"
msgid "Merge changes between this and another branch"
msgstr "Kunfandi ŝanĝojn inter ĉi tiu kaj alia branĉo"

#: src/kdesvnd/kdesvn_subversion.desktop:706
msgctxt "Name"
msgid "Blame..."
msgstr "Kulpigi..."

#: src/kdesvnd/kdesvn_subversion.desktop:741
msgctxt "Comment"
msgid "See who wrote each line of the file and in what revision"
msgstr "Vidu kiu skribis ĉiun linion de la dosiero kaj en kiu revizio"

#: src/kdesvnd/kdesvn_subversion.desktop:778
msgctxt "Name"
msgid "Create Patch..."
msgstr "Krei flikilon..."

#: src/kdesvnd/kdesvn_subversion.desktop:816
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:152
msgctxt "Name"
msgid "Export..."
msgstr "Eksporti..."

#: src/kdesvnd/kdesvn_subversion.desktop:854
#: src/kdesvnd/kdesvn_subversion.desktop:1138
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:190
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:402
msgctxt "Comment"
msgid "Checkout out an unversioned copy of a tree from a repository"
msgstr "Kontroli neversiitan kopion de arbo el deponejo"

#: src/kdesvnd/kdesvn_subversion.desktop:890
msgctxt "Name"
msgid "Diff (local)"
msgstr "Diferenco (loka)"

#: src/kdesvnd/kdesvn_subversion.desktop:926
msgctxt "Comment"
msgid "Show local changes since last update"
msgstr "Montri lokajn ŝanĝojn ekde la lasta ĝisdatigo"

#: src/kdesvnd/kdesvn_subversion.desktop:962
msgctxt "Name"
msgid "KDESvn Update"
msgstr "KDESvn Ĝisdatigo"

#: src/kdesvnd/kdesvn_subversion.desktop:998
msgctxt "Name"
msgid "KDESvn Commit"
msgstr "KDESvn Commit"

#: src/kdesvnd/kdesvn_subversion.desktop:1033
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:297
msgctxt "Name"
msgid "Checkout from a repository..."
msgstr "Elŝuti el deponejo..."

#: src/kdesvnd/kdesvn_subversion.desktop:1103
#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:367
msgctxt "Name"
msgid "Export from a Subversion repository..."
msgstr "Eksporti el Subversion-deponejo..."

#: src/kdesvnd/kdesvn_subversion.desktop:1174
msgctxt "Name"
msgid "Display revision tree"
msgstr "Montri reviziarbon"

#: src/kdesvnd/kdesvn_subversion.desktop:1209
msgctxt "Comment"
msgid "Show complete revision tree"
msgstr "Montri kompletan reviziarbon"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:9
msgctxt "Name"
msgid "kdesvn log (last 100)"
msgstr "kdesvn protokolo (lastaj 100)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:226
msgctxt "Name"
msgid "Update (Kdesvn)"
msgstr "Ĝisdatigo (Kdesvn)"

#: src/kdesvnd/kdesvn_subversion_toplevel.desktop:262
msgctxt "Name"
msgid "Commit (Kdesvn)"
msgstr "Enmeti (Kdesvn)"

#: src/kdesvn.notifyrc:3
msgctxt "Comment"
msgid "Kdesvn notification"
msgstr "Kdesvn sciigo"

#: src/kdesvn.notifyrc:38
msgctxt "Name"
msgid "Kdesvn KIO Notification"
msgstr "Kdesvn KIO Sciigo"

#: src/kdesvn.notifyrc:74
msgctxt "Name"
msgid "Kdesvn task notification"
msgstr "sciigo pri tasko de Kdesvn"

