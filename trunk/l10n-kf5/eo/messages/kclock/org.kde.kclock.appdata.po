#. (itstool) path: component/name
#: org.kde.kclock.appdata.xml:12
msgid "Clock"
msgstr "Horloĝo"

#. (itstool) path: component/summary
#: org.kde.kclock.appdata.xml:13
msgid "Set alarms and timers, use a stopwatch, and manage world clocks"
msgstr ""
"Agordu alarmojn kaj tempigilojn, uzu kronometron kaj administru mondajn "
"horloĝojn"

#. (itstool) path: component/developer_name
#: org.kde.kclock.appdata.xml:14
msgid "KDE Community"
msgstr "KDE-Komunumo"

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:16
msgid "A universal clock application for desktop and mobile."
msgstr "Universala horloĝa aplikaĵo por labortablo kaj poŝtelefono."

#. (itstool) path: description/p
#: org.kde.kclock.appdata.xml:17
msgid "It contains alarm, timer, stopwatch and timezone functionalities. Alarms and timers are able to wake the device from suspend on Plasma."
msgstr ""
"Ĝi enhavas alarmon, tempigilon, kronometron kaj horzonajn funkciojn. Alarmoj "
"kaj tempigiloj kapablas veki la aparaton de suspendo sur Plasma."

