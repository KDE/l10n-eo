#. (itstool) path: component/name
#: org.kde.apper.appdata.xml:6
msgid "Apper"
msgstr "Apper"

#. (itstool) path: component/summary
#: org.kde.apper.appdata.xml:7
msgid "KDE application and package management tool"
msgstr "KDE-aplikaĵo kaj pakaĵadministra ilo"

#. (itstool) path: description/p
#: org.kde.apper.appdata.xml:9
msgid ""
"Apper is a graphical management tool for packages and applications provided "
"by a Linux distribution."
msgstr ""
"Apper estas grafika administrilo por pakaĵoj kaj aplikaĵoj provizitaj de "
"Linukso-distribuo."

#. (itstool) path: description/p
#: org.kde.apper.appdata.xml:13
msgid ""
"It allows installing new software as well as keeping the system up to date "
"by installing updates."
msgstr ""
"Ĝi ebligas instali novan programaron same kiel teni la sistemon ĝisdatigita "
"per instalo de aktualigoj."

#. (itstool) path: description/p
#: org.kde.apper.appdata.xml:17
msgid "Features:"
msgstr "Trajtoj:"

#. (itstool) path: ul/li
#: org.kde.apper.appdata.xml:19
msgid "Distribution-agnostic management of software packages"
msgstr "Distribuagnostika administrado de programarpakaĵoj"

#. (itstool) path: ul/li
#: org.kde.apper.appdata.xml:20
msgid "Application management for users unexperienced with packages"
msgstr "Aplika administrado por uzantoj nespertaj kun pakaĵoj"

#. (itstool) path: ul/li
#: org.kde.apper.appdata.xml:21
msgid "Editor for software sources and PackageKit settings"
msgstr "Redaktilo por programaraj fontoj kaj agordoj de PackageKit"

#. (itstool) path: ul/li
#: org.kde.apper.appdata.xml:22
msgid "System software updates notifier and installer"
msgstr "Sistemprogramaro ĝisdatigas sciigilon kaj instalilon"

#. (itstool) path: ul/li
#: org.kde.apper.appdata.xml:23
msgid "Close integration with the KDE Plasma desktop"
msgstr "Proksima integriĝo kun la KDE Plasma-labortablo"

#. (itstool) path: screenshot/caption
#: org.kde.apper.appdata.xml:31
msgid "The main window showing a description of the selected package"
msgstr "La ĉefa fenestro montranta priskribon de la elektita pako"

#. (itstool) path: component/developer_name
#: org.kde.apper.appdata.xml:38
msgid "The KDE Community"
msgstr "La KDE-Komunumo"
