msgstr "Foliumi la fora aparato dosiersistemo uzante SFTP"

#: plugins/share/kdeconnect_share.json
msgctxt "Description"
msgid "Receive and send files, URLs or plain text easily"
msgstr "Ricevi kaj sendi dosierojn, URL-ojn aŭ simplan tekston facile"

