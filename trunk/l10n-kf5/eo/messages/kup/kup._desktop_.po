msgstr "Finis kontroli integrecon de rezerva arkivo"

#: daemon/kupdaemon.notifyrc:326
msgctxt "Name"
msgid "Repair Completed"
msgstr "Riparo Finita"

#: daemon/kupdaemon.notifyrc:356
