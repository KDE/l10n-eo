#: src/android_defaults.notifyrc:2
msgctxt "Name"
msgid "Fatal Error"
msgstr "Fatala Eraro"

#: src/android_defaults.notifyrc:58
msgctxt "Comment"
msgid "There was a serious error causing the program to exit"
msgstr "Estis grava eraro kaŭzanta programon eliri"

#: src/android_defaults.notifyrc:117
msgctxt "Name"
msgid "Notification"
msgstr "Sciigo"

#: src/android_defaults.notifyrc:173
msgctxt "Comment"
msgid "Something special happened in the program"
msgstr "Io speciala okazis en la programo"

#: src/android_defaults.notifyrc:231
msgctxt "Name"
msgid "Warning"
msgstr "Averto"

#: src/android_defaults.notifyrc:287
msgctxt "Comment"
msgid "There was an error in the program which may cause problems"
msgstr "Estis eraro en la programo kiu povas kaŭzi problemojn"

#: src/android_defaults.notifyrc:345
msgctxt "Name"
msgid "Catastrophe"
msgstr "Katastrofo"

#: src/android_defaults.notifyrc:400
msgctxt "Comment"
msgid "A very serious error occurred, at least causing the program to exit"
msgstr "Tre severa eraro okazis, almenaŭ kaŭzanta la programon eliri"
