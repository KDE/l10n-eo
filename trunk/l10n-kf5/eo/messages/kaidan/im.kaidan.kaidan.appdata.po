#. (itstool) path: component/name
#: im.kaidan.kaidan.appdata.xml:9
msgid "Kaidan"
msgstr "Kaidan"

#. (itstool) path: component/summary
#: im.kaidan.kaidan.appdata.xml:10
msgid "User-friendly and modern chat app for every device"
msgstr "Uz-afabla kaj moderna retbabililo por ĉiu aparato"

#. (itstool) path: component/developer_name
#: im.kaidan.kaidan.appdata.xml:13
msgid "Kaidan Developers &amp; Contributors"
msgstr "Kaidan-Evoluistoj &amp; Kontribuantoj"

#. (itstool) path: description/p
#: im.kaidan.kaidan.appdata.xml:15
msgid ""
"Kaidan is a user-friendly and modern chat app for every device. It uses the "
"open communication protocol XMPP (Jabber). Unlike other chat apps, you are "
"not dependent on one specific service provider."
msgstr ""
"Kaidan estas uzebla kaj moderna babilejo por ĉiu aparato. Ĝi uzas la "
"malferman komunikan protokolon XMPP (Jabber). Male al aliaj babilaj apoj, vi "
"ne dependas de unu specifa servoprovizanto."

#. (itstool) path: description/p
#: im.kaidan.kaidan.appdata.xml:16
msgid ""
"Kaidan does not have all basic features yet and has still some stability "
"issues. But we do our best to improve it!"
msgstr ""
"Kaidan ankoraŭ ne havas ĉiujn bazajn funkciojn kaj ankoraŭ havas kelkajn "
"stabilecajn problemojn. Sed ni faras nian eblon por plibonigi ĝin!"

#. (itstool) path: screenshot/caption
#: im.kaidan.kaidan.appdata.xml:32
msgid "Chat on a desktop and mobile device"
msgstr "Retbabilu sur labortablaj kaj porteblaj aparatoj"
