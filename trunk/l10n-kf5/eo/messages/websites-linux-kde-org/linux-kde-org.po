"run0 rm -rf /nix /etc/nix /etc/profile.d/nix.sh /etc/tmpfiles.d/nix-daemon."
"conf /nix /root/.nix-channels /root/.nix-defexpr /root/.nix-profile /root/."
"cache/nix ~/.nix-channels ~/.nix-defexpr ~/.nix-profile ~/.cache/nix\n"
"\n"
"for i in $(seq 1 32); do run0 userdel nixbld$i; done\n"
"\n"
"run0 groupdel nixbld\n"
