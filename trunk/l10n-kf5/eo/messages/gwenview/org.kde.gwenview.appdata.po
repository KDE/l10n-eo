#. (itstool) path: screenshot/caption
#: org.kde.gwenview.appdata.xml:6 org.kde.gwenview.appdata.xml:26
msgid "Gwenview"
msgstr "Gwenview"

#. (itstool) path: component/summary
#: org.kde.gwenview.appdata.xml:7
msgid "Image Viewer"
msgstr "Bildrigardilo"

#. (itstool) path: description/p
#: org.kde.gwenview.appdata.xml:9
msgid ""
"Gwenview is a fast and easy to use image viewer by KDE, ideal for browsing "
"and displaying a collection of images."
msgstr ""
"Gwenview estas rapida kaj simple uzebla bildrigardilo de KDE, ideala por "
"foliumado kaj montrado de bildaro."

#. (itstool) path: description/p
#: org.kde.gwenview.appdata.xml:12
msgid "Features:"
msgstr "Trajtoj:"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:14
msgid ""
"Simple image editing: rotate, crop, resize, mirror, flip, reduce red eye, "
"and adjust brightness, contrast, or gamma"
msgstr ""
"Simpla bildredaktado: rotacii, tondi, aligrandigi, speguli, renversi, redukti "
"ruĝ-okulon, kaj alĝustigi helecon, kontraston aŭ gamma"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:15
msgid ""
"Annotate and mark up images with arrows, shapes, text boxes, image stamps, "
"and more"
msgstr ""
"Prinoti kaj primarki bildojn per sagoj, formoj, tekstskatoloj, bildostampoj "
"kaj pli"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:16
msgid "Basic file management actions such as copy, move, delete, and others"
msgstr "Bazaj agoj de dosiermastrumado kiel kopii, movi, forigi kaj aliaj"

#. (itstool) path: ul/li
#: org.kde.gwenview.appdata.xml:17
msgid ""
"Functions both as a standalone application and an embedded viewer in the "
"Konqueror web browser"
msgstr ""
"Funkcias kaj kiel memstara aplikaĵo kaj enigita spektilo en la TTT-legilo "
"Konqueror"

#. (itstool) path: screenshot/caption
#: org.kde.gwenview.appdata.xml:30
msgid "Use Gwenview to manage your image collection"
msgstr "Uzu Gwenview por administri vian bildkolekton"
