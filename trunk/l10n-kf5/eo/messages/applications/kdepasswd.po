#: kdepasswd.cpp:44
msgid "KDE passwd"
msgstr "KDE pasvorto"

#: kdepasswd.cpp:45
msgid "Changes a UNIX password."
msgstr "Ŝanĝas uniksan pasvorton."

#: kdepasswd.cpp:46
msgid "Copyright (c) 2000 Geert Jansen"
msgstr "Kopirajto (c) 2000 Geert Jansen"

#: kdepasswd.cpp:47
msgid "Geert Jansen"
msgstr "Geert Jansen"

#: kdepasswd.cpp:47
msgid "Maintainer"
msgstr "Fleganto"

#: kdepasswd.cpp:59
msgid "Change password of this user"
msgstr "Ŝanĝi la pasvorton de tiu uzanto"

#: kdepasswd.cpp:76
msgid "You need to be root to change the password of other users."
msgstr "Vi devas esti sistemestro por ŝanĝi la pasvorton de aliaj uzantoj."

#: passwddlg.cpp:34 passwddlg.cpp:101
msgctxt "@title:window"
msgid "Change Password"
msgstr "Ŝanĝi la pasvorton"

#: passwddlg.cpp:35
msgid "Please enter your current password:"
msgstr "Bonvolu entajpi vian nunan pasvorton:"

#: passwddlg.cpp:55 passwddlg.cpp:182
msgid "Conversation with 'passwd' failed."
msgstr "Interkomunikado kun 'passwd' malsukcesis."

#: passwddlg.cpp:65
msgid "Could not find the program 'passwd'."
msgstr "Ne troviĝis la programo 'passwd'."

#: passwddlg.cpp:70
msgid "Incorrect password. Please try again."
msgstr "Malĝusta pasvorto. Bonvolu reprovi."

#: passwddlg.cpp:74
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "Interna eraro: nevalida valoro de PasswdProcess::checkCurrent."

#: passwddlg.cpp:103
msgid "Please enter your new password:"
msgstr "Bonvolu tajpi vian novan pasvorton:"

#: passwddlg.cpp:105
#, kde-format
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "Bonvolu tajpi la novan pasvorton por la uzanto <b>%1</b>:"

#: passwddlg.cpp:129
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Via pasvorto estas pli longa ol 8 signoj. Je kelkaj sistemoj, tio povas fari "
"problemojn. Vi povas ŝanĝi la pasvorton al 8 signoj, aŭ lasi."

#: passwddlg.cpp:132
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"La pasvorto estas pli longa ol 8 signoj. Je kelkaj sistemoj, tio povas fari "
"problemojn. Vi povas malpligrandigi la pasvorton al 8 signoj, aŭ lasi."

#: passwddlg.cpp:136
msgid "Password Too Long"
msgstr "Pasvorto tro longa"

#: passwddlg.cpp:137
msgid "Truncate"
msgstr "Fortranĉi"

#: passwddlg.cpp:138
msgid "Use as Is"
msgstr "Uzi tiel"

#: passwddlg.cpp:161
msgid "Your password has been changed."
msgstr "Via pasvorto estas ŝanĝita."

#: passwddlg.cpp:171
msgid "Your password has not been changed."
msgstr "Via pasvorto ne estas ŝanĝita."
