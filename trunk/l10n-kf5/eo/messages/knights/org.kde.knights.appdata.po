#. (itstool) path: component/name
#: org.kde.knights.appdata.xml:6
msgid "KNights"
msgstr "KNights"

#. (itstool) path: component/summary
#: org.kde.knights.appdata.xml:7
msgid "Chess game"
msgstr "Ŝakludo"

#. (itstool) path: description/p
#: org.kde.knights.appdata.xml:9
msgid "KNights is a chess game. As a player, your goal is to defeat your opponent by checkmating their king."
msgstr ""
"KNights estas ŝakludo. Kiel ludanto, via celo estas venki vian kontraŭulon "
"per matado de ilia reĝo."

#. (itstool) path: description/p
#: org.kde.knights.appdata.xml:12
msgid "Features:"
msgstr "Trajtoj:"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:14
msgid "Local play between two players on the same computer"
msgstr "Loka ludo inter du ludantoj sur la sama komputilo"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:15
msgid "Play against any computer program that supports the XBoard protocol"
msgstr ""
"Ludu kontraŭ iu ajn komputila programo, kiu subtenas la protokolon XBoard"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:16
msgid "Play on the Free Internet Chess Server (FICS)"
msgstr "Ludu sur la libera interreta ŝakservilo (FICS)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:17
msgid "Watching two computer engines play against each other"
msgstr "Rigardante du komputilajn motorojn ludi unu kontraŭ la alia"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:18
msgid "Support for legal move checking"
msgstr "Subteno por jura movo kontrolado"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:19
msgid "Markers for possible moves, opponent’s last move and sources of check"
msgstr ""
"Signiloj por eblaj movoj, la lasta movo de kontraŭulo kaj fontoj de kontrolo"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:20
msgid "Board borders and site notations"
msgstr "Tabulbordoj kaj ejonotacioj"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:21
msgid "Complete time control, with Plasma-styled clocks"
msgstr "Kompleta tempokontrolo, kun Plasma-stilaj horloĝoj"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:22
msgid "Several themes, with the possibility of downloading new ones from within the program"
msgstr "Pluraj etosoj, kun la ebleco elŝuti novajn el la programo"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:23
msgid "Animated moves (configurable)"
msgstr "Viglaj movoj (agordeblaj)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:24
msgid "Views for playing on a chess server, including a seek graph, text console, and chat widget"
msgstr ""
"Vidoj por ludi sur ŝakservilo, inkluzive de serĉa grafeo, tekstkonzolo kaj "
"babilejo"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:25
msgid "Option to undo and redo moves"
msgstr "Opcio por malfari kaj refari movojn"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:26
msgid "Graphic interface for making and receiving offers from remote players"
msgstr "Grafika interfaco por fari kaj ricevi ofertojn de foraj ludantoj"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:27
msgid "Support for the UCI protocol (used by Stockfish, Chessbase, and many others)"
msgstr ""
"Subteno por la UCI-protokolo (uzita de Stockfish, Chessbase, kaj multaj "
"aliaj)"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:28
msgid "Support for saving and loading Portable game notation (PGN) files"
msgstr ""
"Subteno por konservi kaj ŝargi Porteblajn ludnotaciojn (PGN) dosierojn"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:29
msgid "Use of Jovie, the KDE text-to-speak program, to speak opponent’s moves"
msgstr ""
"Uzo de Jovie, la teksto-al-paroli programo de KDE, por paroli movojn de "
"kontraŭulo"

#. (itstool) path: ul/li
#: org.kde.knights.appdata.xml:30
msgid "Ability to control the program via a D-Bus interface"
msgstr "Kapablo kontroli la programon per D-Bus-interfaco"

