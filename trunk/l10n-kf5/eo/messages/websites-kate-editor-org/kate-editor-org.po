msgid "Version without footer text"
msgstr "Versio sen piedlinia teksto"

#: content/mascot.md:22
msgid ""
"![Kate the Cyber Woodpecker - Without Text](/images/mascot/"
"electrichearts_20210103_kate_notext.png)"
msgstr ""
"![Kejt la Kiberpego - Sen Teksto](/images/mascot/"
