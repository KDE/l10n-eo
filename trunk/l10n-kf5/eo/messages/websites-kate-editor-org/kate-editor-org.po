#: content/join-us.md:64
msgid ""
"<a title=\"KSyntaxHighlighting Bug Tracker\" href=\"https://bugs.kde.org/"
"buglist.cgi?product=frameworks-syntax-"
"highlighting&bug_status=UNCONFIRMED&bug_status=CONFIRMED&bug_status=ASSIGNED&bug_status=REOPENED&bug_severity=critical&bug_severity=grave&bug_severity=major&bug_severity=crash&bug_severity=normal&bug_severity=minor"
