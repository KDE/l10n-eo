msgstr ""
"<a title=\"Cimtabeloj por Kate kaj KWrite\" href=\"https://bugs.kde.org/"
"reports.cgi?product_id=39&#038;datasets=UNCONFIRMED&#038;datasets=CONFIRMED"
"&#038;datasets=ASSIGNED&#038;datasets=REOPENED\" target=\"_blank\">Cimtabeloj "
